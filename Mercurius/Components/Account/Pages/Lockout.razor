@page "/account/lockout"

<PageTitle>Account locked · Mercurius</PageTitle>

<h2 class="auth-title">Account locked</h2>
<p class="auth-subtitle">
    Too many incorrect passwords were entered, so this account has been locked for 15 minutes.
    Try again later, or ask an administrator to help.
</p>
<a class="auth-submit auth-link-button" href="account/login">Back to sign in</a>
