<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- The Blazor Web App host: JSON API (/api), sign-in pages, and the server half of the
       Blazor UI (Mercurius.Client), which it prerenders and serves. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS8601;CS8604;CS1998</NoWarn>
    <UserSecretsId>aspnet-Mercurius-47c7cb88-7fb4-447b-aecb-f4866ad8563a</UserSecretsId>
    <AspNetCoreHostingModel>InProcess</AspNetCoreHostingModel>
  </PropertyGroup>

  <!-- Downloadable POS app builds (Windows zip, Android APK), served by DownloadsController.
       Produced by Mercurius.Mobile/publish-downloads.ps1; git-ignored (too large for GitHub), so
       they're only present on the machine that built them — and copied into the publish output
       from there. -->
  <ItemGroup>
    <None Include="Downloads\**" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Data Protection keys (Program.cs) belong to the machine that made them: never publish a
       local key ring over the server's. -->
  <ItemGroup>
    <Content Remove="App_Data\**" />
    <None Remove="App_Data\**" />
  </ItemGroup>

  <!-- Product photos are uploaded at runtime on each server. Never publish a machine's local
       copies (e.g. test uploads) over the live site's. -->
  <ItemGroup>
    <Content Update="wwwroot\ProductImages\**" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CsvHelper" Version="33.1.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Net.Codecrete.QrCodeGenerator" Version="3.2.1" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.23.0" />
    <!-- Pins Microsoft.Data.SqlClient's transitive copy (9.0.11) past known vulnerabilities. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mercurius.Common\Mercurius.Common.csproj" />
    <ProjectReference Include="..\Mercurius.Repo\Mercurius.Repo.csproj" />
    <ProjectReference Include="..\Mercurius.Repo.Migrations.SqlServer\Mercurius.Repo.Migrations.SqlServer.csproj" />
    <ProjectReference Include="..\Mercurius.Shared\Mercurius.Shared.csproj" />
    <ProjectReference Include="..\Mercurius.Client\Mercurius.Client.csproj" />
  </ItemGroup>

</Project>
