@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Import Products";
}

<!-- PAGE TITLE -->
<div id="kt_app_toolbar" class="app-toolbar py-3 py-lg-6">
    <div id="kt_app_toolbar_container" class="app-container container-xxl d-flex flex-stack">
        <div class="page-title d-flex flex-column justify-content-center flex-wrap me-3">
            <h1 class="page-heading d-flex text-dark fw-bold fs-3 flex-column justify-content-center my-0">Import Products</h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0 pt-1">
                <li class="breadcrumb-item text-muted">
                    <a href="/" class="text-muted text-hover-primary">Home</a>
                </li>
                <li class="breadcrumb-item">
                    <span class="bullet bg-gray-400 w-5px h-2px"></span>
                </li>
                <li class="breadcrumb-item text-muted">
                    <a href="/Products" class="text-muted text-hover-primary">Products</a>
                </li>
                <li class="breadcrumb-item">
                    <span class="bullet bg-gray-400 w-5px h-2px"></span>
                </li>
                <li class="breadcrumb-item text-muted">Import</li>
            </ul>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-body p-10">
        <div class="alert alert-info">
            <h4 class="alert-heading">CSV Import Instructions</h4>
            <p>Upload a CSV file with product data. The CSV should have the following columns:</p>
            <ul>
                <li><strong>Handle</strong> or <strong>SKU</strong>: Product identifier (used as SKU)</li>
                <li><strong>Name</strong>: Product name</li>
                <li><strong>Category</strong>: Product category (will be created if it doesn't exist)</li>
                <li><strong>Description</strong>: Product description</li>
                <li><strong>Cost</strong>: Cost price</li>
                <li><strong>Price [Parmasya ng Bayan Sapang Maisac Mexico]</strong>: Sale price</li>
                <li><strong>In stock [Parmasya ng Bayan Sapang Maisac Mexico]</strong>: Current stock quantity</li>
                <li><strong>Low stock [Parmasya ng Bayan Sapang Maisac Mexico]</strong>: Low stock warning level</li>
                <li><strong>Available for sale [Parmasya ng Bayan Sapang Maisac Mexico]</strong>: "Y" for active, "N" for inactive</li>
            </ul>
            <p class="mb-0">You can download a sample CSV file <a href="/sample-products.csv" target="_blank">here</a>.</p>
        </div>

        <form id="importForm" enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div class="row g-5">
                <div class="col-md-6">
                    <div class="mb-10">
                        <label class="required form-label">CSV File</label>
                        <input type="file" name="csvFile" class="form-control form-control-solid" accept=".csv" required />
                        <div class="form-text">Select a CSV file to upload. Maximum file size: 10MB.</div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="mb-10">
                        <label class="form-label">Import Options</label>
                        <div class="form-check form-check-custom form-check-solid">
                            <input class="form-check-input" type="checkbox" name="updateExisting" value="true" id="updateExisting" />
                            <label class="form-check-label" for="updateExisting">
                                Update existing products
                            </label>
                            <div class="form-text">If checked, existing products with matching SKU/Handle will be updated. If unchecked, they will be skipped.</div>
                        </div>
                    </div>
                </div>
            </div>

            <div id="importFormError" class="alert alert-danger" style="display:none;"></div>

            <div class="border-top d-flex flex-stack flex-wrap mt-lg-10 pt-13">
                <div class="my-1 me-5">
                    <a href="/Products" class="btn btn-light">Cancel</a>
                </div>

                <div class="d-flex align-items-center gap-2 gap-lg-3">
                    <button type="submit" id="importSubmitBtn" class="btn btn-primary">
                        <span class="indicator-label">Import Products</span>
                        <span class="indicator-progress">
                            Please wait...
                            <span class="spinner-border spinner-border-sm align-middle ms-2"></span>
                        </span>
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Import progress modal -->
<div class="modal fade" id="importProgressModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Importing Products</h5>
                <button type="button" id="importModalCloseBtn" class="btn-close" data-bs-dismiss="modal" style="display:none;"></button>
            </div>
            <div class="modal-body">
                <div class="mb-4">
                    <div class="d-flex justify-content-between mb-1">
                        <span id="importStatusText" class="fw-bold">Queued...</span>
                        <span id="importCountText" class="text-muted"></span>
                    </div>
                    <div class="progress" style="height: 20px;">
                        <div id="importProgressBar" class="progress-bar progress-bar-striped progress-bar-animated" role="progressbar" style="width: 0%">0%</div>
                    </div>
                </div>

                <div id="importSummary" class="alert alert-success" style="display:none;"></div>

                <label class="form-label">Activity Log</label>
                <div id="importLog" class="bg-light rounded p-3" style="height: 260px; overflow-y: auto; font-family: monospace; font-size: 0.85rem; white-space: pre-wrap;"></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            var IMPORT_JOB_STORAGE_KEY = 'mercurius_import_job_id';
            var pollTimer = null;
            var modalEl = document.getElementById('importProgressModal');
            var modal = new bootstrap.Modal(modalEl);

            function resetModalForNewRun() {
                $('#importStatusText').text('Queued...').removeClass('text-danger');
                $('#importCountText').text('');
                $('#importProgressBar').css('width', '0%').text('0%');
                $('#importSummary').hide().removeClass('alert-danger').addClass('alert-success').html('');
                $('#importLog').empty();
                $('#importModalCloseBtn').hide();
            }

            function renderState(state) {
                $('#importStatusText').text(state.status);
                var pct = state.total > 0 ? Math.round((state.processed / state.total) * 100) : 0;
                $('#importProgressBar').css('width', pct + '%').text(pct + '%');
                $('#importCountText').text(state.total > 0 ? (state.processed + ' / ' + state.total) : '');

                var logEl = $('#importLog');
                logEl.empty();
                (state.log || []).forEach(function (line) {
                    logEl.append($('<div></div>').text(line));
                });
                logEl.scrollTop(logEl[0].scrollHeight);

                if (state.status === 'Completed') {
                    $('#importSummary').show().removeClass('alert-danger').addClass('alert-success').text(
                        'Created: ' + state.created + '   Updated: ' + state.updated +
                        '   Skipped: ' + state.skipped + '   Errors: ' + state.errors
                    );
                } else if (state.status === 'Failed') {
                    $('#importStatusText').addClass('text-danger');
                    $('#importSummary').show().removeClass('alert-success').addClass('alert-danger')
                        .text('Import failed: ' + (state.errorMessage || 'Unknown error.'));
                }
            }

            function stopPolling(clearStorage) {
                if (pollTimer) {
                    clearInterval(pollTimer);
                    pollTimer = null;
                }
                if (clearStorage) {
                    localStorage.removeItem(IMPORT_JOB_STORAGE_KEY);
                }
                $('#importModalCloseBtn').show();
            }

            function pollStatus(jobId) {
                $.get('@Url.Action("ImportStatus", "Products")', { jobId: jobId })
                    .done(function (state) {
                        renderState(state);
                        if (state.status === 'Completed' || state.status === 'Failed') {
                            stopPolling(true);
                        }
                    })
                    .fail(function (xhr) {
                        if (xhr.status === 404) {
                            // Server restarted since this job ran (in-memory tracker) — stop quietly.
                            stopPolling(true);
                        }
                    });
            }

            function startTracking(jobId, isResume) {
                localStorage.setItem(IMPORT_JOB_STORAGE_KEY, jobId);
                if (!isResume) {
                    resetModalForNewRun();
                }
                modal.show();
                pollStatus(jobId);
                pollTimer = setInterval(function () { pollStatus(jobId); }, 1000);
            }

            $('#importForm').on('submit', function (e) {
                e.preventDefault();
                $('#importFormError').hide();
                var formData = new FormData(this);

                var submitBtn = $('#importSubmitBtn');
                submitBtn.prop('disabled', true);
                submitBtn.find('.indicator-label').hide();
                submitBtn.find('.indicator-progress').show();

                $.ajax({
                    url: '@Url.Action("Import", "Products")',
                    method: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false
                }).done(function (result) {
                    startTracking(result.jobId, false);
                }).fail(function (xhr) {
                    var msg = 'Failed to start import.';
                    try { msg = JSON.parse(xhr.responseText).error || msg; } catch (e) {}
                    $('#importFormError').text(msg).show();
                }).always(function () {
                    submitBtn.prop('disabled', false);
                    submitBtn.find('.indicator-progress').hide();
                    submitBtn.find('.indicator-label').show();
                });
            });

            // If an import was already running when the user navigated to (or reloaded) this
            // page, resume showing its progress rather than losing track of it.
            var existingJobId = localStorage.getItem(IMPORT_JOB_STORAGE_KEY);
            if (existingJobId) {
                startTracking(existingJobId, true);
            }
        });
    </script>
}
