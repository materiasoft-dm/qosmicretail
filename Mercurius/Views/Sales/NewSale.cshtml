@{
    ViewData["Title"] = "New Sale";
    var customers = ViewBag.Customers as List<Mercurius.Repo.Models.Customer>;
}

<!-- PAGE TITLE -->
<div id="kt_app_toolbar" class="app-toolbar py-3 py-lg-6">
    <div id="kt_app_toolbar_container" class="app-container container-xxl d-flex flex-stack">
        <div class="page-title d-flex flex-column justify-content-center flex-wrap me-3">
            <h1 class="page-heading d-flex text-dark fw-bold fs-3 flex-column justify-content-center my-0">New Sale</h1>
        </div>
    </div>
</div>

<div class="row g-5">
    <!-- Products -->
    <div class="col-md-8">
        <div class="card mb-5">
            <div class="card-body p-5">
                <div class="d-flex flex-wrap gap-3 align-items-center mb-4">
                    <div class="position-relative flex-grow-1" style="min-width:220px;">
                        <span class="svg-icon svg-icon-2 position-absolute ms-3 top-50 translate-middle-y">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text" id="productSearch" class="form-control form-control-sm ps-10" placeholder="Search by name or SKU..." />
                    </div>
                    <div class="btn-group btn-group-sm" role="group">
                        <button type="button" id="gridViewBtn" class="btn btn-icon btn-light" title="Grid view"><i class="bi bi-grid-3x3-gap"></i></button>
                        <button type="button" id="listViewBtn" class="btn btn-icon btn-light" title="List view"><i class="bi bi-list-ul"></i></button>
                    </div>
                </div>

                <div id="categoryTabs" class="d-flex flex-nowrap gap-2 mb-4 overflow-auto pb-2"></div>

                <div id="productsHint" class="text-muted small mb-2" style="display:none;"></div>
                <div id="productsGrid" class="row row-cols-2 row-cols-md-3 row-cols-lg-4 g-3"></div>
                <div id="productsList" class="d-none"></div>
                <div id="productsEmpty" class="text-center text-muted py-10" style="display:none;">No products found.</div>
                <div id="productsLoading" class="text-center py-10 d-none">
                    <span class="spinner-border spinner-border-sm text-primary" role="status"></span>
                </div>
            </div>
        </div>
    </div>

    <!-- Ticket -->
    <div class="col-md-4">
        <div class="card" style="position: sticky; top: 20px;">
            <div class="card-body p-5">
                <div class="row g-3 mb-4">
                    <div class="col-12">
                        <label class="form-label">Customer</label>
                        <select id="customerSelect" class="form-select form-select-sm">
                            <option value="">-- Optional --</option>
                            @if (customers != null)
                            {
                                foreach (var c in customers)
                                {
                                    <option value="@c.Id">@c.FirstName @c.LastName</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-12">
                        <label class="form-label">Notes</label>
                        <input id="notesInput" class="form-control form-control-sm" placeholder="Optional notes..." />
                    </div>
                </div>

                <div class="separator separator-dashed border-secondary mb-4"></div>

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="mb-0">Ticket</h5>
                    <span id="cartCountBadge" class="badge badge-light">0 items</span>
                </div>

                <div id="cartEmpty" class="text-center text-muted py-10">
                    <div>Ticket is empty</div>
                    <div class="small">Tap a product to add it</div>
                </div>
                <div id="cartLines" style="max-height: 45vh; overflow-y: auto;"></div>

                <div class="separator separator-dashed border-secondary my-4"></div>

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <span class="fw-bold">Total</span>
                    <span id="cartTotal" class="fs-4 fw-bold text-primary">₱0.00</span>
                </div>

                <div class="d-flex gap-2">
                    <button type="button" id="clearCartBtn" class="btn btn-light flex-grow-1">Clear</button>
                    <button type="button" id="chargeBtn" class="btn btn-primary flex-grow-1" disabled>Charge</button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Payment modal -->
<div class="modal fade" id="paymentModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Payment</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="paymentError" class="alert alert-danger" style="display:none;"></div>

                <div class="text-center mb-5">
                    <div id="totalDueLabel" class="fs-1 fw-bold text-dark">₱0.00</div>
                    <div class="text-muted small">Total amount due</div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Cash received</label>
                    <input type="number" step="0.01" min="0" class="form-control" id="cashReceivedInput" />
                    <div id="changeLabel" class="small fw-bold mt-1"></div>
                </div>

                <div id="quickAmountsRow" class="row g-2 mb-4"></div>

                <button type="button" id="chargeCashBtn" class="btn btn-primary w-100 mb-3" disabled>Charge Cash</button>
                <hr />
                <button type="button" id="chargeCardBtn" class="btn btn-secondary w-100">Charge Card</button>
            </div>
        </div>
    </div>
</div>

<!-- Edit cart-line quantity modal -->
<div class="modal fade" id="editQtyModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Edit Item</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-1 fw-bold fs-5" id="editQtyProductName"></div>
                <div class="text-muted small mb-4" id="editQtyProductMeta"></div>

                <label class="form-label">Quantity</label>
                <div class="d-flex align-items-center gap-2 mb-4">
                    <button type="button" id="editQtyDecrementBtn" class="btn btn-icon btn-light"><i class="bi bi-dash"></i></button>
                    <input type="number" min="1" step="1" id="editQtyInput" class="form-control text-center" style="max-width:100px;" />
                    <button type="button" id="editQtyIncrementBtn" class="btn btn-icon btn-light"><i class="bi bi-plus"></i></button>
                </div>

                <div class="d-flex justify-content-between align-items-center p-3 bg-light rounded">
                    <span class="text-muted">Item total</span>
                    <span id="editQtyPreviewTotal" class="fs-4 fw-bold text-primary">₱0.00</span>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                <button type="button" id="editQtyUpdateBtn" class="btn btn-primary">Update</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // ----------------------------------------------------------------
            // State
            // ----------------------------------------------------------------
            var cart = []; // { productId, name, price, qty, stock, lowStockCount }
            var selectedCategoryId = '';
            var searchTimeout = null;
            var isGridView = (localStorage.getItem('sell_view_mode') || 'grid') !== 'list';

            function esc(s) {
                if (s === null || typeof s === 'undefined') return '';
                var div = document.createElement('div');
                div.textContent = s;
                return div.innerHTML;
            }
            function fmtMoney(n) { return '₱' + (Number(n) || 0).toFixed(2); }

            // ----------------------------------------------------------------
            // Categories
            // ----------------------------------------------------------------
            function loadCategories() {
                $.get('/Products/GetCategories').done(function (categories) {
                    var wrap = $('#categoryTabs');
                    wrap.empty();
                    wrap.append('<button type="button" class="btn btn-sm btn-dark category-tab" data-id="">All</button>');
                    categories.forEach(function (c) {
                        wrap.append('<button type="button" class="btn btn-sm btn-light category-tab" data-id="' + c.id + '">' + esc(c.name) + '</button>');
                    });
                });
            }

            $(document).on('click', '.category-tab', function () {
                selectedCategoryId = $(this).data('id') || '';
                $('.category-tab').removeClass('btn-dark').addClass('btn-light');
                $(this).removeClass('btn-light').addClass('btn-dark');
                loadProducts();
            });

            // ----------------------------------------------------------------
            // Products — server-side search reused from the existing sale-modal endpoint,
            // rendered as tiles/list instead of a table. No pager: request a generous page and
            // hint if there's more, closer to how the mobile grid just scrolls.
            // ----------------------------------------------------------------
            var PAGE_SIZE = 100;

            function loadProducts() {
                $('#productsLoading').removeClass('d-none');
                $('#productsEmpty').hide();
                var search = $('#productSearch').val();
                $.get('/Products/GetForSaleModal', { page: 1, pageSize: PAGE_SIZE, search: search, categoryId: selectedCategoryId || null })
                    .done(function (response) {
                        renderProducts(response.items || [], response.total || 0);
                    })
                    .always(function () { $('#productsLoading').addClass('d-none'); });
            }

            function stockBadgeClass(stock, lowStockCount) {
                return (Number(stock) <= Number(lowStockCount)) ? 'text-danger' : 'text-success';
            }

            function cartQtyFor(productId) {
                var line = cart.find(function (l) { return l.productId === productId; });
                return line ? line.qty : 0;
            }

            function renderProducts(items, total) {
                $('#productsGrid').empty();
                $('#productsList').empty();
                $('#productsEmpty').toggle(items.length === 0);
                $('#productsHint').toggle(total > items.length);
                if (total > items.length) {
                    $('#productsHint').text('Showing the first ' + items.length + ' of ' + total + ' — refine your search to narrow this down.');
                }

                items.forEach(function (p) {
                    var stockCls = stockBadgeClass(p.stock, p.lowStockCount);
                    var inCart = cartQtyFor(p.id);
                    var badge = inCart > 0 ? '<span class="badge badge-primary position-absolute top-0 end-0 m-2">' + inCart + '</span>' : '';

                    // Grid tile
                    var tile = $(
                        '<div class="col product-tile-col">' +
                        '<div class="card h-100 product-tile position-relative" style="cursor:pointer;" data-product-id="' + p.id + '">' +
                        badge +
                        '<div class="card-body p-3">' +
                        '<div class="fw-bold text-truncate" title="' + esc(p.name) + '">' + esc(p.name) + '</div>' +
                        '<div class="text-muted small text-truncate">' + esc(p.category) + '</div>' +
                        '<div class="fw-bold text-primary mt-1">' + fmtMoney(p.salePrice) + '</div>' +
                        '<div class="small ' + stockCls + '">' + Number(p.stock).toFixed(0) + ' in stock</div>' +
                        '</div></div></div>'
                    );
                    $('#productsGrid').append(tile);

                    // List row
                    var row = $(
                        '<div class="d-flex align-items-center justify-content-between border-bottom py-2 product-tile" style="cursor:pointer;" data-product-id="' + p.id + '">' +
                        '<div class="flex-grow-1">' +
                        '<div class="fw-bold">' + esc(p.name) + (inCart > 0 ? ' <span class="badge badge-light-primary ms-1">' + inCart + ' in cart</span>' : '') + '</div>' +
                        '<div class="text-muted small">' + esc(p.category) + '</div>' +
                        '</div>' +
                        '<div class="text-end me-4"><div class="small ' + stockCls + '">' + Number(p.stock).toFixed(0) + ' in stock</div></div>' +
                        '<div class="fw-bold text-primary" style="min-width:80px;text-align:right;">' + fmtMoney(p.salePrice) + '</div>' +
                        '</div>'
                    );
                    $('#productsList').append(row);
                });

                $('.product-tile').data('lookup', items);
                window.__productLookup = window.__productLookup || {};
                items.forEach(function (p) { window.__productLookup[p.id] = p; });
            }

            $(document).on('click', '.product-tile', function () {
                var productId = $(this).data('product-id');
                var product = window.__productLookup ? window.__productLookup[productId] : null;
                if (!product) return;
                addToCart(product);
            });

            $('#productSearch').on('input', function () {
                clearTimeout(searchTimeout);
                searchTimeout = setTimeout(loadProducts, 300);
            });

            // ----------------------------------------------------------------
            // View mode toggle — persisted the same way mobile persists its grid/list choice.
            // ----------------------------------------------------------------
            function applyViewMode() {
                $('#productsGrid').toggleClass('d-none', !isGridView);
                $('#productsList').toggleClass('d-none', isGridView);
                $('#gridViewBtn').toggleClass('btn-dark', isGridView).toggleClass('btn-light', !isGridView);
                $('#listViewBtn').toggleClass('btn-dark', !isGridView).toggleClass('btn-light', isGridView);
            }
            $('#gridViewBtn').on('click', function () { isGridView = true; localStorage.setItem('sell_view_mode', 'grid'); applyViewMode(); });
            $('#listViewBtn').on('click', function () { isGridView = false; localStorage.setItem('sell_view_mode', 'list'); applyViewMode(); });
            applyViewMode();

            // ----------------------------------------------------------------
            // Cart — mirrors Mercurius.Mobile/SalesPage.xaml.cs's OnProductTileTapped /
            // OnIncrementClicked / OnDecrementClicked / OnRemoveLineTapped / OnClearClicked.
            // ----------------------------------------------------------------
            function addToCart(product) {
                var existing = cart.find(function (l) { return l.productId === product.id; });
                if (existing) {
                    existing.qty++;
                } else {
                    cart.push({ productId: product.id, name: product.name, price: Number(product.salePrice) || 0, qty: 1, stock: product.stock, lowStockCount: product.lowStockCount });
                }
                renderCart();
                renderCartBadgesOnTiles();
            }

            function setLineQty(productId, qty) {
                var line = cart.find(function (l) { return l.productId === productId; });
                if (!line) return;
                if (qty <= 0) {
                    cart = cart.filter(function (l) { return l.productId !== productId; });
                } else {
                    line.qty = qty;
                }
                renderCart();
                renderCartBadgesOnTiles();
            }

            function removeLine(productId) {
                cart = cart.filter(function (l) { return l.productId !== productId; });
                renderCart();
                renderCartBadgesOnTiles();
            }

            function clearCart() {
                cart = [];
                renderCart();
                renderCartBadgesOnTiles();
            }

            function cartTotal() {
                return cart.reduce(function (sum, l) { return sum + l.price * l.qty; }, 0);
            }

            function renderCartBadgesOnTiles() {
                // Cheap refresh of the in-cart badges without a full reload.
                $('.product-tile').each(function () {
                    var id = $(this).data('product-id');
                    var qty = cartQtyFor(id);
                    $(this).find('.badge-primary, .badge-light-primary').remove();
                    if (qty > 0) {
                        if ($(this).hasClass('card')) {
                            $(this).prepend('<span class="badge badge-primary position-absolute top-0 end-0 m-2">' + qty + '</span>');
                        } else {
                            $(this).find('.fw-bold').first().append(' <span class="badge badge-light-primary ms-1">' + qty + ' in cart</span>');
                        }
                    }
                });
            }

            function renderCart() {
                var totalItems = cart.reduce(function (sum, l) { return sum + l.qty; }, 0);
                $('#cartCountBadge').text(totalItems === 1 ? '1 item' : totalItems + ' items');
                $('#cartEmpty').toggle(cart.length === 0);

                var linesEl = $('#cartLines');
                linesEl.empty();
                cart.forEach(function (line) {
                    var lineTotal = line.price * line.qty;
                    linesEl.append(
                        '<div class="d-flex justify-content-between align-items-center py-2 border-bottom cart-line" style="cursor:pointer;" data-product-id="' + line.productId + '">' +
                        '<div class="flex-grow-1 me-2">' +
                        '<div class="fw-bold text-truncate">' + esc(line.name) + '</div>' +
                        '<div class="text-muted small mt-1">' + line.qty + ' &times; ' + fmtMoney(line.price) + '</div>' +
                        '</div>' +
                        '<div class="text-end">' +
                        '<div class="fw-bold">' + fmtMoney(lineTotal) + '</div>' +
                        '<span class="text-danger cart-remove" data-product-id="' + line.productId + '" style="cursor:pointer;" title="Remove">&#10005;</span>' +
                        '</div></div>'
                    );
                });

                $('#cartTotal').text(fmtMoney(cartTotal()));
                $('#chargeBtn').prop('disabled', cart.length === 0);
                $('#chargeBtn').text(cart.length === 0 ? 'Charge' : 'Charge ' + fmtMoney(cartTotal()));
            }

            $(document).on('click', '.cart-remove', function (e) {
                e.stopPropagation();
                removeLine($(this).data('product-id'));
            });
            $(document).on('click', '.cart-line', function () { openEditQtyModal($(this).data('product-id')); });
            $('#clearCartBtn').on('click', clearCart);

            // ----------------------------------------------------------------
            // Edit-quantity popup — clicking a ticket line opens this instead of inline +/-
            // steppers; changes only apply to the cart when Update is clicked.
            // ----------------------------------------------------------------
            var editQtyModal = new bootstrap.Modal(document.getElementById('editQtyModal'));
            var editQtyProductId = null;

            function openEditQtyModal(productId) {
                var line = cart.find(function (l) { return l.productId === productId; });
                if (!line) return;
                editQtyProductId = productId;
                $('#editQtyProductName').text(line.name);
                $('#editQtyProductMeta').text(fmtMoney(line.price) + ' each');
                $('#editQtyInput').val(line.qty);
                updateEditQtyPreview();
                editQtyModal.show();
            }

            function updateEditQtyPreview() {
                var line = cart.find(function (l) { return l.productId === editQtyProductId; });
                if (!line) return;
                var qty = parseInt($('#editQtyInput').val(), 10);
                if (isNaN(qty) || qty < 1) qty = 1;
                $('#editQtyPreviewTotal').text(fmtMoney(line.price * qty));
            }

            $('#editQtyInput').on('input', updateEditQtyPreview);
            $('#editQtyIncrementBtn').on('click', function () {
                var qty = parseInt($('#editQtyInput').val(), 10);
                if (isNaN(qty)) qty = 0;
                $('#editQtyInput').val(qty + 1);
                updateEditQtyPreview();
            });
            $('#editQtyDecrementBtn').on('click', function () {
                var qty = parseInt($('#editQtyInput').val(), 10);
                if (isNaN(qty)) qty = 1;
                if (qty > 1) $('#editQtyInput').val(qty - 1);
                updateEditQtyPreview();
            });
            $('#editQtyUpdateBtn').on('click', function () {
                var qty = parseInt($('#editQtyInput').val(), 10);
                if (isNaN(qty) || qty < 1) qty = 1;
                setLineQty(editQtyProductId, qty);
                editQtyModal.hide();
            });

            // ----------------------------------------------------------------
            // Payment — mirrors Mercurius.Mobile/PaymentPage.xaml.cs exactly (quick-amount tiers,
            // live change calculation, Cash vs Card).
            // ----------------------------------------------------------------
            var paymentModal = new bootstrap.Modal(document.getElementById('paymentModal'));

            function buildQuickAmounts(total) {
                var tiers = [20, 50, 100, 500, 1000];
                var suggestions = [total];
                tiers.forEach(function (t) {
                    if (t >= total && suggestions.indexOf(t) === -1) suggestions.push(t);
                });
                suggestions = suggestions.filter(function (v, i) { return suggestions.indexOf(v) === i; })
                    .sort(function (a, b) { return a - b; })
                    .slice(0, 4);

                var row = $('#quickAmountsRow');
                row.empty();
                suggestions.forEach(function (amount) {
                    var col = $('<div class="col-6"></div>');
                    var btn = $('<button type="button" class="btn btn-light w-100">' + fmtMoney(amount) + '</button>');
                    btn.on('click', function () { $('#cashReceivedInput').val(amount.toFixed(2)).trigger('input'); });
                    col.append(btn);
                    row.append(col);
                });
            }

            $('#chargeBtn').on('click', function () {
                var total = cartTotal();
                $('#paymentError').hide();
                $('#totalDueLabel').text(fmtMoney(total));
                $('#cashReceivedInput').val('');
                $('#changeLabel').text('').removeClass('text-success text-danger');
                $('#chargeCashBtn').prop('disabled', true);
                buildQuickAmounts(total);
                paymentModal.show();
            });

            $('#cashReceivedInput').on('input', function () {
                var total = cartTotal();
                var received = parseFloat($(this).val());
                if (!isNaN(received) && received >= total) {
                    var change = received - total;
                    $('#changeLabel').text(change > 0 ? 'Change: ' + fmtMoney(change) : 'Exact amount').removeClass('text-danger').addClass('text-success');
                    $('#chargeCashBtn').prop('disabled', false);
                } else {
                    $('#changeLabel').text(isNaN(received) ? '' : 'Amount is less than the total due').removeClass('text-success').addClass('text-danger');
                    $('#chargeCashBtn').prop('disabled', true);
                }
            });

            function submitSale(paymentMethod, amountReceived) {
                $('#paymentError').hide();
                var formData = new FormData();
                formData.append('__RequestVerificationToken', $('input[name="__RequestVerificationToken"]').val());
                formData.append('customerId', $('#customerSelect').val() || '0');
                formData.append('notes', $('#notesInput').val() || '');
                formData.append('paymentMethod', paymentMethod);
                formData.append('amountReceived', amountReceived);
                cart.forEach(function (line) { formData.append('items', line.productId + ':' + line.qty); });

                $.ajax({
                    url: '@Url.Action("NewSale", "Sales")',
                    method: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false
                }).done(function (result) {
                    paymentModal.hide();
                    var msg = 'Sale complete — Invoice ' + result.invoiceNumber + '.';
                    if (paymentMethod === 'Cash' && result.change > 0) {
                        msg += ' Change: ' + fmtMoney(result.change) + '.';
                    }
                    showToast(msg);
                    clearCart();
                    $('#notesInput').val('');
                    loadProducts();
                }).fail(function (xhr) {
                    var msg = 'Failed to complete sale.';
                    try { msg = JSON.parse(xhr.responseText).error || msg; } catch (e) {}
                    $('#paymentError').text(msg).show();
                });
            }

            $('#chargeCashBtn').on('click', function () {
                var received = parseFloat($('#cashReceivedInput').val());
                if (isNaN(received)) received = cartTotal();
                submitSale('Cash', received);
            });
            $('#chargeCardBtn').on('click', function () {
                submitSale('Card', cartTotal());
            });

            function showToast(message) {
                var toast = $('<div class="position-fixed bottom-0 end-0 p-3" style="z-index: 9999;"><div class="toast" role="alert"><div class="toast-body bg-dark text-white rounded">' + esc(message) + '</div></div></div>');
                $('body').append(toast);
                var bsToast = new bootstrap.Toast(toast.find('.toast')[0], { delay: 3000 });
                bsToast.show();
                toast.on('hidden.bs.toast', function () { toast.remove(); });
            }

            // ----------------------------------------------------------------
            // Init
            // ----------------------------------------------------------------
            loadCategories();
            loadProducts();
            renderCart();
        });
    </script>
    <form id="antiForgeryHolder" style="display:none;">@Html.AntiForgeryToken()</form>
}
