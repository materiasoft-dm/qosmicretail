@implements IDisposable
@* A MudButton that shows it is working. While its OnClick handler runs (a save, a charge, a refund...)
   it shows a spinner and cannot be clicked again, so a slow or offline-retrying action never looks
   like a dead button, and a double click can't send the change twice. Busy lets a page that already
   tracks its own "saving" flag drive the same look. Use it in place of MudButton for any button that
   has an OnClick. *@
<MudButton Color="Color" Variant="Variant" Size="Size" FullWidth="FullWidth" Class="@Class" Style="@Style"
           StartIcon="@(IsBusy ? null : StartIcon)" EndIcon="@EndIcon"
           Disabled="@(Disabled || IsBusy)" OnClick="ClickAsync" aria-busy="@(IsBusy ? "true" : null)" @attributes="Extra">
    @if (IsBusy)
    {
        <MudProgressCircular Color="Color.Inherit" Size="Size.Small" Indeterminate="true" Class="me-2" Style="width:16px;height:16px;" />
    }
    @ChildContent
</MudButton>

@code {
    [Parameter] public Color Color { get; set; } = Color.Default;
    [Parameter] public Variant Variant { get; set; } = Variant.Text;
    [Parameter] public Size Size { get; set; } = Size.Medium;
    [Parameter] public bool FullWidth { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Style { get; set; }
    [Parameter] public string? StartIcon { get; set; }
    [Parameter] public string? EndIcon { get; set; }
    [Parameter] public bool Disabled { get; set; }
    /// <summary>The page's own "working" flag; it shows the spinner too.</summary>
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback<Microsoft.AspNetCore.Components.Web.MouseEventArgs> OnClick { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? Extra { get; set; }

    private bool _running;
    private bool _disposed;
    private bool IsBusy => Busy || _running;

    private async Task ClickAsync(Microsoft.AspNetCore.Components.Web.MouseEventArgs e)
    {
        if (_running) return;
        _running = true;
        StateHasChanged();
        try
        {
            await OnClick.InvokeAsync(e);
        }
        finally
        {
            _running = false;
            // A dialog that closed itself has already disposed this button.
            if (!_disposed) StateHasChanged();
        }
    }

    public void Dispose() => _disposed = true;
}
