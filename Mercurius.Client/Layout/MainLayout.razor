@inherits LayoutComponentBase
@inject Mercurius.Client.Services.CurrentUserState CurrentUser
@inject Mercurius.Client.Services.ICurrentUserProfileSource ProfileSource
@inject Mercurius.Client.Services.PwaService Pwa
@inject Mercurius.Client.Services.SyncService Sync
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@implements IDisposable

<MudThemeProvider Theme="MercuriusMudTheme.Theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

@* data-interactive flips to true once WebAssembly has taken over from the prerendered HTML —
   until then the page is visible but buttons don't respond yet (the E2E tests wait for it). *@
<div class="page" data-interactive="@(_interactive ? "true" : "false")">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <header class="topbar">
            <div class="topbar-context">
                @if (!string.IsNullOrEmpty(CurrentUser.User.TenantName))
                {
                    <span class="topbar-tenant">@CurrentUser.User.TenantName</span>
                }
                @if (!string.IsNullOrEmpty(CurrentUser.User.CurrentLocationName))
                {
                    <span class="topbar-branch"><i class="bi bi-shop"></i> @CurrentUser.User.CurrentLocationName</span>
                }
            </div>
            <div class="topbar-actions">
                <SyncIndicator />
                <AuthorizeView Policy="@ModuleRegistry.Pages.NEWSALE_CREATE">
                    <MudButton Href="sell" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.PointOfSale" Class="d-none d-sm-inline-flex">New sale</MudButton>
                </AuthorizeView>
                <div class="account-menu">
                    <button type="button" class="user-chip" id="userMenu" aria-haspopup="menu"
                            aria-expanded="@(_accountOpen ? "true" : "false")" @onclick="ToggleAccount">
                        <span class="user-avatar">@Initials</span>
                        <span class="user-text d-none d-md-flex">
                            <span class="user-name">@DisplayName</span>
                            <span class="user-email">@CurrentUser.User.Email</span>
                        </span>
                        <i class="bi bi-chevron-down"></i>
                    </button>
                    @if (_accountOpen)
                    {
                        @* Hand-rolled like the sidebar's branch switcher: this used to be a MudMenu
                           whose activator never opened (aria-expanded stayed false and the popover
                           stayed empty), which made "Account settings" and "Log out" unreachable. *@
                        <div class="account-menu-panel" id="accountMenuPanel">
                            <a class="account-menu-item" href="account/settings" @onclick="CloseAccount">
                                <i class="bi bi-person-gear"></i> Account settings
                            </a>
                            <div class="account-menu-divider"></div>
                            @* A real form POST: signing out clears the sign-in cookie on the server. *@
                            <form action="account/logout" method="post" class="logout-form">
                                <AntiforgeryToken />
                                <button type="submit" class="logout-button" id="logoutButton">
                                    <i class="bi bi-box-arrow-right"></i> Log out
                                </button>
                            </form>
                        </div>
                    }
                </div>
            </div>
        </header>

        <article class="content px-4">
            @* A page that throws (most often: its data can't be loaded because there's no connection
               and this computer hasn't saved it yet) shows a message here instead of breaking the
               whole app. Moving to another page clears it. *@
            <ErrorBoundary @ref="_errorBoundary">
                <ChildContent>@Body</ChildContent>
                <ErrorContent Context="error">
                    <div class="page-error" role="alert" id="pageError">
                        @if (Sync.Status.IsOffline || error is HttpRequestException)
                        {
                            <i class="bi bi-wifi-off page-error-icon"></i>
                            <h2>This page needs a connection</h2>
                            <p>You're offline, and this page hasn't been saved on this computer yet. Selling keeps working: sales are saved here and sent automatically when the connection is back.</p>
                            <MudButton Href="sell" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PointOfSale">Go to Sell</MudButton>
                        }
                        else
                        {
                            <i class="bi bi-exclamation-triangle page-error-icon"></i>
                            <h2>Something went wrong on this page</h2>
                            <p>Reload to try again. If it keeps happening, an administrator can find the details under Settings → Logs.</p>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => Nav.NavigateTo(Nav.Uri, forceLoad: true))">Reload</MudButton>
                        }
                    </div>
                </ErrorContent>
            </ErrorBoundary>
        </article>
    </main>
</div>

@code {
    // Built on the server while prerendering and carried into the browser with the page, so the
    // shell (tenant, branch, branch switcher) is right on first paint with no extra request.
    [PersistentState] public Mercurius.Shared.Account.CurrentUserDto? Profile { get; set; }

    private string DisplayName => string.IsNullOrWhiteSpace(CurrentUser.User.FullName) ? CurrentUser.User.Email ?? "" : CurrentUser.User.FullName!;

    private string Initials
    {
        get
        {
            var parts = DisplayName.Split(new[] { ' ', '@', '.' }, StringSplitOptions.RemoveEmptyEntries);
            return parts.Length switch
            {
                0 => "?",
                1 => parts[0][..1].ToUpperInvariant(),
                _ => (parts[0][..1] + parts[1][..1]).ToUpperInvariant()
            };
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Profile ??= await ProfileSource.GetAsync();
        CurrentUser.Set(Profile);
    }

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private ErrorBoundary? _errorBoundary;
    private bool _interactive;
    private bool _accountOpen;

    private void ToggleAccount() => _accountOpen = !_accountOpen;
    private void CloseAccount() => _accountOpen = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _interactive = true;
        Nav.LocationChanged += OnLocationChanged;
        Sync.ChangeQueued += OnChangeQueued;
        StateHasChanged();

        // Offline support: send anything waiting, keep the till's catalog, and save the pages a
        // cashier needs to open this app with no connection.
        var user = AuthState != null ? (await AuthState).User : new System.Security.Claims.ClaimsPrincipal();
        var sells = user.Can(ModuleRegistry.Pages.NEWSALE_CREATE);
        await Sync.StartAsync(keepCatalog: sells, pagesToSave: sells ? new[] { "/sell", "/" } : new[] { "/" });
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) =>
        _errorBoundary?.Recover();

    // A change the server couldn't be reached for was saved on this computer instead (OfflineWriteHandler).
    private void OnChangeQueued(string label, bool signInNeeded) => InvokeAsync(() =>
        Snackbar.Add(signInNeeded
            ? $"{label}: your sign-in has expired. It's saved on this computer and will be sent once you sign in again."
            : $"{label}: saved on this computer. It will be sent when the connection is back.", Severity.Warning));

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
        Sync.ChangeQueued -= OnChangeQueued;
    }
}
