@page "/medicine-batches/{ProductId:int}"
@attribute [Authorize]
@inject MedicineBatchesApiClient Api

<PageTitle>Medicine Batches</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Batches — @(_result?.ProductName ?? "...")</h1>
    <button class="btn btn-primary" @onclick="() => _showCreate = true">Add Batch</button>
</div>

@if (_showCreate)
{
    <div class="card mb-3">
        <div class="card-body">
            <div class="row g-2">
                <div class="col-md-2"><input class="form-control" placeholder="Batch #" @bind="_batchNumber" /></div>
                <div class="col-md-2"><input type="date" class="form-control" @bind="_expiryDate" /></div>
                <div class="col-md-2"><input type="number" min="0" step="0.01" class="form-control" placeholder="Unit cost" @bind="_unitCost" /></div>
                <div class="col-md-2"><input type="number" min="0" step="0.01" class="form-control" placeholder="Unit sale price" @bind="_unitSalePrice" /></div>
                <div class="col-md-2"><input type="number" min="0" step="0.01" class="form-control" placeholder="Quantity" @bind="_initialQuantity" /></div>
            </div>
            @if (_error != null) { <p class="text-danger mt-2 mb-0">@_error</p> }
            <div class="mt-3">
                <button class="btn btn-primary" @onclick="Submit">Save</button>
                <button class="btn btn-light" @onclick="() => _showCreate = false">Cancel</button>
            </div>
        </div>
    </div>
}

@if (_result is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <table class="table table-striped">
        <thead><tr><th>Batch #</th><th>Expiry</th><th>Received</th><th class="text-end">Cost</th><th class="text-end">Sale price</th><th class="text-end">Remaining / Initial</th></tr></thead>
        <tbody>
            @foreach (var b in _result.Items)
            {
                <tr>
                    <td>@b.BatchNumber</td>
                    <td>@b.ExpiryDate.ToString("yyyy-MM-dd")</td>
                    <td>@b.ReceivedDate.ToString("yyyy-MM-dd")</td>
                    <td class="text-end">@Money.Format(b.UnitCost)</td>
                    <td class="text-end">@Money.Format(b.UnitSalePrice)</td>
                    <td class="text-end">@b.RemainingQuantity / @b.InitialQuantity</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    [Parameter] public int ProductId { get; set; }

    private MedicineBatchListResultDto? _result;
    private bool _showCreate;
    private string _batchNumber = string.Empty;
    private DateTime _expiryDate = DateTime.Today.AddYears(1);
    private decimal _unitCost, _unitSalePrice, _initialQuantity;
    private string? _error;

    protected override async Task OnInitializedAsync() => await LoadAsync();
    private async Task LoadAsync() => _result = await Api.GetAsync(ProductId);

    private async Task Submit()
    {
        var (success, error) = await Api.CreateAsync(new CreateMedicineBatchRequest
        {
            ProductId = ProductId,
            BatchNumber = _batchNumber,
            ExpiryDate = _expiryDate,
            UnitCost = _unitCost,
            UnitSalePrice = _unitSalePrice,
            InitialQuantity = _initialQuantity
        });
        if (!success) { _error = error; return; }
        _showCreate = false;
        _batchNumber = string.Empty; _unitCost = _unitSalePrice = _initialQuantity = 0;
        await LoadAsync();
    }
}
