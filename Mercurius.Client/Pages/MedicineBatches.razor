@page "/medicine-batches/{ProductId:int}"
@attribute [Authorize]
@inject MedicineBatchesApiClient Api
@inject ISnackbar Snackbar

<PageTitle>Medicine Batches</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <MudText Typo="Typo.h4">Batches — @(_result?.ProductName ?? "...")</MudText>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => _showCreate = true)">
        Add Batch
    </MudButton>
</div>

@if (_showCreate)
{
    <MudPaper Class="pa-4 mb-4" Elevation="2">
        <MudGrid>
            <MudItem xs="12" md="2"><MudTextField @bind-Value="_batchNumber" Label="Batch #" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="2"><MudDatePicker @bind-Date="_expiryDate" Label="Expiry" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="2"><MudNumericField @bind-Value="_unitCost" Min="0" Format="N2" Label="Unit cost" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="2"><MudNumericField @bind-Value="_unitSalePrice" Min="0" Format="N2" Label="Unit sale price" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="2"><MudNumericField @bind-Value="_initialQuantity" Min="0" Format="N2" Label="Quantity" Variant="Variant.Outlined" /></MudItem>
        </MudGrid>
        @if (_error != null)
        {
            <MudAlert Severity="Severity.Error" Class="mt-3">@_error</MudAlert>
        }
        <div class="mt-3">
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit">Save</MudButton>
            <MudButton OnClick="@(() => _showCreate = false)">Cancel</MudButton>
        </div>
    </MudPaper>
}

<MudPaper Class="pa-2" Elevation="2">
    <MudTable Items="@(_result?.Items ?? new())" Loading="@(_result is null)" Hover="true" Dense="true">
        <HeaderContent>
            <MudTh>Batch #</MudTh>
            <MudTh>Expiry</MudTh>
            <MudTh>Received</MudTh>
            <MudTh Style="text-align:right;">Cost</MudTh>
            <MudTh Style="text-align:right;">Sale price</MudTh>
            <MudTh Style="text-align:right;">Remaining / Initial</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Batch #">@context.BatchNumber</MudTd>
            <MudTd DataLabel="Expiry">@context.ExpiryDate.ToString("yyyy-MM-dd")</MudTd>
            <MudTd DataLabel="Received">@context.ReceivedDate.ToString("yyyy-MM-dd")</MudTd>
            <MudTd DataLabel="Cost" Style="text-align:right;">@Money.Format(context.UnitCost)</MudTd>
            <MudTd DataLabel="Sale price" Style="text-align:right;">@Money.Format(context.UnitSalePrice)</MudTd>
            <MudTd DataLabel="Remaining / Initial" Style="text-align:right;">@context.RemainingQuantity / @context.InitialQuantity</MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>No batches yet.</MudText>
        </NoRecordsContent>
    </MudTable>
</MudPaper>

@code {
    [Parameter] public int ProductId { get; set; }

    private MedicineBatchListResultDto? _result;
    private bool _showCreate;
    private string _batchNumber = string.Empty;
    private DateTime? _expiryDate = DateTime.Today.AddYears(1);
    private decimal _unitCost, _unitSalePrice, _initialQuantity;
    private string? _error;

    protected override async Task OnInitializedAsync() => await LoadAsync();
    private async Task LoadAsync() => _result = await Api.GetAsync(ProductId);

    private async Task Submit()
    {
        var (success, error) = await Api.CreateAsync(new CreateMedicineBatchRequest
        {
            ProductId = ProductId,
            BatchNumber = _batchNumber,
            ExpiryDate = _expiryDate ?? DateTime.Today.AddYears(1),
            UnitCost = _unitCost,
            UnitSalePrice = _unitSalePrice,
            InitialQuantity = _initialQuantity
        });
        if (!success) { _error = error; return; }
        _showCreate = false;
        _batchNumber = string.Empty; _unitCost = _unitSalePrice = _initialQuantity = 0;
        Snackbar.Add("Batch added.", Severity.Success);
        await LoadAsync();
    }
}
