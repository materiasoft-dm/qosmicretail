@page "/purchase-orders"
@attribute [Authorize(Policy = ModuleRegistry.Pages.PURCHASE_ORDERS_LIST)]
@inject PurchaseOrdersApiClient Api
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>Purchase Orders</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <MudText Typo="Typo.h4">Purchase Orders</MudText>
    @if (_user.Can(ModuleRegistry.Pages.PURCHASE_ORDERS_CREATE))
    {
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Href="purchase-orders/new">
            New Purchase Order
        </MudButton>
    }
</div>

<MudPaper Class="pa-2" Elevation="2">
    <MudTable RowsPerPage="25" T="PurchaseOrderListItemDto" Items="@(_result?.Items ?? new())" Loading="@(_result is null)" Hover="true" Dense="true"
              OnRowClick="@((TableRowClickEventArgs<PurchaseOrderListItemDto> e) => Nav.NavigateTo($"purchase-orders/{e.Item?.Id}"))" RowStyle="cursor:pointer;">
        <HeaderContent>
            <MudTh>Order #</MudTh>
            <MudTh>Supplier</MudTh>
            <MudTh>Date</MudTh>
            <MudTh>Status</MudTh>
            <MudTh Style="text-align:right;">Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Order #"><code>@context.OrderNumber</code></MudTd>
            <MudTd DataLabel="Supplier">@context.SupplierName</MudTd>
            <MudTd DataLabel="Date">@LocalTime.FormatDate(context.OrderDate)</MudTd>
            <MudTd DataLabel="Status">
                <MudChip T="string" Size="Size.Small" Color="@PurchaseOrderStatus.Color(context.Status)">@PurchaseOrderStatus.Label(context.Status)</MudChip>
            </MudTd>
            <MudTd DataLabel="Actions" Style="text-align:right; white-space:nowrap;">
                @* Stops the row's own click (open details) from also firing under these buttons. *@
                <div class="d-inline-flex gap-1" @onclick:stopPropagation="true">
                    @if (PurchaseOrderStatus.CanReceive(context.Status) && _user.Can(ModuleRegistry.Pages.SHIPMENT_CREATE))
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.LocalShipping" Href="@($"shipments?poId={context.Id}")">Receive</MudButton>
                    }
                    @if (context.Status == PurchaseOrderStatus.PendingApproval && _canEdit)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Href="@($"purchase-orders/{context.Id}/edit")" aria-label="Edit" />
                    }
                    @if (context.Status == PurchaseOrderStatus.PendingApproval && _canApprove)
                    {
                        <MudButton Size="Size.Small" Color="Color.Success" Variant="Variant.Filled" Disabled="_busy"
                                   OnClick="@(() => RunAsync(() => Api.ApproveAsync(context.Id), "Purchase order approved."))">Approve</MudButton>
                    }
                    else if (context.Status == PurchaseOrderStatus.Approved && _canEdit)
                    {
                        <MudButton Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled" Disabled="_busy"
                                   OnClick="@(() => RunAsync(() => Api.MarkSentAsync(context.Id), "Marked as sent to the supplier."))">Mark sent</MudButton>
                    }
                    else if (context.Status == PurchaseOrderStatus.OrderSent && _canEdit)
                    {
                        <MudButton Size="Size.Small" Color="Color.Success" Variant="Variant.Filled" Disabled="_busy"
                                   OnClick="@(() => RunAsync(() => Api.MarkReceivedAsync(context.Id, true), "Marked as received."))">Complete</MudButton>
                        <MudButton Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled" Disabled="_busy"
                                   OnClick="@(() => RunAsync(() => Api.MarkReceivedAsync(context.Id, false), "Marked as received (incomplete)."))">Incomplete</MudButton>
                    }
                </div>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>No purchase orders yet.</MudText>
        </NoRecordsContent>
        <PagerContent>
            <MudTablePager PageSizeOptions="@(new[] { 25, 50, 100 })" />
        </PagerContent>
    </MudTable>
</MudPaper>

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    private System.Security.Claims.ClaimsPrincipal _user = new();
    private ListResultDto<PurchaseOrderListItemDto>? _result;
    private bool _busy;

    // Actions the user's role can't perform are hidden (the server refuses them regardless).
    private bool _canEdit;
    private bool _canApprove;

    protected override async Task OnInitializedAsync()
    {
        _user = (await AuthState).User;
        _canEdit = _user.Can(ModuleRegistry.Pages.PURCHASE_ORDERS_EDIT);
        _canApprove = _user.Can(ModuleRegistry.Pages.PURCHASE_ORDERS_APPROVE);
        if (!RendererInfo.IsInteractive) return; // prerendering: show the loading state; the browser loads the data
        await LoadAsync();
    }
    private async Task LoadAsync() => _result = await Api.GetAsync();

    private async Task RunAsync(Func<Task<(bool Success, string? Error)>> action, string successMessage)
    {
        _busy = true;
        try
        {
            var (success, error) = await action();
            if (success) Snackbar.Add(successMessage, Severity.Success);
            else Snackbar.Add(error ?? "The order couldn't be updated.", Severity.Error);
            await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }
}
