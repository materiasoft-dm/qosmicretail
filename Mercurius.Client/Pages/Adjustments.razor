@page "/adjustments"
@attribute [Authorize(Policy = ModuleRegistry.Pages.ADJUSTMENTS_INDEX)]
@using Mercurius.Client.Pages.Dialogs
@inject AdjustmentsApiClient Api
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Adjustments</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <MudText Typo="Typo.h4">Stock Adjustments</MudText>
    @if (_canCreate)
    {
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateAsync">
            New Adjustment
        </MudButton>
    }
</div>

<MudTextField T="string" Value="_search" ValueChanged="OnSearchChanged" Label="Search by product, SKU or note..." Variant="Variant.Outlined"
              Immediate="true" Clearable="true" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Class="mb-4" Style="max-width:360px;" />

<MudPaper Class="pa-2" Elevation="2">
    <MudTable T="AdjustmentListItemDto" @ref="_table" ServerData="LoadPageAsync" Hover="true" Dense="true" RowsPerPage="25">
        <HeaderContent>
            <MudTh><MudTableSortLabel T="AdjustmentListItemDto" SortLabel="date" InitialDirection="SortDirection.Descending">Date</MudTableSortLabel></MudTh>
            <MudTh>Product</MudTh>
            <MudTh>Reason</MudTh>
            <MudTh Style="text-align:right;"><MudTableSortLabel T="AdjustmentListItemDto" SortLabel="quantity">Quantity</MudTableSortLabel></MudTh>
            <MudTh>Note</MudTh>
            <MudTh>Refund</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Date">@LocalTime.FormatDateTime(context.Date)</MudTd>
            <MudTd DataLabel="Product">
                @context.ProductName
                @if (!string.IsNullOrEmpty(context.ProductCode))
                {
                    <MudText Typo="Typo.caption" Class="d-block mud-text-secondary">@context.ProductCode</MudText>
                }
            </MudTd>
            <MudTd DataLabel="Reason">@context.ReasonName</MudTd>
            <MudTd DataLabel="Quantity" Style="text-align:right;">
                <MudText Typo="Typo.body2" Color="@(context.IsInbound ? Color.Success : Color.Error)">
                    @(context.IsInbound ? "+" : "−")@context.Quantity.ToString("0.##")
                </MudText>
            </MudTd>
            <MudTd DataLabel="Note">@context.Note</MudTd>
            <MudTd DataLabel="Refund">
                @if (context.InvoiceId.HasValue)
                {
                    <MudLink Href="@($"invoices/{context.InvoiceId}")">Invoice #@context.InvoiceId</MudLink>
                }
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>No adjustments found.</MudText>
        </NoRecordsContent>
        <PagerContent>
            <MudTablePager PageSizeOptions="@(new[] { 10, 25, 50, 100 })" />
        </PagerContent>
    </MudTable>
</MudPaper>

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    private bool _canCreate;
    private MudTable<AdjustmentListItemDto>? _table;
    private string _search = string.Empty;
    private CancellationTokenSource? _debounce;

    protected override async Task OnInitializedAsync()
    {
        _canCreate = (await AuthState).User.Can(ModuleRegistry.Pages.ADJUSTMENTS_CREATE);
    }

    private async Task<TableData<AdjustmentListItemDto>> LoadPageAsync(TableState state, CancellationToken token)
    {
        var desc = state.SortDirection != SortDirection.Ascending;
        var result = await Api.GetAsync(_search, state.Page + 1, state.PageSize, state.SortLabel, desc, token);
        return new TableData<AdjustmentListItemDto> { Items = result.Items, TotalItems = result.Total };
    }

    private async Task OnSearchChanged(string? value)
    {
        _search = value ?? string.Empty;
        _debounce?.Cancel();
        _debounce = new CancellationTokenSource();
        var token = _debounce.Token;
        try
        {
            await Task.Delay(300, token);
            if (_table != null) await _table.ReloadServerData();
        }
        catch (TaskCanceledException)
        {
            // Superseded by a newer keystroke.
        }
    }

    private async Task OpenCreateAsync()
    {
        var dialog = await DialogService.ShowAsync<AdjustmentDialog>("New Adjustment",
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        if (await dialog.Result is { Canceled: false })
        {
            Snackbar.Add("Adjustment recorded.", Severity.Success);
            if (_table != null) await _table.ReloadServerData();
        }
    }
}
