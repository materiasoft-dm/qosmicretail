@page "/adjustments"
@attribute [Authorize]
@inject AdjustmentsApiClient Api

<PageTitle>Adjustments</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Stock Adjustments</h1>
    <button class="btn btn-primary" @onclick="ShowCreate">New Adjustment</button>
</div>

@if (_showCreate)
{
    <div class="card mb-3">
        <div class="card-body">
            <div class="row g-2">
                <div class="col-md-4">
                    <input class="form-control" placeholder="Search product..." value="@_productSearch" @oninput="OnProductSearch" />
                    <select class="form-select mt-1" @bind="_productId" size="4">
                        @foreach (var p in _products)
                        {
                            <option value="@p.Id">@p.Name (@p.ProductCode)</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <select class="form-select" @bind="_reasonId">
                        <option value="0">-- Reason --</option>
                        @foreach (var r in _reasons)
                        {
                            <option value="@r.Id">@r.Name (@(r.IsInbound ? "+" : "-"))</option>
                        }
                    </select>
                </div>
                <div class="col-md-2"><input type="number" min="0.01" step="0.01" class="form-control" placeholder="Quantity" @bind="_quantity" /></div>
                <div class="col-md-3"><input class="form-control" placeholder="Note" @bind="_note" /></div>
            </div>
            @if (_error != null) { <p class="text-danger mt-2 mb-0">@_error</p> }
            <div class="mt-3">
                <button class="btn btn-primary" @onclick="Submit">Save</button>
                <button class="btn btn-light" @onclick="() => _showCreate = false">Cancel</button>
            </div>
        </div>
    </div>
}

@if (_result is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <table class="table table-striped">
        <thead><tr><th>Date</th><th>Reason</th><th class="text-end">Quantity</th><th>Refund invoice</th></tr></thead>
        <tbody>
            @foreach (var a in _result.Items)
            {
                <tr>
                    <td>@a.Date.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>@a.ReasonName</td>
                    <td class="text-end">@a.Quantity</td>
                    <td>@(a.InvoiceId.HasValue ? $"Invoice #{a.InvoiceId}" : "")</td>
                </tr>
            }
        </tbody>
    </table>
    <p class="text-muted">Showing @_result.Items.Count of @_result.Total</p>
}

@code {
    private ListResultDto<AdjustmentListItemDto>? _result;
    private List<AdjustmentReasonOptionDto> _reasons = new();
    private List<ProductOptionDto> _products = new();
    private bool _showCreate;
    private string _productSearch = string.Empty;
    private int _productId;
    private int _reasonId;
    private decimal _quantity;
    private string _note = string.Empty;
    private string? _error;
    private CancellationTokenSource? _debounce;

    protected override async Task OnInitializedAsync() => await LoadAsync();
    private async Task LoadAsync() => _result = await Api.GetAsync(null, 1, 50);

    private async Task ShowCreateAsync()
    {
        _reasons = await Api.GetReasonsAsync();
        _products = await Api.GetProductsAsync(null);
    }

    private void ShowCreate()
    {
        _showCreate = true; _error = null;
        _productId = 0; _reasonId = 0; _quantity = 0; _note = string.Empty; _productSearch = string.Empty;
        _ = ShowCreateAsync();
    }

    private async Task OnProductSearch(ChangeEventArgs e)
    {
        _productSearch = e.Value?.ToString() ?? string.Empty;
        _debounce?.Cancel();
        _debounce = new CancellationTokenSource();
        var token = _debounce.Token;
        try
        {
            await Task.Delay(300, token);
            _products = await Api.GetProductsAsync(_productSearch);
            StateHasChanged();
        }
        catch (TaskCanceledException) { }
    }

    private async Task Submit()
    {
        if (_productId <= 0 || _reasonId <= 0 || _quantity <= 0)
        {
            _error = "Product, reason, and a positive quantity are required.";
            return;
        }
        var (success, error) = await Api.CreateAsync(new CreateAdjustmentRequest { ProductId = _productId, ReasonId = _reasonId, Quantity = _quantity, Note = _note });
        if (!success) { _error = error; return; }
        _showCreate = false;
        await LoadAsync();
    }
}
