@page "/adjustments"
@attribute [Authorize]
@inject AdjustmentsApiClient Api
@inject ISnackbar Snackbar

<PageTitle>Adjustments</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <MudText Typo="Typo.h4">Stock Adjustments</MudText>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="ShowCreate">
        New Adjustment
    </MudButton>
</div>

@if (_showCreate)
{
    <MudPaper Class="pa-4 mb-4" Elevation="2">
        <MudGrid>
            <MudItem xs="12" md="4">
                <MudTextField T="string" Value="_productSearch" ValueChanged="OnProductSearch" Immediate="true" Label="Search product..." Variant="Variant.Outlined" />
                <MudList T="int" @bind-SelectedValue="_productId" Class="mt-1" Style="max-height:180px; overflow-y:auto; border:1px solid var(--mud-palette-lines-default); border-radius:4px;">
                    @foreach (var p in _products)
                    {
                        <MudListItem T="int" Value="@p.Id" Text="@($"{p.Name} ({p.ProductCode})")" />
                    }
                </MudList>
            </MudItem>
            <MudItem xs="12" md="3">
                <MudSelect T="int" @bind-Value="_reasonId" Label="Reason" Variant="Variant.Outlined">
                    <MudSelectItem T="int" Value="0">-- Reason --</MudSelectItem>
                    @foreach (var r in _reasons)
                    {
                        <MudSelectItem T="int" Value="@r.Id">@r.Name (@(r.IsInbound ? "+" : "-"))</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="2"><MudNumericField @bind-Value="_quantity" Min="0.01M" Format="N2" Label="Quantity" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="3"><MudTextField @bind-Value="_note" Label="Note" Variant="Variant.Outlined" /></MudItem>
        </MudGrid>
        @if (_error != null)
        {
            <MudAlert Severity="Severity.Error" Class="mt-3">@_error</MudAlert>
        }
        <div class="mt-3">
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit">Save</MudButton>
            <MudButton OnClick="@(() => _showCreate = false)">Cancel</MudButton>
        </div>
    </MudPaper>
}

<MudPaper Class="pa-2" Elevation="2">
    <MudTable Items="@(_result?.Items ?? new())" Loading="@(_result is null)" Hover="true" Dense="true">
        <HeaderContent>
            <MudTh>Date</MudTh>
            <MudTh>Reason</MudTh>
            <MudTh Style="text-align:right;">Quantity</MudTh>
            <MudTh>Refund invoice</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Date">@context.Date.ToString("yyyy-MM-dd HH:mm")</MudTd>
            <MudTd DataLabel="Reason">@context.ReasonName</MudTd>
            <MudTd DataLabel="Quantity" Style="text-align:right;">@context.Quantity</MudTd>
            <MudTd DataLabel="Refund invoice">@(context.InvoiceId.HasValue ? $"Invoice #{context.InvoiceId}" : "")</MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>No adjustments yet.</MudText>
        </NoRecordsContent>
    </MudTable>
    @if (_result is not null && _result.Items.Count > 0)
    {
        <MudText Typo="Typo.caption" Class="pa-2 d-block">Showing @_result.Items.Count of @_result.Total</MudText>
    }
</MudPaper>

@code {
    private ListResultDto<AdjustmentListItemDto>? _result;
    private List<AdjustmentReasonOptionDto> _reasons = new();
    private List<ProductOptionDto> _products = new();
    private bool _showCreate;
    private string _productSearch = string.Empty;
    private int _productId;
    private int _reasonId;
    private decimal _quantity;
    private string _note = string.Empty;
    private string? _error;
    private CancellationTokenSource? _debounce;

    protected override async Task OnInitializedAsync() => await LoadAsync();
    private async Task LoadAsync() => _result = await Api.GetAsync(null, 1, 50);

    private async Task ShowCreateAsync()
    {
        _reasons = await Api.GetReasonsAsync();
        _products = await Api.GetProductsAsync(null);
    }

    private void ShowCreate()
    {
        _showCreate = true; _error = null;
        _productId = 0; _reasonId = 0; _quantity = 0; _note = string.Empty; _productSearch = string.Empty;
        _ = ShowCreateAsync();
    }

    private async Task OnProductSearch(string value)
    {
        _productSearch = value;
        _debounce?.Cancel();
        _debounce = new CancellationTokenSource();
        var token = _debounce.Token;
        try
        {
            await Task.Delay(300, token);
            _products = await Api.GetProductsAsync(_productSearch);
            StateHasChanged();
        }
        catch (TaskCanceledException) { }
    }

    private async Task Submit()
    {
        if (_productId <= 0 || _reasonId <= 0 || _quantity <= 0)
        {
            _error = "Product, reason, and a positive quantity are required.";
            return;
        }
        var (success, error) = await Api.CreateAsync(new CreateAdjustmentRequest { ProductId = _productId, ReasonId = _reasonId, Quantity = _quantity, Note = _note });
        if (!success) { _error = error; return; }
        _showCreate = false;
        Snackbar.Add("Adjustment recorded.", Severity.Success);
        await LoadAsync();
    }
}
