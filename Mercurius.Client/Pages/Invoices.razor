@page "/invoices"
@attribute [Authorize(Policy = ModuleRegistry.Pages.INVOICE_INDEX)]
@inject InvoicesApiClient Api
@inject NavigationManager Nav

<PageTitle>Invoices</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <MudText Typo="Typo.h4">Invoices</MudText>
    @if (_canSell)
    {
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PointOfSale" Href="sell">New sale</MudButton>
    }
</div>

<MudTextField T="string" Value="_search" ValueChanged="OnSearchChanged" Label="Search by invoice # or customer..." Variant="Variant.Outlined"
              Immediate="true" Clearable="true" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Class="mb-4" Style="max-width:320px;" />

<MudPaper Class="pa-2" Elevation="2">
    <MudTable T="InvoiceListItemDto" @ref="_table" ServerData="LoadPageAsync" Hover="true" Dense="true" RowsPerPage="25"
              OnRowClick="@((TableRowClickEventArgs<InvoiceListItemDto> e) => GoToInvoice(e.Item?.Id ?? 0))" RowStyle="cursor:pointer;">
        <HeaderContent>
            <MudTh><MudTableSortLabel T="InvoiceListItemDto" SortLabel="number">Invoice #</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel T="InvoiceListItemDto" SortLabel="date" InitialDirection="SortDirection.Descending">Date</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel T="InvoiceListItemDto" SortLabel="due">Due date</MudTableSortLabel></MudTh>
            <MudTh>Customer</MudTh>
            <MudTh><MudTableSortLabel T="InvoiceListItemDto" SortLabel="status">Status</MudTableSortLabel></MudTh>
            <MudTh Style="text-align:right;"><MudTableSortLabel T="InvoiceListItemDto" SortLabel="paid">Paid amount</MudTableSortLabel></MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Invoice #">@context.InvoiceNumber</MudTd>
            <MudTd DataLabel="Date">@LocalTime.FormatDateTime(context.InvoiceDate)</MudTd>
            <MudTd DataLabel="Due date">@(context.InvoiceDueDate.HasValue ? LocalTime.FormatDate(context.InvoiceDueDate.Value) : "")</MudTd>
            <MudTd DataLabel="Customer">@(string.IsNullOrEmpty(context.CustomerName) ? "(no customer)" : context.CustomerName)</MudTd>
            <MudTd DataLabel="Status">
                <MudChip T="string" Size="Size.Small" Color="@StatusColor(context.StatusId)">@context.StatusName</MudChip>
                @if (context.HasRefund)
                {
                    <MudTooltip Text="Has refund">
                        <MudIcon Icon="@Icons.Material.Filled.Replay" Size="Size.Small" Color="Color.Error" Class="ms-1" />
                    </MudTooltip>
                }
            </MudTd>
            <MudTd DataLabel="Paid amount" Style="text-align:right;">@(context.PaidAmount.HasValue ? Money.Format(context.PaidAmount.Value) : "-")</MudTd>
            <MudTd @onclick:stopPropagation="true">
                <MudButton Size="Size.Small" Href="@($"invoices/{context.Id}")">View</MudButton>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>No invoices found.</MudText>
        </NoRecordsContent>
        <PagerContent>
            <MudTablePager PageSizeOptions="@(new[] { 10, 25, 50, 100 })" />
        </PagerContent>
    </MudTable>
</MudPaper>

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    private bool _canSell;
    private MudTable<InvoiceListItemDto>? _table;
    private string _search = string.Empty;
    private CancellationTokenSource? _debounce;

    protected override async Task OnInitializedAsync()
    {
        _canSell = (await AuthState).User.Can(ModuleRegistry.Pages.NEWSALE_CREATE);
    }

    private async Task<TableData<InvoiceListItemDto>> LoadPageAsync(TableState state, CancellationToken token)
    {
        var desc = state.SortDirection != SortDirection.Ascending;
        var result = await Api.GetAsync(_search, state.Page + 1, state.PageSize, state.SortLabel, desc, token);
        return new TableData<InvoiceListItemDto> { Items = result.Items, TotalItems = result.Total };
    }

    private void GoToInvoice(int id)
    {
        if (id > 0) Nav.NavigateTo($"invoices/{id}");
    }

    private async Task OnSearchChanged(string? value)
    {
        _search = value ?? string.Empty;
        _debounce?.Cancel();
        _debounce = new CancellationTokenSource();
        var token = _debounce.Token;
        try
        {
            await Task.Delay(300, token);
            if (_table != null) await _table.ReloadServerData();
        }
        catch (TaskCanceledException)
        {
            // Superseded by a newer keystroke.
        }
    }

    // StatusCollection.InvoiceStatus: 1 Draft, 2 Completed, 3 Finalized, 4 Refunded, 5 Deleted,
    // 6 DeferredPayment, 7 PartiallyPaid.
    private static Color StatusColor(int statusId) => statusId switch
    {
        1 => Color.Secondary,
        2 => Color.Success,
        3 => Color.Primary,
        4 => Color.Error,
        5 => Color.Dark,
        6 => Color.Warning,
        7 => Color.Info,
        _ => Color.Default
    };
}
