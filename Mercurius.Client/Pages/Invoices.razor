@page "/invoices"
@attribute [Authorize]
@inject InvoicesApiClient Api
@inject NavigationManager Nav

<PageTitle>Invoices</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Invoices</MudText>

<MudTextField T="string" Value="_search" ValueChanged="OnSearchChanged" Label="Search by invoice # or customer..." Variant="Variant.Outlined"
              Immediate="true" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Class="mb-4" Style="max-width:320px;" />

<MudPaper Class="pa-2" Elevation="2">
    <MudTable Items="@(_result?.Items ?? new())" Loading="_loading" Hover="true" Dense="true" OnRowClick="@((TableRowClickEventArgs<InvoiceListItemDto> e) => GoToInvoice(e.Item?.Id ?? 0))" T="InvoiceListItemDto">
        <HeaderContent>
            <MudTh>Invoice #</MudTh>
            <MudTh>Date</MudTh>
            <MudTh>Customer</MudTh>
            <MudTh>Status</MudTh>
            <MudTh Style="text-align:right;">Paid amount</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Invoice #">@context.InvoiceNumber</MudTd>
            <MudTd DataLabel="Date">@context.InvoiceDate.ToString("yyyy-MM-dd")</MudTd>
            <MudTd DataLabel="Customer">@(string.IsNullOrEmpty(context.CustomerName) ? "(no customer)" : context.CustomerName)</MudTd>
            <MudTd DataLabel="Status">
                <MudChip T="string" Size="Size.Small" Color="@StatusColor(context.StatusId)">@context.StatusName</MudChip>
                @if (context.HasRefund)
                {
                    <MudIcon Icon="@Icons.Material.Filled.Replay" Size="Size.Small" Title="Has refund" Class="ms-1" />
                }
            </MudTd>
            <MudTd DataLabel="Paid amount" Style="text-align:right;">@(context.PaidAmount.HasValue ? Money.Format(context.PaidAmount.Value) : "-")</MudTd>
            <MudTd @onclick:stopPropagation="true">
                <MudButton Size="Size.Small" Href="@($"invoices/{context.Id}")">View</MudButton>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>No invoices found.</MudText>
        </NoRecordsContent>
    </MudTable>
    @if (_result is not null && _result.Items.Count > 0)
    {
        <MudText Typo="Typo.caption" Class="pa-2 d-block">Showing @_result.Items.Count of @_result.Total</MudText>
    }
</MudPaper>

@code {
    private InvoiceListResultDto? _result;
    private bool _loading = true;
    private string _search = string.Empty;
    private CancellationTokenSource? _debounce;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    // Deliberately no leading "/" — this app is hosted under /app (see
    // Mercurius.Client.csproj's StaticWebAssetBasePath), and a leading-slash path resolves
    // against the site root per normal browser URL rules, ignoring <base href>. That sent
    // real browser navigations to /invoices/{id} on the server (which the MVC app doesn't
    // recognize — a 404) instead of staying inside the Blazor router. A relative path resolves
    // against the current <base href> correctly.
    private void GoToInvoice(int id) => Nav.NavigateTo("invoices/" + id);

    private async Task LoadAsync()
    {
        _loading = true;
        _result = await Api.GetAsync(_search, page: 1, pageSize: 50);
        _loading = false;
    }

    private async Task OnSearchChanged(string value)
    {
        _search = value;
        _debounce?.Cancel();
        _debounce = new CancellationTokenSource();
        var token = _debounce.Token;
        try
        {
            await Task.Delay(300, token);
            await LoadAsync();
            StateHasChanged();
        }
        catch (TaskCanceledException) { }
    }

    // Mirrors Views/Invoices/Index.cshtml's statusBadgeClass(): 1 Draft, 2 Completed,
    // 3 Finalized, 4 Refunded, 5 Deleted, 6 DeferredPayment, 7 PartiallyPaid.
    private static Color StatusColor(int statusId) => statusId switch
    {
        1 => Color.Secondary,
        2 => Color.Success,
        3 => Color.Primary,
        4 => Color.Error,
        5 => Color.Dark,
        6 => Color.Warning,
        7 => Color.Info,
        _ => Color.Default
    };
}
