@page "/products"
@attribute [Authorize(Policy = ModuleRegistry.Pages.PRODUCTS_INDEX)]
@inject ProductsApiClient Api
@inject NavigationManager Nav

<PageTitle>Products</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <MudText Typo="Typo.h4">Products</MudText>
    @if (_user.Can(ModuleRegistry.Pages.PRODUCTS_CREATE))
    {
        <div class="d-flex gap-2">
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.UploadFile" Href="products/import">
                Import CSV
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Href="products/new">
                Add Product
            </MudButton>
        </div>
    }
</div>

<div class="d-flex flex-wrap gap-4 mb-4">
    <MudTextField T="string" Value="_search" ValueChanged="OnSearchChanged" Label="Search by name, SKU or barcode..." Variant="Variant.Outlined"
                  Immediate="true" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Style="max-width:340px;" Clearable="true" />
    <MudSelect T="int?" Value="_categoryId" ValueChanged="OnCategoryChanged" Label="Category" Variant="Variant.Outlined" Style="max-width:260px;" Clearable="true">
        @foreach (var c in _categories)
        {
            <MudSelectItem T="int?" Value="@((int?)c.Id)">@c.Name</MudSelectItem>
        }
    </MudSelect>
</div>

<MudPaper Class="pa-2" Elevation="2">
    <MudTable T="ProductListItemDto" @ref="_table" ServerData="LoadPageAsync" Hover="true" Dense="true" RowsPerPage="25"
              OnRowClick="@((TableRowClickEventArgs<ProductListItemDto> e) => Nav.NavigateTo($"products/{e.Item?.Id}"))" RowStyle="cursor:pointer;">
        <HeaderContent>
            <MudTh><MudTableSortLabel T="ProductListItemDto" SortLabel="code">SKU</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel T="ProductListItemDto" SortLabel="name" InitialDirection="SortDirection.Ascending">Name</MudTableSortLabel></MudTh>
            <MudTh>Category</MudTh>
            <MudTh Style="text-align:right;"><MudTableSortLabel T="ProductListItemDto" SortLabel="cost">Cost price</MudTableSortLabel></MudTh>
            <MudTh Style="text-align:right;"><MudTableSortLabel T="ProductListItemDto" SortLabel="price">Sale price</MudTableSortLabel></MudTh>
            <MudTh Style="text-align:right;"><MudTableSortLabel T="ProductListItemDto" SortLabel="stock">Stock</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel T="ProductListItemDto" SortLabel="status">Status</MudTableSortLabel></MudTh>
            <MudTh Style="text-align:right;">Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="SKU">@context.ProductCode</MudTd>
            <MudTd DataLabel="Name">
                <div>@context.Name</div>
                @if (!string.IsNullOrEmpty(context.Barcode))
                {
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">Barcode @context.Barcode</MudText>
                }
            </MudTd>
            <MudTd DataLabel="Category">@context.Category</MudTd>
            <MudTd DataLabel="Cost price" Style="text-align:right;">@(context.CostPrice.HasValue ? Money.Format(context.CostPrice.Value) : "-")</MudTd>
            <MudTd DataLabel="Sale price" Style="text-align:right;">@(context.SalePrice.HasValue ? Money.Format(context.SalePrice.Value) : "-")</MudTd>
            <MudTd DataLabel="Stock" Style="text-align:right;">
                <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="@(context.Stock <= context.LowStockCount ? Color.Error : Color.Success)">
                    @context.Stock.ToString("0.##")
                </MudChip>
            </MudTd>
            <MudTd DataLabel="Status">
                <MudChip T="string" Size="Size.Small" Color="@(context.IsActive ? Color.Success : Color.Default)">@(context.IsActive ? "Active" : "Inactive")</MudChip>
            </MudTd>
            <MudTd Style="text-align:right; white-space:nowrap;">
                @* Stops the row's own click (open details) from also firing under these links. *@
                <div class="d-inline-flex" @onclick:stopPropagation="true">
                    <MudIconButton Icon="@Icons.Material.Filled.Inventory2" Size="Size.Small" Href="@($"medicine-batches/{context.Id}")" aria-label="Batches" />
                    <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small" Href="@($"products/{context.Id}")" aria-label="View" />
                    @if (_user.Can(ModuleRegistry.Pages.PRODUCTS_EDIT))
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Href="@($"products/{context.Id}/edit")" aria-label="Edit" />
                    }
                </div>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>No products found.</MudText>
        </NoRecordsContent>
        <LoadingContent>
            <MudText>Loading...</MudText>
        </LoadingContent>
        <PagerContent>
            <MudTablePager PageSizeOptions="@(new[] { 25, 50, 100, 200 })" />
        </PagerContent>
    </MudTable>
</MudPaper>

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    private System.Security.Claims.ClaimsPrincipal _user = new();
    private MudTable<ProductListItemDto>? _table;
    private string _search = string.Empty;
    private int? _categoryId;
    private CancellationTokenSource? _debounce;
    private List<Mercurius.Shared.Configuration.ProductCategoryDto> _categories = new();

    protected override async Task OnInitializedAsync()
    {
        _user = (await AuthState).User;
        if (!RendererInfo.IsInteractive) return; // prerendering: show the loading state; the browser loads the data
        _categories = await Api.GetCategoryOptionsAsync();
    }

    private async Task<TableData<ProductListItemDto>> LoadPageAsync(TableState state, CancellationToken token)
    {
        var result = await Api.GetAsync(_search, state.Page + 1, state.PageSize, _categoryId,
            state.SortLabel, state.SortDirection == SortDirection.Descending, token);
        return new TableData<ProductListItemDto> { Items = result.Items, TotalItems = result.Total };
    }

    private async Task OnSearchChanged(string value)
    {
        _search = value ?? string.Empty;
        _debounce?.Cancel();
        _debounce = new CancellationTokenSource();
        var token = _debounce.Token;
        try
        {
            await Task.Delay(300, token);
            if (_table != null) await _table.ReloadServerData();
        }
        catch (TaskCanceledException)
        {
            // Superseded by a newer keystroke â€” ignore.
        }
    }

    private async Task OnCategoryChanged(int? value)
    {
        _categoryId = value;
        if (_table != null) await _table.ReloadServerData();
    }
}
