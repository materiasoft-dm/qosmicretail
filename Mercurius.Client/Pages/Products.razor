@page "/products"
@attribute [Authorize]
@inject ProductsApiClient Api
@inject ISnackbar Snackbar

<PageTitle>Products</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <MudText Typo="Typo.h4">Products</MudText>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="ShowCreate">
        Add Product
    </MudButton>
</div>

@if (_showCreate)
{
    <MudPaper Class="pa-4 mb-4" Elevation="2">
        <MudGrid>
            <MudItem xs="12" md="3"><MudTextField @bind-Value="_createCode" Label="SKU" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="4"><MudTextField @bind-Value="_createName" Label="Name" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="3">
                <MudSelect T="string" @bind-Value="_createCategoryId" Label="Category" Variant="Variant.Outlined">
                    @foreach (var c in _categories)
                    {
                        <MudSelectItem T="string" Value="@c.Id.ToString()">@c.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="2"><MudNumericField @bind-Value="_createLeadTimeDays" Label="Lead time (days)" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="3"><MudNumericField @bind-Value="_createCostPrice" Label="Cost price" Format="N2" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="3"><MudNumericField @bind-Value="_createMarkUpPercentage" Label="Markup %" Format="N2" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="3"><MudNumericField @bind-Value="_createSalePrice" Label="Sale price" Format="N2" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="3"><MudNumericField @bind-Value="_createLowStockCount" Label="Low stock count" Format="N2" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12"><MudTextField @bind-Value="_createNote" Label="Note" Variant="Variant.Outlined" /></MudItem>
        </MudGrid>
        @if (_createError != null)
        {
            <MudAlert Severity="Severity.Error" Class="mt-3">@_createError</MudAlert>
        }
        <div class="mt-3">
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitCreate">Save</MudButton>
            <MudButton OnClick="@(() => _showCreate = false)">Cancel</MudButton>
        </div>
    </MudPaper>
}

<MudTextField T="string" Value="_search" ValueChanged="OnSearchChanged" Label="Search by name or SKU..." Variant="Variant.Outlined"
              Immediate="true" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Class="mb-4" Style="max-width:320px;" />

<MudPaper Class="pa-2" Elevation="2">
    <MudTable Items="@(_result?.Items ?? new())" Loading="_loading" Hover="true" Dense="true">
        <HeaderContent>
            <MudTh>SKU</MudTh>
            <MudTh>Name</MudTh>
            <MudTh>Category</MudTh>
            <MudTh>Stock</MudTh>
            <MudTh>Sale price</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="SKU">@context.ProductCode</MudTd>
            <MudTd DataLabel="Name">@context.Name</MudTd>
            <MudTd DataLabel="Category">@context.Category</MudTd>
            <MudTd DataLabel="Stock">
                <MudText Color="@(context.Stock <= context.LowStockCount ? Color.Error : Color.Success)">@context.Stock</MudText>
            </MudTd>
            <MudTd DataLabel="Sale price">@(context.SalePrice.HasValue ? Money.Format(context.SalePrice.Value) : "-")</MudTd>
            <MudTd>
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Href="@($"products/{context.Id}/edit")" />
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>No products found.</MudText>
        </NoRecordsContent>
    </MudTable>
    @if (_result is not null && _result.Items.Count > 0)
    {
        <MudText Typo="Typo.caption" Class="pa-2 d-block">Showing @_result.Items.Count of @_result.Total</MudText>
    }
</MudPaper>

@code {
    private ProductListResultDto? _result;
    private bool _loading = true;
    private string _search = string.Empty;
    private CancellationTokenSource? _debounce;

    private List<Mercurius.Shared.Configuration.ProductCategoryDto> _categories = new();
    private bool _showCreate;
    private string _createCode = string.Empty;
    private string _createName = string.Empty;
    private string? _createCategoryId;
    private int? _createLeadTimeDays;
    private decimal? _createCostPrice;
    private decimal _createMarkUpPercentage;
    private decimal? _createSalePrice;
    private decimal _createLowStockCount;
    private string _createNote = string.Empty;
    private string? _createError;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        _categories = await Api.GetCategoryOptionsAsync();
    }

    private void ShowCreate()
    {
        _showCreate = true;
        _createError = null;
        _createCode = _createName = _createNote = string.Empty;
        _createCategoryId = null;
        _createLeadTimeDays = null;
        _createCostPrice = null;
        _createSalePrice = null;
        _createMarkUpPercentage = 0;
        _createLowStockCount = 0;
    }

    private async Task SubmitCreate()
    {
        if (string.IsNullOrWhiteSpace(_createCode) || string.IsNullOrWhiteSpace(_createName))
        {
            _createError = "SKU and Name are required.";
            return;
        }

        var request = new CreateProductRequest
        {
            ProductCode = _createCode,
            Name = _createName,
            ProductCategoryId = int.TryParse(_createCategoryId, out var catId) ? catId : null,
            CurrentCostPrice = _createCostPrice,
            MarkUpPercentage = _createMarkUpPercentage,
            CurrentSalePrice = _createSalePrice,
            LeadTimeDays = _createLeadTimeDays,
            LowStockCount = _createLowStockCount,
            Note = _createNote
        };
        var (success, error) = await Api.CreateAsync(request);
        if (!success)
        {
            _createError = error;
            return;
        }
        _showCreate = false;
        Snackbar.Add("Product created.", Severity.Success);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _result = await Api.GetAsync(_search, page: 1, pageSize: 50);
        _loading = false;
    }

    private async Task OnSearchChanged(string value)
    {
        _search = value;
        _debounce?.Cancel();
        _debounce = new CancellationTokenSource();
        var token = _debounce.Token;
        try
        {
            await Task.Delay(300, token);
            await LoadAsync();
            StateHasChanged();
        }
        catch (TaskCanceledException)
        {
            // Superseded by a newer keystroke — ignore.
        }
    }
}
