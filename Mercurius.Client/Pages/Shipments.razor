@page "/shipments"
@attribute [Authorize]
@inject ShipmentsApiClient Api
@inject ISnackbar Snackbar

<PageTitle>Shipments</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <MudText Typo="Typo.h4">Shipments</MudText>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="ShowCreate">
        New Shipment
    </MudButton>
</div>

@if (_showCreate)
{
    <MudPaper Class="pa-4 mb-4" Elevation="2">
        <MudGrid>
            <MudItem xs="12" md="3">
                <MudSelect T="int" @bind-Value="_purchaseOrderId" @bind-Value:after="OnPurchaseOrderChanged" Label="Purchase order (optional)" Variant="Variant.Outlined">
                    <MudSelectItem T="int" Value="0">-- Purchase order (optional) --</MudSelectItem>
                    @foreach (var po in _purchaseOrders)
                    {
                        <MudSelectItem T="int" Value="@po.Id">@po.OrderNumber</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="3">
                <MudSelect T="int" @bind-Value="_supplierId" Label="Supplier" Variant="Variant.Outlined">
                    <MudSelectItem T="int" Value="0">-- Supplier --</MudSelectItem>
                    @foreach (var s in _suppliers)
                    {
                        <MudSelectItem T="int" Value="@s.Id">@s.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="3"><MudTextField @bind-Value="_trackingNumber" Label="Tracking number" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="3"><MudTextField @bind-Value="_notes" Label="Notes" Variant="Variant.Outlined" /></MudItem>
        </MudGrid>
        <div class="mt-3">
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit">Save</MudButton>
            <MudButton OnClick="@(() => _showCreate = false)">Cancel</MudButton>
        </div>
    </MudPaper>
}

<MudPaper Class="pa-2" Elevation="2">
    <MudTable Items="@(_result?.Items ?? new())" Loading="@(_result is null)" Hover="true" Dense="true">
        <HeaderContent>
            <MudTh>Status</MudTh>
            <MudTh>Date</MudTh>
            <MudTh>Supplier</MudTh>
            <MudTh>Tracking #</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Status"><MudChip T="string" Size="Size.Small" Color="Color.Info">@context.StatusName</MudChip></MudTd>
            <MudTd DataLabel="Date">@context.Date.ToString("yyyy-MM-dd")</MudTd>
            <MudTd DataLabel="Supplier">@context.SupplierName</MudTd>
            <MudTd DataLabel="Tracking #">@context.TrackingNumber</MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>No shipments yet.</MudText>
        </NoRecordsContent>
    </MudTable>
</MudPaper>

@code {
    private ListResultDto<ShipmentListItemDto>? _result;
    private List<SupplierOptionDto> _suppliers = new();
    private List<PurchaseOrderOptionDto> _purchaseOrders = new();
    private bool _showCreate;
    private int _purchaseOrderId;
    private int _supplierId;
    private string _trackingNumber = string.Empty, _notes = string.Empty;

    protected override async Task OnInitializedAsync() => await LoadAsync();
    private async Task LoadAsync() => _result = await Api.GetAsync();

    private async void ShowCreate()
    {
        _showCreate = true;
        _purchaseOrderId = 0; _supplierId = 0; _trackingNumber = _notes = string.Empty;
        _suppliers = await Api.GetSuppliersAsync();
        _purchaseOrders = await Api.GetPurchaseOrdersAsync();
        StateHasChanged();
    }

    private void OnPurchaseOrderChanged()
    {
        var po = _purchaseOrders.FirstOrDefault(p => p.Id == _purchaseOrderId);
        if (po != null) _supplierId = po.SupplierId;
    }

    private async Task Submit()
    {
        await Api.CreateAsync(new CreateShipmentRequest
        {
            SupplierId = _supplierId > 0 ? _supplierId : null,
            PurchaseOrderId = _purchaseOrderId > 0 ? _purchaseOrderId : null,
            TrackingNumber = _trackingNumber,
            Notes = _notes
        });
        _showCreate = false;
        Snackbar.Add("Shipment created.", Severity.Success);
        await LoadAsync();
    }
}
