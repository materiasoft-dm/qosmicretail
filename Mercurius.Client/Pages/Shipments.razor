@page "/shipments"
@attribute [Authorize(Policy = ModuleRegistry.Pages.SHIPMENT_LIST)]
@inject ShipmentsApiClient Api
@inject ISnackbar Snackbar

<PageTitle>Shipments</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <MudText Typo="Typo.h4">Shipments</MudText>
    @if (_canCreate)
    {
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => ShowCreateAsync(null))">
            Receive Shipment
        </MudButton>
    }
</div>

@if (_showCreate)
{
    <MudPaper Class="pa-4 mb-4" Elevation="2">
        <MudText Typo="Typo.h6" Class="mb-3">Receive a shipment</MudText>
        <MudGrid Spacing="2">
            <MudItem xs="12" md="4">
                <MudSelect T="int" @bind-Value="_purchaseOrderId" @bind-Value:after="OnPurchaseOrderChanged" Label="Purchase order (optional)" Variant="Variant.Outlined">
                    <MudSelectItem T="int" Value="0">-- None --</MudSelectItem>
                    @foreach (var po in _purchaseOrders)
                    {
                        <MudSelectItem T="int" Value="@po.Id">@po.OrderNumber · @po.SupplierName</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="4">
                <MudSelect T="int" @bind-Value="_supplierId" Label="Supplier" Variant="Variant.Outlined">
                    <MudSelectItem T="int" Value="0">-- Supplier --</MudSelectItem>
                    @foreach (var s in _suppliers)
                    {
                        <MudSelectItem T="int" Value="@s.Id">@s.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="6" md="2">
                <MudDatePicker @bind-Date="_arrivalDate" Label="Arrival date" DateFormat="yyyy-MM-dd" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="6" md="2">
                <MudSelect T="int" @bind-Value="_statusId" Label="Status" Variant="Variant.Outlined">
                    @foreach (var status in _statuses)
                    {
                        <MudSelectItem T="int" Value="@status.Id">@status.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="4"><MudTextField @bind-Value="_trackingNumber" Label="Tracking number" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="8"><MudTextField @bind-Value="_notes" Label="Notes" Variant="Variant.Outlined" /></MudItem>
        </MudGrid>
        @if (_error != null)
        {
            <MudAlert Severity="Severity.Error" Class="mt-3">@_error</MudAlert>
        }
        <div class="d-flex justify-end gap-2 mt-3">
            <MudButton OnClick="@(() => _showCreate = false)">Cancel</MudButton>
            <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="_busy" OnClick="Submit">Save</MudButton>
        </div>
    </MudPaper>
}

<MudPaper Class="pa-2" Elevation="2">
    <MudTable Items="@(_result?.Items ?? new())" Loading="@(_result is null)" Hover="true" Dense="true" RowsPerPage="25">
        <HeaderContent>
            <MudTh>Status</MudTh>
            <MudTh>Arrival date</MudTh>
            <MudTh>Supplier</MudTh>
            <MudTh>Tracking #</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Status"><MudChip T="string" Size="Size.Small" Color="@StatusColor(context.StatusName)">@context.StatusName</MudChip></MudTd>
            <MudTd DataLabel="Arrival date">@LocalTime.FormatDate(context.Date)</MudTd>
            <MudTd DataLabel="Supplier">@context.SupplierName</MudTd>
            <MudTd DataLabel="Tracking #">@context.TrackingNumber</MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>No shipments yet.</MudText>
        </NoRecordsContent>
        <PagerContent>
            <MudTablePager PageSizeOptions="@(new[] { 25, 50, 100 })" />
        </PagerContent>
    </MudTable>
</MudPaper>

@code {
    // Set by a purchase order's "Receive" link: opens the form with that order preselected.
    [SupplyParameterFromQuery(Name = "poId")] public int? PoId { get; set; }

    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    private const int PendingStatusId = 1;

    private bool _canCreate;
    private ListResultDto<ShipmentListItemDto>? _result;
    private List<SupplierOptionDto> _suppliers = new();
    private List<PurchaseOrderOptionDto> _purchaseOrders = new();
    private List<ShipmentStatusDto> _statuses = new();
    private bool _showCreate;
    private bool _busy;
    private int _purchaseOrderId;
    private int _supplierId;
    private int _statusId = PendingStatusId;
    private DateTime? _arrivalDate = DateTime.Today;
    private string _trackingNumber = string.Empty, _notes = string.Empty;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        _canCreate = (await AuthState).User.Can(ModuleRegistry.Pages.SHIPMENT_CREATE);
        if (!RendererInfo.IsInteractive) return; // prerendering: show the loading state; the browser loads the data
        await LoadAsync();
        if (PoId is > 0 && _canCreate) await ShowCreateAsync(PoId);
    }

    private async Task LoadAsync() => _result = await Api.GetAsync();

    private static Color StatusColor(string status) => status switch
    {
        "Received" => Color.Success,
        "Delayed" => Color.Warning,
        "Damaged" => Color.Error,
        _ => Color.Info
    };

    private async Task ShowCreateAsync(int? purchaseOrderId)
    {
        _showCreate = true;
        _error = null;
        _purchaseOrderId = 0;
        _supplierId = 0;
        _statusId = PendingStatusId;
        _arrivalDate = DateTime.Today;
        _trackingNumber = _notes = string.Empty;
        _suppliers = await Api.GetSuppliersAsync();
        _purchaseOrders = await Api.GetPurchaseOrdersAsync();
        _statuses = await Api.GetStatusesAsync();
        if (purchaseOrderId.HasValue && _purchaseOrders.Any(p => p.Id == purchaseOrderId.Value))
        {
            _purchaseOrderId = purchaseOrderId.Value;
            OnPurchaseOrderChanged();
        }
    }

    private void OnPurchaseOrderChanged()
    {
        var po = _purchaseOrders.FirstOrDefault(p => p.Id == _purchaseOrderId);
        if (po != null) _supplierId = po.SupplierId;
    }

    private async Task Submit()
    {
        _error = null;
        _busy = true;
        try
        {
            var created = await Api.CreateAsync(new CreateShipmentRequest
            {
                SupplierId = _supplierId > 0 ? _supplierId : null,
                PurchaseOrderId = _purchaseOrderId > 0 ? _purchaseOrderId : null,
                // Today means now; another day is sent as the start of that day here, in UTC.
                ArrivalDate = _arrivalDate.HasValue && _arrivalDate.Value.Date != DateTime.Today
                    ? DateTime.SpecifyKind(_arrivalDate.Value.Date, DateTimeKind.Local).ToUniversalTime()
                    : null,
                StatusId = _statusId,
                TrackingNumber = _trackingNumber,
                Notes = _notes
            });
            if (!created)
            {
                _error = "The shipment couldn't be saved.";
                return;
            }
            _showCreate = false;
            Snackbar.Add("Shipment recorded.", Severity.Success);
            await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }
}
