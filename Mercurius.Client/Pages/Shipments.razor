@page "/shipments"
@attribute [Authorize]
@inject ShipmentsApiClient Api

<PageTitle>Shipments</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Shipments</h1>
    <button class="btn btn-primary" @onclick="ShowCreate">New Shipment</button>
</div>

@if (_showCreate)
{
    <div class="card mb-3">
        <div class="card-body">
            <div class="row g-2">
                <div class="col-md-3">
                    <select class="form-select" @bind="_purchaseOrderId" @bind:after="OnPurchaseOrderChanged">
                        <option value="0">-- Purchase order (optional) --</option>
                        @foreach (var po in _purchaseOrders)
                        {
                            <option value="@po.Id">@po.OrderNumber</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <select class="form-select" @bind="_supplierId">
                        <option value="0">-- Supplier --</option>
                        @foreach (var s in _suppliers)
                        {
                            <option value="@s.Id">@s.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-3"><input class="form-control" placeholder="Tracking number" @bind="_trackingNumber" /></div>
                <div class="col-md-3"><input class="form-control" placeholder="Notes" @bind="_notes" /></div>
            </div>
            <div class="mt-3">
                <button class="btn btn-primary" @onclick="Submit">Save</button>
                <button class="btn btn-light" @onclick="() => _showCreate = false">Cancel</button>
            </div>
        </div>
    </div>
}

@if (_result is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <table class="table table-striped">
        <thead><tr><th>Status</th><th>Date</th><th>Supplier</th><th>Tracking #</th></tr></thead>
        <tbody>
            @foreach (var s in _result.Items)
            {
                <tr><td>@s.StatusName</td><td>@s.Date.ToString("yyyy-MM-dd")</td><td>@s.SupplierName</td><td>@s.TrackingNumber</td></tr>
            }
        </tbody>
    </table>
}

@code {
    private ListResultDto<ShipmentListItemDto>? _result;
    private List<SupplierOptionDto> _suppliers = new();
    private List<PurchaseOrderOptionDto> _purchaseOrders = new();
    private bool _showCreate;
    private int _purchaseOrderId;
    private int _supplierId;
    private string _trackingNumber = string.Empty, _notes = string.Empty;

    protected override async Task OnInitializedAsync() => await LoadAsync();
    private async Task LoadAsync() => _result = await Api.GetAsync();

    private async void ShowCreate()
    {
        _showCreate = true;
        _purchaseOrderId = 0; _supplierId = 0; _trackingNumber = _notes = string.Empty;
        _suppliers = await Api.GetSuppliersAsync();
        _purchaseOrders = await Api.GetPurchaseOrdersAsync();
        StateHasChanged();
    }

    private void OnPurchaseOrderChanged()
    {
        var po = _purchaseOrders.FirstOrDefault(p => p.Id == _purchaseOrderId);
        if (po != null) _supplierId = po.SupplierId;
    }

    private async Task Submit()
    {
        await Api.CreateAsync(new CreateShipmentRequest
        {
            SupplierId = _supplierId > 0 ? _supplierId : null,
            PurchaseOrderId = _purchaseOrderId > 0 ? _purchaseOrderId : null,
            TrackingNumber = _trackingNumber,
            Notes = _notes
        });
        _showCreate = false;
        await LoadAsync();
    }
}
