@page "/suppliers"
@attribute [Authorize(Policy = ModuleRegistry.Pages.CONFIG_SUPPLIERS)]
@using Mercurius.Client.Pages.Dialogs
@inject SuppliersApiClient Api
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Suppliers</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <MudText Typo="Typo.h4">Suppliers</MudText>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => OpenAsync(null))">
        Add Supplier
    </MudButton>
</div>

<MudTextField T="string" Value="_search" ValueChanged="OnSearchChanged" Label="Search suppliers..." Variant="Variant.Outlined"
              Immediate="true" Clearable="true" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Class="mb-4" Style="max-width:320px;" />

<MudPaper Class="pa-2" Elevation="2">
    <MudTable T="SupplierListItemDto" @ref="_table" ServerData="LoadPageAsync" Hover="true" Dense="true" RowsPerPage="25">
        <HeaderContent>
            <MudTh>Name</MudTh>
            <MudTh>Status</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Name">@context.Name</MudTd>
            <MudTd DataLabel="Status">
                <MudChip T="string" Size="Size.Small" Color="@(context.IsActive ? Color.Success : Color.Default)">
                    @(context.IsActive ? "Active" : "Inactive")
                </MudChip>
            </MudTd>
            <MudTd>
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" aria-label="Edit" OnClick="() => OpenAsync(context)" />
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>No suppliers found.</MudText>
        </NoRecordsContent>
        <PagerContent>
            <MudTablePager PageSizeOptions="@(new[] { 10, 25, 50, 100 })" />
        </PagerContent>
    </MudTable>
</MudPaper>

@code {
    private MudTable<SupplierListItemDto>? _table;
    private string _search = string.Empty;
    private CancellationTokenSource? _debounce;

    private async Task<TableData<SupplierListItemDto>> LoadPageAsync(TableState state, CancellationToken token)
    {
        var result = await Api.GetAsync(_search, state.Page + 1, state.PageSize, token);
        return new TableData<SupplierListItemDto> { Items = result.Items, TotalItems = result.Total };
    }

    private async Task OnSearchChanged(string? value)
    {
        _search = value ?? string.Empty;
        _debounce?.Cancel();
        _debounce = new CancellationTokenSource();
        var token = _debounce.Token;
        try
        {
            await Task.Delay(300, token);
            if (_table != null) await _table.ReloadServerData();
        }
        catch (TaskCanceledException)
        {
            // Superseded by a newer keystroke.
        }
    }

    // Null adds a supplier; otherwise edits it.
    private async Task OpenAsync(SupplierListItemDto? supplier)
    {
        var parameters = new DialogParameters<SupplierDialog> { { d => d.Existing, supplier } };
        var dialog = await DialogService.ShowAsync<SupplierDialog>(supplier == null ? "Add Supplier" : "Edit Supplier", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        if (await dialog.Result is { Canceled: false })
        {
            Snackbar.Add(supplier == null ? "Supplier created." : "Supplier updated.", Severity.Success);
            if (_table != null) await _table.ReloadServerData();
        }
    }
}
