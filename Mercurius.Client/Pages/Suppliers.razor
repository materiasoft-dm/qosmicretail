@page "/suppliers"
@attribute [Authorize]
@inject SuppliersApiClient Api
@inject ISnackbar Snackbar

<PageTitle>Suppliers</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <MudText Typo="Typo.h4">Suppliers</MudText>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="ShowCreateForm">
        Add Supplier
    </MudButton>
</div>

<MudTextField T="string" Value="_search" ValueChanged="OnSearchChanged" Label="Search suppliers..." Variant="Variant.Outlined"
              Immediate="true" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Class="mb-4" Style="max-width:320px;" />

@if (_showCreate)
{
    <MudPaper Class="pa-4 mb-4" Elevation="2">
        <MudTextField @bind-Value="_newName" Label="Supplier name" Variant="Variant.Outlined" Style="max-width:400px;" />
        @if (!string.IsNullOrEmpty(_createError))
        {
            <MudAlert Severity="Severity.Error" Class="mt-3">@_createError</MudAlert>
        }
        <div class="mt-3">
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitCreate">Save</MudButton>
            <MudButton OnClick="@(() => _showCreate = false)">Cancel</MudButton>
        </div>
    </MudPaper>
}

<MudPaper Class="pa-2" Elevation="2">
    <MudTable Items="@(_result?.Items ?? new())" Loading="_loading" Hover="true" Dense="true">
        <HeaderContent>
            <MudTh>Name</MudTh>
            <MudTh>Active</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Name">@context.Name</MudTd>
            <MudTd DataLabel="Active">@(context.IsActive ? "Yes" : "No")</MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>No suppliers found.</MudText>
        </NoRecordsContent>
    </MudTable>
    @if (_result is not null && _result.Items.Count > 0)
    {
        <MudText Typo="Typo.caption" Class="pa-2 d-block">Showing @_result.Items.Count of @_result.Total</MudText>
    }
</MudPaper>

@code {
    private SupplierListResultDto? _result;
    private bool _loading = true;
    private string _search = string.Empty;
    private CancellationTokenSource? _debounce;

    private bool _showCreate;
    private string _newName = string.Empty;
    private string? _createError;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _result = await Api.GetAsync(_search, page: 1, pageSize: 50);
        _loading = false;
    }

    private async Task OnSearchChanged(string value)
    {
        _search = value;
        _debounce?.Cancel();
        _debounce = new CancellationTokenSource();
        var token = _debounce.Token;
        try
        {
            await Task.Delay(300, token);
            await LoadAsync();
            StateHasChanged();
        }
        catch (TaskCanceledException) { }
    }

    private void ShowCreateForm()
    {
        _showCreate = true;
        _createError = null;
        _newName = string.Empty;
    }

    private async Task SubmitCreate()
    {
        if (string.IsNullOrWhiteSpace(_newName))
        {
            _createError = "Name is required.";
            return;
        }
        var created = await Api.CreateAsync(new CreateSupplierRequest { Name = _newName });
        if (created == null)
        {
            _createError = "Failed to create supplier.";
            return;
        }
        _showCreate = false;
        Snackbar.Add("Supplier created.", Severity.Success);
        await LoadAsync();
    }
}
