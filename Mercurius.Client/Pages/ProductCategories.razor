@page "/product-categories"
@attribute [Authorize(Policy = ModuleRegistry.Pages.CONFIG_PRODUCT_CATEGORIES)]
@using Mercurius.Client.Pages.Dialogs
@inject ProductCategoriesApiClient Api
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Product Categories</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <MudText Typo="Typo.h4">Product Categories</MudText>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="ShowCreate">
        Add Category
    </MudButton>
</div>

@if (_showCreate)
{
    <MudPaper Class="pa-4 mb-4" Elevation="2">
        <MudGrid>
            <MudItem xs="12" md="4"><MudTextField @bind-Value="_name" Label="Name" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="6"><MudTextField @bind-Value="_description" Label="Description" Variant="Variant.Outlined" /></MudItem>
        </MudGrid>
        @if (_error != null)
        {
            <MudAlert Severity="Severity.Error" Class="mt-3">@_error</MudAlert>
        }
        <div class="mt-3">
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit">Save</MudButton>
            <MudButton OnClick="@(() => _showCreate = false)">Cancel</MudButton>
        </div>
    </MudPaper>
}

<MudPaper Class="pa-2" Elevation="2">
    <MudTable RowsPerPage="25" Items="@(_result?.Items ?? new())" Loading="@(_result is null)" Hover="true" Dense="true">
        <HeaderContent>
            <MudTh>Name</MudTh>
            <MudTh>Description</MudTh>
            <MudTh>Status</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Name">@context.Name</MudTd>
            <MudTd DataLabel="Description">@context.Description</MudTd>
            <MudTd DataLabel="Status">
                <MudChip T="string" Size="Size.Small" Color="@(context.IsActive ? Color.Success : Color.Default)">
                    @(context.IsActive ? "Active" : "Inactive")
                </MudChip>
            </MudTd>
            <MudTd>
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" aria-label="Edit" OnClick="() => OpenEdit(context)" />
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>No product categories yet.</MudText>
        </NoRecordsContent>
        <PagerContent>
            <MudTablePager PageSizeOptions="@(new[] { 25, 50, 100 })" />
        </PagerContent>
    </MudTable>
</MudPaper>

@code {
    private ListResultDto<ProductCategoryDto>? _result;
    private bool _showCreate;
    private string _name = string.Empty, _description = string.Empty;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        if (!RendererInfo.IsInteractive) return; // prerendering: show the loading state; the browser loads the data
        await LoadAsync();
    }
    private async Task LoadAsync() => _result = await Api.GetAsync();

    private void ShowCreate() { _showCreate = true; _error = null; _name = _description = string.Empty; }

    private async Task Submit()
    {
        if (string.IsNullOrWhiteSpace(_name)) { _error = "Name is required."; return; }
        var created = await Api.CreateAsync(new CreateProductCategoryRequest { Name = _name, Description = _description });
        if (created == null) { _error = "Failed to create."; return; }
        _showCreate = false;
        Snackbar.Add("Category created.", Severity.Success);
        await LoadAsync();
    }

    private async Task OpenEdit(ProductCategoryDto category)
    {
        var parameters = new DialogParameters<ProductCategoryDialog> { { d => d.Existing, category } };
        var dialog = await DialogService.ShowAsync<ProductCategoryDialog>("Edit Category", parameters);
        if (await dialog.Result is { Canceled: false })
        {
            Snackbar.Add("Category updated.", Severity.Success);
            await LoadAsync();
        }
    }
}
