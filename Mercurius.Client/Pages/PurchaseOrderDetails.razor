@page "/purchase-orders/{Id:int}"
@attribute [Authorize]
@inject PurchaseOrdersApiClient Api

<PageTitle>Purchase Order</PageTitle>

@if (_order is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <h1>@_order.OrderNumber</h1>
    <div class="row mb-4">
        <div class="col-md-3"><div class="text-muted small">Supplier</div><div>@_order.SupplierName</div></div>
        <div class="col-md-3"><div class="text-muted small">Status</div><div><span class="badge badge-light-info">@_order.Status</span></div></div>
        <div class="col-md-3"><div class="text-muted small">Order date</div><div>@_order.OrderDate.ToString("yyyy-MM-dd")</div></div>
        <div class="col-md-3"><div class="text-muted small">Expected delivery</div><div>@(_order.ExpectedDeliveryDate?.ToString("yyyy-MM-dd") ?? "-")</div></div>
    </div>
    @if (!string.IsNullOrEmpty(_order.Notes))
    {
        <p><strong>Notes:</strong> @_order.Notes</p>
    }

    <h5>Line items</h5>
    <table class="table table-striped">
        <thead><tr><th>Product</th><th class="text-end">Quantity</th><th class="text-end">Est. unit cost</th><th class="text-end">Received</th></tr></thead>
        <tbody>
            @foreach (var item in _order.Items)
            {
                <tr>
                    <td>@item.ProductName</td>
                    <td class="text-end">@item.Quantity</td>
                    <td class="text-end">@Money.Format(item.EstimatedUnitCost)</td>
                    <td class="text-end">@(item.ReceivedQuantity?.ToString() ?? "-")</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    [Parameter] public int Id { get; set; }
    private PurchaseOrderDetailDto? _order;

    protected override async Task OnInitializedAsync() => _order = await Api.GetDetailAsync(Id);
}
