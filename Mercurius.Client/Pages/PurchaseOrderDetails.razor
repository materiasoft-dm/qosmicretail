@page "/purchase-orders/{Id:int}"
@attribute [Authorize]
@inject PurchaseOrdersApiClient Api

<PageTitle>Purchase Order</PageTitle>

@if (_order is null)
{
    <MudText><em>Loading...</em></MudText>
}
else
{
    <MudText Typo="Typo.h4" Class="mb-4">@_order.OrderNumber</MudText>
    <MudGrid Class="mb-4">
        <MudItem xs="6" md="3"><MudText Typo="Typo.caption" Color="Color.Secondary">Supplier</MudText><MudText>@_order.SupplierName</MudText></MudItem>
        <MudItem xs="6" md="3"><MudText Typo="Typo.caption" Color="Color.Secondary">Status</MudText><MudChip T="string" Size="Size.Small" Color="Color.Info">@_order.Status</MudChip></MudItem>
        <MudItem xs="6" md="3"><MudText Typo="Typo.caption" Color="Color.Secondary">Order date</MudText><MudText>@_order.OrderDate.ToString("yyyy-MM-dd")</MudText></MudItem>
        <MudItem xs="6" md="3"><MudText Typo="Typo.caption" Color="Color.Secondary">Expected delivery</MudText><MudText>@(_order.ExpectedDeliveryDate?.ToString("yyyy-MM-dd") ?? "-")</MudText></MudItem>
    </MudGrid>
    @if (!string.IsNullOrEmpty(_order.Notes))
    {
        <MudText Class="mb-3"><strong>Notes:</strong> @_order.Notes</MudText>
    }

    <MudText Typo="Typo.h6" Class="mb-2">Line items</MudText>
    <MudPaper Class="pa-2" Elevation="2">
        <MudTable Items="_order.Items" Hover="true" Dense="true">
            <HeaderContent>
                <MudTh>Product</MudTh>
                <MudTh Style="text-align:right;">Quantity</MudTh>
                <MudTh Style="text-align:right;">Est. unit cost</MudTh>
                <MudTh Style="text-align:right;">Received</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Product">@context.ProductName</MudTd>
                <MudTd DataLabel="Quantity" Style="text-align:right;">@context.Quantity</MudTd>
                <MudTd DataLabel="Est. unit cost" Style="text-align:right;">@Money.Format(context.EstimatedUnitCost)</MudTd>
                <MudTd DataLabel="Received" Style="text-align:right;">@(context.ReceivedQuantity?.ToString() ?? "-")</MudTd>
            </RowTemplate>
        </MudTable>
    </MudPaper>
}

@code {
    [Parameter] public int Id { get; set; }
    private PurchaseOrderDetailDto? _order;

    protected override async Task OnInitializedAsync() => _order = await Api.GetDetailAsync(Id);
}
