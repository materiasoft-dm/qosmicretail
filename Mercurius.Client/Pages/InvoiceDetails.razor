@page "/invoices/{Id:int}"
@attribute [Authorize]
@using Mercurius.Client.Pages.Dialogs
@inject InvoicesApiClient Api
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Invoice @Id</PageTitle>

@if (_invoice is null)
{
    <MudText><em>Loading...</em></MudText>
}
else
{
    <MudText Typo="Typo.h4" Class="mb-4">Invoice @_invoice.InvoiceNumber</MudText>
    <MudGrid Class="mb-4">
        <MudItem xs="6" md="3"><MudText Typo="Typo.caption" Color="Color.Secondary">Date</MudText><MudText>@_invoice.InvoiceDate.ToString("yyyy-MM-dd")</MudText></MudItem>
        <MudItem xs="6" md="3"><MudText Typo="Typo.caption" Color="Color.Secondary">Customer</MudText><MudText>@(string.IsNullOrEmpty(_invoice.CustomerName) ? "(no customer)" : _invoice.CustomerName)</MudText></MudItem>
        <MudItem xs="6" md="3"><MudText Typo="Typo.caption" Color="Color.Secondary">Status</MudText><MudText>@_invoice.StatusName</MudText></MudItem>
        <MudItem xs="6" md="3"><MudText Typo="Typo.caption" Color="Color.Secondary">Paid amount</MudText><MudText>@Money.Format(_invoice.PaidAmount)</MudText></MudItem>
    </MudGrid>

    @if (_error != null)
    {
        <MudAlert Severity="Severity.Error" Class="mb-3">@_error</MudAlert>
    }
    @if (_message != null)
    {
        <MudAlert Severity="Severity.Success" Class="mb-3">@_message</MudAlert>
    }

    <MudText Typo="Typo.h6" Class="mb-2">Items</MudText>
    <MudPaper Class="pa-2 mb-4" Elevation="2">
        <MudTable Items="_invoice.Items" Hover="true" Dense="true">
            <HeaderContent>
                <MudTh>Product</MudTh>
                <MudTh Style="text-align:right;">Qty sold</MudTh>
                <MudTh Style="text-align:right;">Qty refunded</MudTh>
                <MudTh Style="text-align:right;">Remaining</MudTh>
                <MudTh Style="text-align:right;">Unit price</MudTh>
                <MudTh>Actions</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Product">@context.ProductName (@context.ProductCode)</MudTd>
                <MudTd DataLabel="Qty sold" Style="text-align:right;">@context.QuantitySold</MudTd>
                <MudTd DataLabel="Qty refunded" Style="text-align:right;">@context.QuantityRefunded</MudTd>
                <MudTd DataLabel="Remaining" Style="text-align:right;">@context.QuantityRemaining</MudTd>
                <MudTd DataLabel="Unit price" Style="text-align:right;">@Money.Format(context.SalePrice)</MudTd>
                <MudTd DataLabel="Actions">
                    @if (context.QuantityRemaining > 0)
                    {
                        <MudButton Size="Size.Small" Color="Color.Error" Variant="Variant.Filled" OnClick="@(() => OpenRefund(context))">Refund</MudButton>
                    }
                </MudTd>
            </RowTemplate>
        </MudTable>
    </MudPaper>

    <MudText Typo="Typo.h6" Class="mb-2">Refund History</MudText>
    @if (_invoice.RefundHistory.Count == 0)
    {
        <MudText Color="Color.Secondary">No refunds yet.</MudText>
    }
    else
    {
        <MudPaper Class="pa-2" Elevation="2">
            <MudTable Items="_invoice.RefundHistory" Hover="true" Dense="true">
                <HeaderContent>
                    <MudTh>Refund #</MudTh>
                    <MudTh>Date</MudTh>
                    <MudTh>Product</MudTh>
                    <MudTh Style="text-align:right;">Qty</MudTh>
                    <MudTh>Reason</MudTh>
                    <MudTh>Restocked</MudTh>
                    <MudTh>Remarks</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Refund #">@context.RefundNumber</MudTd>
                    <MudTd DataLabel="Date">@context.DateRefunded.ToString("yyyy-MM-dd")</MudTd>
                    <MudTd DataLabel="Product">@context.ProductName</MudTd>
                    <MudTd DataLabel="Qty" Style="text-align:right;">@context.Quantity</MudTd>
                    <MudTd DataLabel="Reason">@context.ReasonName</MudTd>
                    <MudTd DataLabel="Restocked">@(context.WasRestocked ? "Yes" : "No")</MudTd>
                    <MudTd DataLabel="Remarks">@context.Remarks</MudTd>
                </RowTemplate>
            </MudTable>
        </MudPaper>
    }
}

@code {
    [Parameter] public int Id { get; set; }

    private InvoiceDetailDto? _invoice;
    private string? _error;
    private string? _message;

    protected override async Task OnInitializedAsync() => await LoadAsync();
    private async Task LoadAsync() => _invoice = await Api.GetDetailAsync(Id);

    private async Task OpenRefund(InvoiceItemRowDto item)
    {
        if (_invoice == null) return;
        var parameters = new DialogParameters<RefundDialog>
        {
            { d => d.Item, item },
            { d => d.Reasons, _invoice.ActiveRefundReasons }
        };
        var dialog = await DialogService.ShowAsync<RefundDialog>($"Refund — {item.ProductName}", parameters);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            _message = "Refund processed.";
            _error = null;
            Snackbar.Add("Refund processed.", Severity.Success);
            await LoadAsync();
        }
    }
}
