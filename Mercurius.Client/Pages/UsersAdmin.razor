@page "/users-admin"
@attribute [Authorize]
@inject UsersApiClient Api
@inject ISnackbar Snackbar

<PageTitle>Users</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Users</MudText>

<MudSwitch T="bool" Value="_showDeactivated" ValueChanged="OnShowDeactivatedChanged" Color="Color.Primary" Label="Show deactivated users" Class="mb-3" />

@if (_error != null)
{
    <MudAlert Severity="Severity.Error" Class="mb-3">@_error</MudAlert>
}

<MudPaper Class="pa-2" Elevation="2">
    <MudTable Items="@(_result?.Items ?? new())" Loading="@(_result is null)" Hover="true" Dense="true">
        <HeaderContent>
            <MudTh>Username</MudTh>
            <MudTh>First name</MudTh>
            <MudTh>Last name</MudTh>
            <MudTh>Roles</MudTh>
            <MudTh>Active</MudTh>
            <MudTh>Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Username">@context.UserName</MudTd>
            <MudTd DataLabel="First name">@context.FirstName</MudTd>
            <MudTd DataLabel="Last name">@context.LastName</MudTd>
            <MudTd DataLabel="Roles">@context.Roles</MudTd>
            <MudTd DataLabel="Active">@(context.IsActive ? "Yes" : "No")</MudTd>
            <MudTd DataLabel="Actions">
                <MudButton Size="Size.Small" Variant="Variant.Outlined" Class="me-1" OnClick="@(() => ShowAssignRoles(context.Id))">Roles</MudButton>
                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="@(context.IsActive ? Color.Warning : Color.Success)"
                           OnClick="@(() => ToggleActive(context.Id, !context.IsActive))">
                    @(context.IsActive ? "Deactivate" : "Activate")
                </MudButton>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>No users found.</MudText>
        </NoRecordsContent>
    </MudTable>
</MudPaper>

@if (_assignUserId != null)
{
    <MudPaper Class="pa-4 mt-4" Elevation="2">
        <MudText Typo="Typo.h6" Class="mb-2">Assign roles</MudText>
        @foreach (var r in _allRoles)
        {
            <MudCheckBox T="bool" Value="@_selectedRoleIds.Contains(r.Id)" ValueChanged="@((bool v) => ToggleRole(r.Id, v))" Label="@r.Name" Color="Color.Primary" />
        }
        <div class="mt-2">
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveRoles">Save</MudButton>
            <MudButton OnClick="@(() => _assignUserId = null)">Cancel</MudButton>
        </div>
    </MudPaper>
}

@code {
    private ListResultDto<UserListItemDto>? _result;
    private bool _showDeactivated;
    private string? _error;
    private string? _assignUserId;
    private List<RoleDto> _allRoles = new();
    private HashSet<string> _selectedRoleIds = new();

    protected override async Task OnInitializedAsync() => await LoadAsync();
    private async Task LoadAsync() => _result = await Api.GetAsync(_showDeactivated);

    private async Task OnShowDeactivatedChanged(bool value)
    {
        _showDeactivated = value;
        await LoadAsync();
    }

    private async void ShowAssignRoles(string userId)
    {
        _assignUserId = userId;
        _allRoles = await Api.GetRolesAsync();
        StateHasChanged();
    }

    private void ToggleRole(string roleId, bool isChecked)
    {
        if (isChecked) _selectedRoleIds.Add(roleId); else _selectedRoleIds.Remove(roleId);
    }

    private async Task SaveRoles()
    {
        if (_assignUserId == null) return;
        await Api.AssignRolesAsync(_assignUserId, _selectedRoleIds.ToList());
        _assignUserId = null;
        Snackbar.Add("Roles updated.", Severity.Success);
        await LoadAsync();
    }

    private async Task ToggleActive(string id, bool activate)
    {
        var (success, error) = await Api.SetActiveAsync(id, activate);
        if (!success) { _error = error; return; }
        _error = null;
        Snackbar.Add(activate ? "User activated." : "User deactivated.", Severity.Success);
        await LoadAsync();
    }
}
