@page "/users-admin"
@attribute [Authorize(Policy = ModuleRegistry.Pages.ADMIN_USERS_MANAGEMENT)]
@using Mercurius.Client.Pages.Dialogs
@inject UsersApiClient Api
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Users</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <MudText Typo="Typo.h4">Users</MudText>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PersonAdd" OnClick="AddUserAsync">Add user</MudButton>
</div>

<MudSwitch T="bool" Value="_showDeactivated" ValueChanged="OnShowDeactivatedChanged" Color="Color.Primary" Label="Show deactivated users" Class="mb-3" />

@if (_error != null)
{
    <MudAlert Severity="Severity.Error" Class="mb-3" ShowCloseIcon="true" CloseIconClicked="@(() => _error = null)">@_error</MudAlert>
}

<MudPaper Class="pa-2" Elevation="2">
    <MudTable Items="@(_result?.Items ?? new())" Loading="@(_result is null)" Hover="true" Dense="true" RowsPerPage="25">
        <HeaderContent>
            <MudTh>Name</MudTh>
            <MudTh>Email</MudTh>
            <MudTh>Roles</MudTh>
            <MudTh>Status</MudTh>
            <MudTh>Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Name">
                @($"{context.FirstName} {context.LastName}".Trim())
                @if (context.IsCurrentUser)
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Class="ms-1">You</MudChip>
                }
            </MudTd>
            <MudTd DataLabel="Email">@(string.IsNullOrEmpty(context.Email) ? context.UserName : context.Email)</MudTd>
            <MudTd DataLabel="Roles">@(string.IsNullOrEmpty(context.Roles) ? "—" : context.Roles)</MudTd>
            <MudTd DataLabel="Status">
                <MudChip T="string" Size="Size.Small" Color="@(context.IsActive ? Color.Success : Color.Default)">@(context.IsActive ? "Active" : "Inactive")</MudChip>
                @if (context.IsLockedOut)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Warning">Locked out</MudChip>
                }
            </MudTd>
            <MudTd DataLabel="Actions">
                <MudButton Size="Size.Small" Variant="Variant.Outlined" Class="me-1" OnClick="@(() => EditRolesAsync(context))">Roles</MudButton>
                <MudButton Size="Size.Small" Variant="Variant.Outlined" Class="me-1" OnClick="@(() => ResetPasswordAsync(context))">Reset password</MudButton>
                @if (!context.IsCurrentUser)
                {
                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="@(context.IsActive ? Color.Warning : Color.Success)"
                               OnClick="@(() => ToggleActiveAsync(context))">
                        @(context.IsActive ? "Deactivate" : "Activate")
                    </MudButton>
                }
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>No users found.</MudText>
        </NoRecordsContent>
        <PagerContent>
            <MudTablePager PageSizeOptions="@(new[] { 25, 50, 100 })" />
        </PagerContent>
    </MudTable>
</MudPaper>

@code {
    private ListResultDto<UserListItemDto>? _result;
    private List<RoleDto>? _roles;
    private bool _showDeactivated;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        if (!RendererInfo.IsInteractive) return; // prerendering: show the loading state; the browser loads the data
        await LoadAsync();
    }

    private async Task LoadAsync() => _result = await Api.GetAsync(_showDeactivated);

    private async Task<List<RoleDto>> RolesAsync() => _roles ??= await Api.GetRolesAsync();

    private async Task OnShowDeactivatedChanged(bool value)
    {
        _showDeactivated = value;
        await LoadAsync();
    }

    private async Task AddUserAsync()
    {
        var parameters = new DialogParameters<UserDialog> { { d => d.Roles, await RolesAsync() } };
        var dialog = await DialogService.ShowAsync<UserDialog>("Add user", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        if (await dialog.Result is { Canceled: false })
        {
            Snackbar.Add("User added.", Severity.Success);
            await LoadAsync();
        }
    }

    private async Task EditRolesAsync(UserListItemDto user)
    {
        var parameters = new DialogParameters<UserRolesDialog>
        {
            { d => d.UserId, user.Id },
            { d => d.UserName, string.IsNullOrEmpty(user.Email) ? user.UserName : user.Email },
            { d => d.SelectedRoleIds, user.RoleIds },
            { d => d.Roles, await RolesAsync() }
        };
        var dialog = await DialogService.ShowAsync<UserRolesDialog>("Roles", parameters,
            new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true });
        if (await dialog.Result is { Canceled: false })
        {
            Snackbar.Add("Roles updated.", Severity.Success);
            await LoadAsync();
        }
    }

    private async Task ResetPasswordAsync(UserListItemDto user)
    {
        var parameters = new DialogParameters<ResetPasswordDialog>
        {
            { d => d.UserId, user.Id },
            { d => d.UserName, string.IsNullOrEmpty(user.Email) ? user.UserName : user.Email }
        };
        var dialog = await DialogService.ShowAsync<ResetPasswordDialog>("Reset password", parameters,
            new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true });
        if (await dialog.Result is { Canceled: false })
        {
            Snackbar.Add("Password reset.", Severity.Success);
            await LoadAsync();
        }
    }

    private async Task ToggleActiveAsync(UserListItemDto user)
    {
        var activate = !user.IsActive;
        if (!activate)
        {
            // IsActive is a record-keeping flag in this app — sign-in doesn't check it — so say so
            // rather than imply access is revoked.
            var confirmed = await DialogService.ShowMessageBoxAsync("Deactivate user",
                $"{user.FirstName} {user.LastName} will be marked inactive and moved to the deactivated list. "
                + "This doesn't block sign-in; reset their password to revoke access.",
                yesText: "Deactivate", cancelText: "Cancel");
            if (confirmed != true) return;
        }
        var (success, error) = await Api.SetActiveAsync(user.Id, activate);
        if (!success) { _error = error; return; }
        _error = null;
        Snackbar.Add(activate ? "User activated." : "User deactivated.", Severity.Success);
        await LoadAsync();
    }
}
