@page "/refund-reasons"
@attribute [Authorize]
@using Mercurius.Client.Pages.Dialogs
@inject RefundReasonsApiClient Api
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Refund Reasons</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <MudText Typo="Typo.h4">Refund Reasons</MudText>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreate">
        Add Reason
    </MudButton>
</div>

<MudPaper Class="pa-2" Elevation="2">
    <MudTable Items="@(_result?.Items ?? new())" Loading="@(_result is null)" Hover="true" Dense="true">
        <HeaderContent>
            <MudTh>Name</MudTh>
            <MudTh>Description</MudTh>
            <MudTh>Status</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Name">@context.Name</MudTd>
            <MudTd DataLabel="Description">@context.Description</MudTd>
            <MudTd DataLabel="Status">
                <MudChip T="string" Size="Size.Small" Color="@(context.IsActive ? Color.Success : Color.Default)">
                    @(context.IsActive ? "Active" : "Inactive")
                </MudChip>
            </MudTd>
            <MudTd>
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="() => OpenEdit(context)" />
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>No refund reasons yet.</MudText>
        </NoRecordsContent>
    </MudTable>
</MudPaper>

@code {
    private ListResultDto<RefundReasonDto>? _result;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync() => _result = await Api.GetAsync();

    private async Task OpenCreate()
    {
        var dialog = await DialogService.ShowAsync<RefundReasonDialog>("Add Refund Reason");
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            Snackbar.Add("Refund reason created.", Severity.Success);
            await LoadAsync();
        }
    }

    private async Task OpenEdit(RefundReasonDto reason)
    {
        var parameters = new DialogParameters<RefundReasonDialog> { { d => d.Existing, reason } };
        var dialog = await DialogService.ShowAsync<RefundReasonDialog>("Edit Refund Reason", parameters);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            Snackbar.Add("Refund reason updated.", Severity.Success);
            await LoadAsync();
        }
    }
}
