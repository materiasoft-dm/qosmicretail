@inject AdjustmentReasonsApiClient Api

<MudDialog>
    <DialogContent>
        <MudTextField @bind-Value="_name" Label="Name" Variant="Variant.Outlined" Class="mb-3" AutoFocus="true" />
        <MudTextField @bind-Value="_description" Label="Description" Variant="Variant.Outlined" Class="mb-3" />
        <MudSwitch @bind-Value="_isInbound" Color="Color.Primary" Label="Inbound (adds stock)" />
        <MudSwitch @bind-Value="_isActive" Color="Color.Primary" Label="Active" />
        @if (_error != null)
        {
            <MudAlert Severity="Severity.Error" Class="mt-2">@_error</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public AdjustmentReasonDto Existing { get; set; } = default!;

    private string _name = string.Empty;
    private string _description = string.Empty;
    private bool _isInbound;
    private bool _isActive;
    private string? _error;

    protected override void OnInitialized()
    {
        _name = Existing.Name;
        _description = Existing.Description ?? string.Empty;
        _isInbound = Existing.IsInbound;
        _isActive = Existing.IsActive;
    }

    private async Task Save()
    {
        if (string.IsNullOrWhiteSpace(_name)) { _error = "Name is required."; return; }
        var ok = await Api.UpdateAsync(Existing.Id, new UpdateAdjustmentReasonRequest
        {
            Name = _name, Description = _description, IsInbound = _isInbound, IsActive = _isActive
        });
        if (!ok) { _error = "Failed to save."; return; }
        MudDialog.Close(DialogResult.Ok(true));
    }

    private void Cancel() => MudDialog.Cancel();
}
