@page "/sell"
@attribute [Authorize]
@using Mercurius.Client.Pages.Dialogs
@inject ProductsApiClient ProductsApi
@inject ProductCategoriesApiClient CategoriesApi
@inject SalesApiClient SalesApi
@inject IJSRuntime JS
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject OfflineStoreService OfflineStore
@inject OfflineSyncService OfflineSync

<PageTitle>Sell</PageTitle>

@if (_usingOfflineCatalog || _pendingSaleCount > 0)
{
    <MudAlert Severity="@(_usingOfflineCatalog ? Severity.Warning : Severity.Info)" Class="mb-3" Dense="true">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
            <span>
                @if (_usingOfflineCatalog)
                {
                    <text>Offline — showing the last synced catalog. Sales made now will be saved on this device.</text>
                }
                @if (_pendingSaleCount > 0)
                {
                    <text> @_pendingSaleCount sale(s) waiting to sync.</text>
                }
            </span>
            @if (_pendingSaleCount > 0)
            {
                <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="SyncNow">Sync now</MudButton>
            }
        </div>
    </MudAlert>
}

<MudGrid>
    <MudItem xs="12" md="8">
        <div class="d-flex flex-wrap gap-2 align-items-center mb-3">
            <MudTextField T="string" Value="_search" ValueChanged="OnSearchChanged" Immediate="true" Placeholder="Search by name or SKU..." Variant="Variant.Outlined"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Style="max-width:280px" Margin="Margin.Dense" />
            <MudButtonGroup Variant="Variant.Filled" Size="Size.Small">
                <MudButton Color="@(_isGridView ? Color.Primary : Color.Default)" OnClick="@(() => SetViewMode(true))">Grid</MudButton>
                <MudButton Color="@(!_isGridView ? Color.Primary : Color.Default)" OnClick="@(() => SetViewMode(false))">List</MudButton>
            </MudButtonGroup>
        </div>

        <div class="d-flex flex-nowrap gap-2 mb-3 overflow-auto pb-2">
            <MudChip T="string" Color="@(_categoryId == 0 ? Color.Primary : Color.Default)" OnClick="@(() => SelectCategory(0))">All</MudChip>
            @foreach (var c in _categories)
            {
                <MudChip T="string" Color="@(_categoryId == c.Id ? Color.Primary : Color.Default)" OnClick="@(() => SelectCategory(c.Id))">@c.Name</MudChip>
            }
        </div>

        @if (_loading)
        {
            <MudText><em>Loading...</em></MudText>
        }
        else if (_products.Count == 0)
        {
            <MudText>No products found.</MudText>
        }
        else if (_isGridView)
        {
            <MudGrid>
                @foreach (var p in _products)
                {
                    var qtyInCart = CartQtyFor(p.Id);
                    <MudItem xs="6" md="4" lg="3">
                        <MudCard Class="h-100" Style="cursor:pointer; position:relative;" @onclick="() => AddToCart(p)">
                            @if (qtyInCart > 0)
                            {
                                <MudBadge Content="@qtyInCart" Color="Color.Primary" Overlap="true" Class="position-absolute" Style="top:8px; right:8px; z-index:1;" />
                            }
                            <MudCardContent>
                                <MudText Class="fw-bold text-truncate">@p.Name</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="text-truncate">@p.Category</MudText>
                                <MudText Color="Color.Primary" Class="fw-bold mt-1">@Money.Format(p.SalePrice)</MudText>
                                <MudText Typo="Typo.caption" Color="@(p.Stock <= p.LowStockCount ? Color.Error : Color.Success)">@p.Stock.ToString("0") in stock</MudText>
                            </MudCardContent>
                        </MudCard>
                    </MudItem>
                }
            </MudGrid>
        }
        else
        {
            @foreach (var p in _products)
            {
                var qtyInCart = CartQtyFor(p.Id);
                <div class="d-flex align-items-center justify-content-between border-bottom py-2" style="cursor:pointer" @onclick="() => AddToCart(p)">
                    <div class="flex-grow-1">
                        <MudText Class="fw-bold">@p.Name @(qtyInCart > 0 ? $"({qtyInCart} in cart)" : "")</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@p.Category</MudText>
                    </div>
                    <MudText Typo="Typo.caption" Color="@(p.Stock <= p.LowStockCount ? Color.Error : Color.Success)" Class="me-4" Style="min-width:80px;">@p.Stock.ToString("0") in stock</MudText>
                    <MudText Color="Color.Primary" Class="fw-bold" Style="min-width:80px;text-align:right;">@Money.Format(p.SalePrice)</MudText>
                </div>
            }
        }
    </MudItem>

    <MudItem xs="12" md="4">
        <MudPaper Class="pa-4" Elevation="2" Style="position:sticky; top:20px;">
            <MudSelect T="int" @bind-Value="_customerId" Label="Customer" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3">
                <MudSelectItem T="int" Value="0">-- Optional --</MudSelectItem>
                @foreach (var c in _customers)
                {
                    <MudSelectItem T="int" Value="@c.Id">@c.Name</MudSelectItem>
                }
            </MudSelect>
            <MudTextField @bind-Value="_notes" Label="Notes" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" />
            <MudDivider Class="mb-3" />
            <div class="d-flex justify-content-between align-items-center mb-2">
                <MudText Typo="Typo.h6">Ticket</MudText>
                <MudChip T="string" Size="Size.Small">@CartTotalItems() items</MudChip>
            </div>

            @if (_cart.Count == 0)
            {
                <div class="text-center py-5">
                    <MudText Color="Color.Secondary">Ticket is empty</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Tap a product to add it</MudText>
                </div>
            }
            else
            {
                <div style="max-height:45vh; overflow-y:auto;">
                    @foreach (var line in _cart)
                    {
                        <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                            <div class="flex-grow-1 me-2">
                                <MudText Class="fw-bold text-truncate">@line.Name</MudText>
                                <div class="d-flex align-items-center gap-2 mt-1">
                                    <MudIconButton Icon="@Icons.Material.Filled.Remove" Size="Size.Small" Variant="Variant.Filled" OnClick="@(() => Decrement(line.ProductId))" />
                                    <MudText>@line.Quantity</MudText>
                                    <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small" Variant="Variant.Filled" OnClick="@(() => Increment(line.ProductId))" />
                                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="ms-2">@Money.Format(line.Price) ea</MudText>
                                </div>
                            </div>
                            <div class="text-end">
                                <MudText Class="fw-bold">@Money.Format(line.Price * line.Quantity)</MudText>
                                <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Color="Color.Error" OnClick="@(() => RemoveLine(line.ProductId))" />
                            </div>
                        </div>
                    }
                </div>
            }

            <MudDivider Class="my-3" />
            <div class="d-flex justify-content-between align-items-center mb-3">
                <MudText Class="fw-bold">Total</MudText>
                <MudText Typo="Typo.h5" Color="Color.Primary" Class="fw-bold">@Money.Format(CartTotal())</MudText>
            </div>
            <div class="d-flex gap-2">
                <MudButton Variant="Variant.Outlined" FullWidth="true" OnClick="ClearCart">Clear</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Disabled="@(_cart.Count == 0)" OnClick="OpenPayment">
                    @(_cart.Count == 0 ? "Charge" : $"Charge {Money.Format(CartTotal())}")
                </MudButton>
            </div>
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private List<ProductListItemDto> _products = new();
    private List<ProductCategoryDto> _categories = new();
    private List<CustomerOptionDto> _customers = new();
    private bool _loading = true;
    private string _search = string.Empty;
    private int _categoryId;
    private bool _isGridView = true;
    private CancellationTokenSource? _debounce;

    private class CartLine { public int ProductId; public string Name = ""; public decimal Price; public int Quantity; public decimal Stock; public decimal LowStockCount; }
    private List<CartLine> _cart = new();
    private int _customerId;
    private string _notes = string.Empty;

    private bool _usingOfflineCatalog;
    private int _pendingSaleCount;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var stored = await JS.InvokeAsync<string?>("localStorage.getItem", "sell_view_mode");
            _isGridView = stored != "list";
        }
        catch { }

        try
        {
            _categories = (await CategoriesApi.GetAsync()).Items;
            _customers = await SalesApi.GetCustomersAsync(null);
        }
        catch
        {
            // Categories/customers are conveniences (filtering, optional tagging) — selling still
            // works without them, so don't block the page on a failed fetch while offline.
        }
        await LoadProductsAsync();
        await RefreshPendingCountAsync();

        // Best-effort, non-blocking: refresh the offline catalog and flush anything queued from
        // a previous offline session, in case connectivity is back.
        _ = BackgroundSyncAsync();
    }

    private async Task BackgroundSyncAsync()
    {
        var synced = await OfflineSync.PushPendingSalesAsync();
        await OfflineSync.PullProductCatalogAsync();
        await RefreshPendingCountAsync();
        if (synced > 0)
        {
            Snackbar.Add($"Synced {synced} offline sale(s).", Severity.Success);
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task RefreshPendingCountAsync()
    {
        _pendingSaleCount = (await OfflineStore.GetPendingSalesAsync()).Count;
    }

    private async Task SyncNow()
    {
        var synced = await OfflineSync.PushPendingSalesAsync();
        await RefreshPendingCountAsync();
        Snackbar.Add(synced > 0 ? $"Synced {synced} offline sale(s)." : "Still offline — nothing synced.", synced > 0 ? Severity.Success : Severity.Warning);
    }

    private async Task LoadProductsAsync()
    {
        _loading = true;
        try
        {
            var result = await ProductsApi.GetAsync(_search, 1, 100, _categoryId);
            _products = result.Items;
            _usingOfflineCatalog = false;
        }
        catch
        {
            // No connection — search the last-synced catalog cached in IndexedDB instead.
            var offline = await OfflineStore.GetAllProductsAsync();
            IEnumerable<OfflineProductDto> filtered = offline;
            if (_categoryId > 0) filtered = filtered.Where(p => p.CategoryId == _categoryId);
            if (!string.IsNullOrWhiteSpace(_search))
            {
                var s = _search.Trim();
                filtered = filtered.Where(p => p.Name.Contains(s, StringComparison.OrdinalIgnoreCase) || p.ProductCode.Contains(s, StringComparison.OrdinalIgnoreCase));
            }
            _products = filtered.OrderBy(p => p.Name).Take(100)
                .Select(p => new ProductListItemDto { Id = p.Id, ProductCode = p.ProductCode, Name = p.Name, Category = p.Category, Stock = p.Stock, SalePrice = p.SalePrice, LowStockCount = p.LowStockCount, IsActive = true })
                .ToList();
            _usingOfflineCatalog = true;
        }
        _loading = false;
    }

    private async Task OnSearchChanged(string value)
    {
        _search = value;
        _debounce?.Cancel();
        _debounce = new CancellationTokenSource();
        var token = _debounce.Token;
        try { await Task.Delay(300, token); await LoadProductsAsync(); StateHasChanged(); }
        catch (TaskCanceledException) { }
    }

    private void SelectCategory(int id) { _categoryId = id; _ = LoadProductsAsync(); }

    private async void SetViewMode(bool grid)
    {
        _isGridView = grid;
        try { await JS.InvokeVoidAsync("localStorage.setItem", "sell_view_mode", grid ? "grid" : "list"); } catch { }
        StateHasChanged();
    }

    private int CartQtyFor(int productId) => _cart.FirstOrDefault(l => l.ProductId == productId)?.Quantity ?? 0;
    private int CartTotalItems() => _cart.Sum(l => l.Quantity);
    private decimal CartTotal() => _cart.Sum(l => l.Price * l.Quantity);

    private void AddToCart(ProductListItemDto p)
    {
        var existing = _cart.FirstOrDefault(l => l.ProductId == p.Id);
        if (existing != null) existing.Quantity++;
        else _cart.Add(new CartLine { ProductId = p.Id, Name = p.Name, Price = p.SalePrice ?? 0, Quantity = 1, Stock = p.Stock, LowStockCount = p.LowStockCount });
    }

    private void Increment(int productId) { var l = _cart.First(x => x.ProductId == productId); l.Quantity++; }
    private void Decrement(int productId)
    {
        var idx = _cart.FindIndex(x => x.ProductId == productId);
        if (idx < 0) return;
        if (_cart[idx].Quantity > 1) _cart[idx].Quantity--; else _cart.RemoveAt(idx);
    }
    private void RemoveLine(int productId) => _cart.RemoveAll(l => l.ProductId == productId);
    private void ClearCart() => _cart.Clear();

    private async Task OpenPayment()
    {
        var parameters = new DialogParameters<PaymentDialog>
        {
            { d => d.Total, CartTotal() },
            { d => d.CustomerId, _customerId },
            { d => d.Notes, _notes },
            { d => d.Items, _cart.Select(l => new CartLineRequest { ProductId = l.ProductId, Quantity = l.Quantity }).ToList() }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true };
        var dialog = await DialogService.ShowAsync<PaymentDialog>("Payment", parameters, options);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            _cart.Clear();
            _notes = string.Empty;
            var outcome = result.Data as SaleOutcome;
            if (outcome is { SavedOffline: true })
            {
                Snackbar.Add("Saved offline — will sync when back online.", Severity.Warning);
                await RefreshPendingCountAsync();
            }
            else
            {
                Snackbar.Add("Sale complete.", Severity.Success);
            }
            await LoadProductsAsync();
        }
    }
}
