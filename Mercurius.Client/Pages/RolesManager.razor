@page "/roles-manager"
@attribute [Authorize(Policy = ModuleRegistry.Pages.ADMIN_ROLES_MANAGEMENT)]
@inject RolesApiClient Api
@inject ISnackbar Snackbar
@inject AuthenticationStateProvider Auth

<PageTitle>Roles Manager</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <MudText Typo="Typo.h4">Roles</MudText>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="ShowCreate">
        New Role
    </MudButton>
</div>

@if (_showForm)
{
    <MudPaper Class="pa-4 mb-4" Elevation="2">
        <MudTextField @bind-Value="_roleName" Label="Role name" Variant="Variant.Outlined" Style="max-width:300px;" Class="mb-3"
                      Disabled="@(_editing != null && IsBuiltIn(_editing))" Immediate="true"
                      HelperText="@(_editing != null && IsBuiltIn(_editing) ? "Built-in roles keep their name" : null)" />
        @if (_editing != null)
        {
            <MudText Typo="Typo.body2" Class="mb-3">Changes reach people with this role the next time they sign in.</MudText>
        }

        <div class="perm-scroll">
            <div class="perm-columns">
                @foreach (var root in _tree)
                {
                    <div class="perm-root">
                        <PermissionNodeView Node="root" Selected="_selected" Changed="@(() => StateHasChanged())" />
                    </div>
                }
            </div>
        </div>

        @if (_error != null)
        {
            <MudAlert Severity="Severity.Error" Class="mt-2">@_error</MudAlert>
        }
        <div class="mt-3">
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit">Save</MudButton>
            <MudButton OnClick="@(() => _showForm = false)">Cancel</MudButton>
        </div>
    </MudPaper>
}

<MudPaper Class="pa-2" Elevation="2">
    <MudTable Items="@(_result?.Items ?? new())" Loading="@(_result is null)" Hover="true" Dense="true">
        <HeaderContent>
            <MudTh>Name</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Name">
                <div>@context.Name</div>
                @if (LockedReason(context) is { } reason)
                {
                    <MudText Typo="Typo.caption">@reason</MudText>
                }
            </MudTd>
            <MudTd Style="text-align:right">
                @if (LockedReason(context) == null)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" aria-label="Edit permissions" OnClick="@(() => ShowEdit(context))" />
                }
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" aria-label="Delete role" OnClick="@(() => Delete(context.Id))" />
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>No roles yet.</MudText>
        </NoRecordsContent>
    </MudTable>
</MudPaper>

@code {
    private ListResultDto<RoleDto>? _result;
    private IReadOnlyList<PermissionNode> _tree = Array.Empty<PermissionNode>();
    private bool _isPlatformAdmin;
    // Includes any database permissions the role holds that this caller isn't shown, so saving
    // sends them back unchanged.
    private HashSet<string> _selected = new();
    private bool _showForm;
    private RoleDto? _editing;
    private string _roleName = string.Empty;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        if (!RendererInfo.IsInteractive) return; // prerendering: show the loading state; the browser loads the data
        var auth = await Auth.GetAuthenticationStateAsync();
        _isPlatformAdmin = auth.User.IsPlatformAdmin();
        _tree = PermissionTree.ForCaller(_isPlatformAdmin);
        await LoadAsync();
    }

    private async Task LoadAsync() => _result = await Api.GetAsync();

    // Startup gives Administrator every permission again, so editing it wouldn't stick.
    private string? LockedReason(RoleDto role)
    {
        if (role.Name == ModuleRegistry.AdministratorRole) return "Always has every permission";
        if (role.Name == ModuleRegistry.DatabaseAdministratorRole && !_isPlatformAdmin) return "Only a platform admin can change this role";
        return null;
    }

    private static bool IsBuiltIn(RoleDto role) =>
        role.Name == ModuleRegistry.DatabaseAdministratorRole || ModuleRegistry.FixedRoles.Contains(role.Name);

    private void ShowCreate()
    {
        _editing = null;
        _error = null;
        _roleName = string.Empty;
        _selected = new();
        _showForm = true;
    }

    private async Task ShowEdit(RoleDto role)
    {
        var detail = await Api.GetDetailAsync(role.Id);
        if (detail == null)
        {
            Snackbar.Add("That role no longer exists.", Severity.Warning);
            await LoadAsync();
            return;
        }
        _editing = role;
        _error = null;
        _roleName = role.Name;
        _selected = detail.SelectedPages.ToHashSet();
        _showForm = true;
    }

    private async Task Submit()
    {
        if (string.IsNullOrWhiteSpace(_roleName)) { _error = "Role name is required."; return; }
        var (success, error) = _editing != null
            ? await Api.UpdateAsync(_editing.Id, _roleName, _selected.ToList())
            : await Api.CreateAsync(new CreateRoleRequest { Name = _roleName, Pages = _selected.ToList() });
        if (!success) { _error = error; return; }
        Snackbar.Add(_editing != null ? "Role updated." : "Role created.", Severity.Success);
        _showForm = false;
        await LoadAsync();
    }

    private async Task Delete(string id)
    {
        await Api.DeleteAsync(id);
        Snackbar.Add("Role deleted.", Severity.Success);
        await LoadAsync();
    }
}
