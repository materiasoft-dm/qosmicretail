@page "/roles-manager"
@attribute [Authorize]
@inject RolesApiClient Api
@inject ISnackbar Snackbar

<PageTitle>Roles Manager</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <MudText Typo="Typo.h4">Roles</MudText>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="ShowCreate">
        New Role
    </MudButton>
</div>

@if (_showCreate)
{
    <MudPaper Class="pa-4 mb-4" Elevation="2">
        <MudTextField @bind-Value="_roleName" Label="Role name" Variant="Variant.Outlined" Style="max-width:300px;" Class="mb-3" />
        <MudGrid Style="max-height: 300px; overflow-y: auto;">
            @foreach (var module in _modules)
            {
                <MudItem xs="12" md="4">
                    <MudCheckBox T="bool" Value="@_selectedPages.Contains(module)" ValueChanged="@((bool v) => TogglePage(module, v))" Label="@module" Color="Color.Primary" />
                </MudItem>
            }
        </MudGrid>
        @if (_error != null)
        {
            <MudAlert Severity="Severity.Error" Class="mt-2">@_error</MudAlert>
        }
        <div class="mt-3">
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit">Save</MudButton>
            <MudButton OnClick="@(() => _showCreate = false)">Cancel</MudButton>
        </div>
    </MudPaper>
}

<MudPaper Class="pa-2" Elevation="2">
    <MudTable Items="@(_result?.Items ?? new())" Loading="@(_result is null)" Hover="true" Dense="true">
        <HeaderContent>
            <MudTh>Name</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Name">@context.Name</MudTd>
            <MudTd>
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => Delete(context.Id))" />
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>No roles yet.</MudText>
        </NoRecordsContent>
    </MudTable>
</MudPaper>

@code {
    private ListResultDto<RoleDto>? _result;
    private List<string> _modules = new();
    private HashSet<string> _selectedPages = new();
    private bool _showCreate;
    private string _roleName = string.Empty;
    private string? _error;

    protected override async Task OnInitializedAsync() => await LoadAsync();
    private async Task LoadAsync() => _result = await Api.GetAsync();

    private async void ShowCreate()
    {
        _showCreate = true; _error = null;
        _roleName = string.Empty; _selectedPages = new();
        _modules = await Api.GetModulesAsync();
        StateHasChanged();
    }

    private void TogglePage(string module, bool isChecked)
    {
        if (isChecked) _selectedPages.Add(module); else _selectedPages.Remove(module);
    }

    private async Task Submit()
    {
        if (string.IsNullOrWhiteSpace(_roleName)) { _error = "Role name is required."; return; }
        var (success, error) = await Api.CreateAsync(new CreateRoleRequest { Name = _roleName, Pages = _selectedPages.ToList() });
        if (!success) { _error = error; return; }
        _showCreate = false;
        Snackbar.Add("Role created.", Severity.Success);
        await LoadAsync();
    }

    private async Task Delete(string id)
    {
        await Api.DeleteAsync(id);
        Snackbar.Add("Role deleted.", Severity.Success);
        await LoadAsync();
    }
}
