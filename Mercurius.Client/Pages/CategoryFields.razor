@page "/category-fields"
@attribute [Authorize(Policy = ModuleRegistry.Pages.CONFIG_CATEGORY_FIELDS)]
@using Mercurius.Client.Pages.Dialogs
@inject CategoryFieldsApiClient Api
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Category Custom Fields</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <MudText Typo="Typo.h4">Category Custom Fields</MudText>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => OpenAsync(null))">
        Add Field
    </MudButton>
</div>

<MudPaper Class="pa-2" Elevation="2">
    <MudTable Items="@(_result?.Items ?? new())" Loading="@(_result is null)" Hover="true" Dense="true" RowsPerPage="25">
        <HeaderContent>
            <MudTh>Category</MudTh>
            <MudTh>Field name</MudTh>
            <MudTh>Label</MudTh>
            <MudTh>Type</MudTh>
            <MudTh>Order</MudTh>
            <MudTh>Required</MudTh>
            <MudTh>Status</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Category">@context.CategoryName</MudTd>
            <MudTd DataLabel="Field name">@context.FieldName</MudTd>
            <MudTd DataLabel="Label">@context.DisplayLabel</MudTd>
            <MudTd DataLabel="Type">@context.FieldType</MudTd>
            <MudTd DataLabel="Order">@context.SortOrder</MudTd>
            <MudTd DataLabel="Required">@(context.IsRequired ? "Yes" : "No")</MudTd>
            <MudTd DataLabel="Status">
                <MudChip T="string" Size="Size.Small" Color="@(context.IsActive ? Color.Success : Color.Default)">
                    @(context.IsActive ? "Active" : "Inactive")
                </MudChip>
            </MudTd>
            <MudTd>
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" aria-label="Edit" OnClick="() => OpenAsync(context)" />
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>No custom fields yet.</MudText>
        </NoRecordsContent>
        <PagerContent>
            <MudTablePager PageSizeOptions="@(new[] { 25, 50, 100 })" />
        </PagerContent>
    </MudTable>
</MudPaper>

@code {
    private ListResultDto<CategoryFieldDto>? _result;
    private List<ProductCategoryDto> _categories = new();

    protected override async Task OnInitializedAsync()
    {
        if (!RendererInfo.IsInteractive) return; // prerendering: show the loading state; the browser loads the data
        await LoadAsync();
        _categories = await Api.GetCategoriesAsync();
    }

    private async Task LoadAsync() => _result = await Api.GetAsync();

    // Null adds a field; otherwise edits it.
    private async Task OpenAsync(CategoryFieldDto? field)
    {
        var parameters = new DialogParameters<CategoryFieldDialog>
        {
            { d => d.Existing, field },
            { d => d.Categories, _categories },
            { d => d.Fields, _result?.Items ?? new() }
        };
        var dialog = await DialogService.ShowAsync<CategoryFieldDialog>(field == null ? "Add Custom Field" : "Edit Custom Field", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        if (await dialog.Result is { Canceled: false })
        {
            Snackbar.Add(field == null ? "Custom field created." : "Custom field updated.", Severity.Success);
            await LoadAsync();
        }
    }
}
