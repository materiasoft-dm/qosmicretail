@page "/category-fields"
@attribute [Authorize]
@inject CategoryFieldsApiClient Api
@inject ISnackbar Snackbar

<PageTitle>Category Custom Fields</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <MudText Typo="Typo.h4">Category Custom Fields</MudText>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="ShowCreate">
        Add Field
    </MudButton>
</div>

@if (_showCreate)
{
    <MudPaper Class="pa-4 mb-4" Elevation="2">
        <MudGrid>
            <MudItem xs="12" md="3">
                <MudSelect T="int" @bind-Value="_categoryId" Label="Category" Variant="Variant.Outlined">
                    <MudSelectItem T="int" Value="0">-- Category --</MudSelectItem>
                    @foreach (var c in _categories)
                    {
                        <MudSelectItem T="int" Value="@c.Id">@c.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="3"><MudTextField @bind-Value="_fieldName" Label="Field name (code)" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="3"><MudTextField @bind-Value="_displayLabel" Label="Display label" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="3">
                <MudSelect T="string" @bind-Value="_fieldType" Label="Field type" Variant="Variant.Outlined">
                    <MudSelectItem T="string" Value="@("text")">Text</MudSelectItem>
                    <MudSelectItem T="string" Value="@("number")">Number</MudSelectItem>
                    <MudSelectItem T="string" Value="@("select")">Select</MudSelectItem>
                    <MudSelectItem T="string" Value="@("checkbox")">Checkbox</MudSelectItem>
                    <MudSelectItem T="string" Value="@("date")">Date</MudSelectItem>
                    <MudSelectItem T="string" Value="@("textarea")">Textarea</MudSelectItem>
                </MudSelect>
            </MudItem>
        </MudGrid>
        @if (_error != null)
        {
            <MudAlert Severity="Severity.Error" Class="mt-3">@_error</MudAlert>
        }
        <div class="mt-3">
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit">Save</MudButton>
            <MudButton OnClick="@(() => _showCreate = false)">Cancel</MudButton>
        </div>
    </MudPaper>
}

<MudPaper Class="pa-2" Elevation="2">
    <MudTable Items="@(_result?.Items ?? new())" Loading="@(_result is null)" Hover="true" Dense="true">
        <HeaderContent>
            <MudTh>Category</MudTh>
            <MudTh>Field name</MudTh>
            <MudTh>Label</MudTh>
            <MudTh>Type</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Category">@context.CategoryName</MudTd>
            <MudTd DataLabel="Field name">@context.FieldName</MudTd>
            <MudTd DataLabel="Label">@context.DisplayLabel</MudTd>
            <MudTd DataLabel="Type">@context.FieldType</MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>No custom fields yet.</MudText>
        </NoRecordsContent>
    </MudTable>
</MudPaper>

@code {
    private ListResultDto<CategoryFieldDto>? _result;
    private List<ProductCategoryDto> _categories = new();
    private bool _showCreate;
    private int _categoryId;
    private string _fieldName = string.Empty, _displayLabel = string.Empty, _fieldType = "text";
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        _categories = await Api.GetCategoriesAsync();
    }

    private async Task LoadAsync() => _result = await Api.GetAsync();

    private void ShowCreate()
    {
        _showCreate = true; _error = null;
        _categoryId = 0; _fieldName = _displayLabel = string.Empty; _fieldType = "text";
    }

    private async Task Submit()
    {
        if (_categoryId <= 0 || string.IsNullOrWhiteSpace(_fieldName))
        {
            _error = "Category and field name are required.";
            return;
        }
        var (success, error) = await Api.CreateAsync(new CreateCategoryFieldRequest
        {
            CategoryId = _categoryId,
            FieldName = _fieldName,
            DisplayLabel = string.IsNullOrWhiteSpace(_displayLabel) ? _fieldName : _displayLabel,
            FieldType = _fieldType
        });
        if (!success) { _error = error; return; }
        _showCreate = false;
        Snackbar.Add("Custom field created.", Severity.Success);
        await LoadAsync();
    }
}
