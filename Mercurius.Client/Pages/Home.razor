@page "/"
@attribute [Authorize]
@inject DashboardApiClient Api

<PageTitle>Dashboard</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Dashboard</MudText>

@if (_d is null)
{
    <MudText><em>Loading...</em></MudText>
}
else
{
    <MudGrid Class="mb-4">
        <MudItem xs="12" md="3">
            <MudPaper Class="pa-4" Elevation="2">
                <MudText Color="Color.Secondary">Today's Sales</MudText>
                <MudText Typo="Typo.h5" Class="fw-bold">@Money.Format(_d.TodaySales)</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="3">
            <MudPaper Class="pa-4" Elevation="2">
                <MudText Color="Color.Secondary">Today's Profit</MudText>
                <MudText Typo="Typo.h5" Class="fw-bold">@Money.Format(_d.TodayProfit)</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="3">
            <MudPaper Class="pa-4" Elevation="2">
                <MudText Color="Color.Secondary">This Month</MudText>
                <MudText Typo="Typo.h5" Class="fw-bold">@Money.Format(_d.ThisMonthSales)</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="3">
            <MudPaper Class="pa-4" Elevation="2">
                <MudText Color="Color.Secondary">Last Month</MudText>
                <MudText Typo="Typo.h5" Class="fw-bold">@Money.Format(_d.PreviousMonthSales)</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudGrid Class="mb-4">
        <MudItem xs="12" md="3">
            <MudPaper Class="pa-4" Elevation="2">
                <MudText Typo="Typo.h4" Class="fw-bold">@_d.DailySalesCount</MudText>
                <MudText Color="Color.Secondary">Daily Sales</MudText>
                <MudText Typo="Typo.caption">@DailySalesPct% of @_d.DailySalesTarget</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="3">
            <MudPaper Class="pa-4" Elevation="2">
                <MudText Typo="Typo.h4" Class="fw-bold">@_d.PreviousMonthSalesCount</MudText>
                <MudText Color="Color.Secondary">Previous Month Sales</MudText>
                <MudText Typo="Typo.caption">@PrevMonthPct% of @_d.PreviousMonthSalesTarget</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="3">
            <MudPaper Class="pa-4" Elevation="2">
                <MudText Typo="Typo.h4" Class="fw-bold">@_d.NewCustomersThisMonth</MudText>
                <MudText Color="Color.Secondary">New Customers This Month</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="3">
            <MudPaper Class="pa-4" Elevation="2">
                <MudText Typo="Typo.h4" Class="fw-bold">@_d.ItemsSoldTodayTotal</MudText>
                <MudText Color="Color.Secondary">Total Items Sold Today</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudGrid>
        <MudItem xs="12" md="6">
            <MudPaper Elevation="2">
                <MudText Typo="Typo.subtitle1" Class="pa-3 mb-0"><strong>Stock Report</strong> — Total @_d.TotalStockItems items</MudText>
                <MudTable Items="_d.LowestStockItems" Dense="true" Hover="true">
                    <HeaderContent>
                        <MudTh>SKU</MudTh>
                        <MudTh>Item</MudTh>
                        <MudTh Style="text-align:right;">Qty</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="SKU">@context.ProductCode</MudTd>
                        <MudTd DataLabel="Item">@context.Name</MudTd>
                        <MudTd DataLabel="Qty" Style="text-align:right;">
                            <MudText Color="@(context.CurrentStock <= context.LowStockCount ? Color.Error : Color.Default)">@context.CurrentStock</MudText>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="6">
            <MudPaper Elevation="2">
                <MudText Typo="Typo.subtitle1" Class="pa-3 mb-0"><strong>Expiry Alerts</strong> — @_d.ExpiredCount expired, @_d.ExpiringWithin30Days within 30 days, @_d.ExpiringWithin90Days within 90 days</MudText>
                @if (_d.ExpiringItems.Count == 0)
                {
                    <MudText Class="pa-3" Color="Color.Secondary">No items expiring within 90 days.</MudText>
                }
                else
                {
                    <MudTable Items="_d.ExpiringItems" Dense="true" Hover="true">
                        <HeaderContent>
                            <MudTh>Product</MudTh>
                            <MudTh>Batch</MudTh>
                            <MudTh>Expiry</MudTh>
                            <MudTh Style="text-align:right;">Qty</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Product">@context.ProductName</MudTd>
                            <MudTd DataLabel="Batch">@context.BatchNumber</MudTd>
                            <MudTd DataLabel="Expiry">@context.ExpiryDate.ToString("yyyy-MM-dd")</MudTd>
                            <MudTd DataLabel="Qty" Style="text-align:right;">@context.RemainingQuantity</MudTd>
                        </RowTemplate>
                    </MudTable>
                }
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="6">
            <MudPaper Elevation="2">
                <MudText Typo="Typo.subtitle1" Class="pa-3 mb-0"><strong>Items Sold Today</strong></MudText>
                @if (_d.ItemsSoldToday.Count == 0)
                {
                    <MudText Class="pa-3" Color="Color.Secondary">No items sold yet today.</MudText>
                }
                else
                {
                    <MudTable Items="_d.ItemsSoldToday" Dense="true" Hover="true">
                        <HeaderContent>
                            <MudTh>SKU</MudTh>
                            <MudTh>Item</MudTh>
                            <MudTh Style="text-align:right;">Qty</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="SKU">@context.ProductCode</MudTd>
                            <MudTd DataLabel="Item">@context.ProductName</MudTd>
                            <MudTd DataLabel="Qty" Style="text-align:right;">@context.Quantity</MudTd>
                        </RowTemplate>
                    </MudTable>
                }
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@code {
    private DashboardDto? _d;
    private string DailySalesPct => _d == null || _d.DailySalesTarget == 0 ? "0" : Math.Round(100m * _d.DailySalesCount / _d.DailySalesTarget, 2).ToString();
    private string PrevMonthPct => _d == null || _d.PreviousMonthSalesTarget == 0 ? "0" : Math.Round(100m * _d.PreviousMonthSalesCount / _d.PreviousMonthSalesTarget, 2).ToString();

    protected override async Task OnInitializedAsync() => _d = await Api.GetAsync();
}
