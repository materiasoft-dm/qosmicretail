@page "/locations"
@attribute [Authorize]
@inject LocationsApiClient Api

<PageTitle>Locations</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Locations</h1>
    <button class="btn btn-primary" @onclick="ShowCreate">Add Location</button>
</div>

@if (_showCreate)
{
    <div class="card mb-3">
        <div class="card-body">
            <div class="row g-2">
                <div class="col-md-4"><input class="form-control" placeholder="Name" @bind="_name" /></div>
                <div class="col-md-4"><input class="form-control" placeholder="Mobile phone" @bind="_mobile" /></div>
            </div>
            @if (_error != null) { <p class="text-danger mt-2 mb-0">@_error</p> }
            <div class="mt-3">
                <button class="btn btn-primary" @onclick="Submit">Save</button>
                <button class="btn btn-light" @onclick="() => _showCreate = false">Cancel</button>
            </div>
        </div>
    </div>
}

@if (_result is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <table class="table table-striped">
        <thead><tr><th>Name</th><th>Mobile</th></tr></thead>
        <tbody>
            @foreach (var l in _result.Items)
            {
                <tr><td>@l.Name</td><td>@l.MobilePhone</td></tr>
            }
        </tbody>
    </table>
}

@code {
    private ListResultDto<LocationDto>? _result;
    private bool _showCreate;
    private string _name = string.Empty, _mobile = string.Empty;
    private string? _error;

    protected override async Task OnInitializedAsync() => await LoadAsync();
    private async Task LoadAsync() => _result = await Api.GetAsync();

    private void ShowCreate() { _showCreate = true; _error = null; _name = _mobile = string.Empty; }

    private async Task Submit()
    {
        if (string.IsNullOrWhiteSpace(_name)) { _error = "Name is required."; return; }
        var created = await Api.CreateAsync(new CreateLocationRequest { Name = _name, MobilePhone = _mobile });
        if (created == null) { _error = "Failed to create."; return; }
        _showCreate = false;
        await LoadAsync();
    }
}
