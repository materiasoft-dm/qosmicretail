@page "/locations"
@attribute [Authorize(Policy = ModuleRegistry.Pages.CONFIG_LOCATIONS)]
@using Mercurius.Client.Pages.Dialogs
@inject LocationsApiClient Api
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Locations</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <MudText Typo="Typo.h4">Locations</MudText>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => OpenAsync(null))">
        Add Location
    </MudButton>
</div>

<MudPaper Class="pa-2" Elevation="2">
    <MudTable Items="@(_result?.Items ?? new())" Loading="@(_result is null)" Hover="true" Dense="true" RowsPerPage="25">
        <HeaderContent>
            <MudTh>Name</MudTh>
            <MudTh>City / town</MudTh>
            <MudTh>Mobile</MudTh>
            <MudTh>Daily target</MudTh>
            <MudTh>Monthly target</MudTh>
            <MudTh>Status</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Name">@context.Name</MudTd>
            <MudTd DataLabel="City / town">@context.CityTown</MudTd>
            <MudTd DataLabel="Mobile">@context.MobilePhone</MudTd>
            <MudTd DataLabel="Daily target">@(context.DailySalesTarget?.ToString() ?? "—")</MudTd>
            <MudTd DataLabel="Monthly target">@(context.MonthlyTargetSalesCount is > 0 ? context.MonthlyTargetSalesCount.Value.ToString("0.##") : "—")</MudTd>
            <MudTd DataLabel="Status">
                <MudChip T="string" Size="Size.Small" Color="@(context.IsActive ? Color.Success : Color.Default)">
                    @(context.IsActive ? "Active" : "Inactive")
                </MudChip>
            </MudTd>
            <MudTd>
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" aria-label="Edit" OnClick="() => OpenAsync(context)" />
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>No locations yet.</MudText>
        </NoRecordsContent>
        <PagerContent>
            <MudTablePager PageSizeOptions="@(new[] { 25, 50, 100 })" />
        </PagerContent>
    </MudTable>
</MudPaper>

@code {
    private ListResultDto<LocationDto>? _result;

    protected override async Task OnInitializedAsync()
    {
        if (!RendererInfo.IsInteractive) return; // prerendering: show the loading state; the browser loads the data
        await LoadAsync();
    }

    private async Task LoadAsync() => _result = await Api.GetAsync();

    // Null adds a branch; otherwise edits it.
    private async Task OpenAsync(LocationDto? location)
    {
        var parameters = new DialogParameters<LocationDialog> { { d => d.Existing, location } };
        var dialog = await DialogService.ShowAsync<LocationDialog>(location == null ? "Add Location" : "Edit Location", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        if (await dialog.Result is { Canceled: false })
        {
            Snackbar.Add(location == null ? "Location created." : "Location updated.", Severity.Success);
            await LoadAsync();
        }
    }
}
