@page "/customers"
@attribute [Authorize]
@inject CustomersApiClient Api
@inject ISnackbar Snackbar

<PageTitle>Customers</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <MudText Typo="Typo.h4">Customers</MudText>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="ShowCreateForm">
        Add Customer
    </MudButton>
</div>

<MudTextField T="string" Value="_search" ValueChanged="OnSearchChanged" Label="Search customers..." Variant="Variant.Outlined"
              Immediate="true" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Class="mb-4" Style="max-width:320px;" />

@if (_showCreate)
{
    <MudPaper Class="pa-4 mb-4" Elevation="2">
        <MudGrid>
            <MudItem xs="12" md="3"><MudTextField @bind-Value="_newFirstName" Label="First name" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="3"><MudTextField @bind-Value="_newLastName" Label="Last name" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="3"><MudTextField @bind-Value="_newContactNumber" Label="Contact number" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="3"><MudTextField @bind-Value="_newEmail" Label="Email" Variant="Variant.Outlined" /></MudItem>
        </MudGrid>
        @if (!string.IsNullOrEmpty(_createError))
        {
            <MudAlert Severity="Severity.Error" Class="mt-3">@_createError</MudAlert>
        }
        <div class="mt-3">
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitCreate">Save</MudButton>
            <MudButton OnClick="@(() => _showCreate = false)">Cancel</MudButton>
        </div>
    </MudPaper>
}

<MudPaper Class="pa-2" Elevation="2">
    <MudTable Items="@(_result?.Items ?? new())" Loading="_loading" Hover="true" Dense="true">
        <HeaderContent>
            <MudTh>First name</MudTh>
            <MudTh>Last name</MudTh>
            <MudTh>Contact number</MudTh>
            <MudTh>Email</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="First name">@context.FirstName</MudTd>
            <MudTd DataLabel="Last name">@context.LastName</MudTd>
            <MudTd DataLabel="Contact number">@context.ContactNumber</MudTd>
            <MudTd DataLabel="Email">@context.EmailAddress</MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>No customers found.</MudText>
        </NoRecordsContent>
    </MudTable>
    @if (_result is not null && _result.Items.Count > 0)
    {
        <MudText Typo="Typo.caption" Class="pa-2 d-block">Showing @_result.Items.Count of @_result.Total</MudText>
    }
</MudPaper>

@code {
    private CustomerListResultDto? _result;
    private bool _loading = true;
    private string _search = string.Empty;
    private CancellationTokenSource? _debounce;

    private bool _showCreate;
    private string _newFirstName = string.Empty;
    private string _newLastName = string.Empty;
    private string _newContactNumber = string.Empty;
    private string _newEmail = string.Empty;
    private string? _createError;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _result = await Api.GetAsync(_search, page: 1, pageSize: 50);
        _loading = false;
    }

    private async Task OnSearchChanged(string value)
    {
        _search = value;
        _debounce?.Cancel();
        _debounce = new CancellationTokenSource();
        var token = _debounce.Token;
        try
        {
            await Task.Delay(300, token);
            await LoadAsync();
            StateHasChanged();
        }
        catch (TaskCanceledException) { }
    }

    private void ShowCreateForm()
    {
        _showCreate = true;
        _createError = null;
        _newFirstName = _newLastName = _newContactNumber = _newEmail = string.Empty;
    }

    private async Task SubmitCreate()
    {
        if (string.IsNullOrWhiteSpace(_newFirstName))
        {
            _createError = "First name is required.";
            return;
        }
        var created = await Api.CreateAsync(new CreateCustomerRequest
        {
            FirstName = _newFirstName,
            LastName = _newLastName,
            ContactNumber = _newContactNumber,
            EmailAddress = _newEmail
        });
        if (created == null)
        {
            _createError = "Failed to create customer.";
            return;
        }
        _showCreate = false;
        Snackbar.Add("Customer created.", Severity.Success);
        await LoadAsync();
    }
}
