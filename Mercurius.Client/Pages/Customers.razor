@page "/customers"
@attribute [Authorize]
@inject CustomersApiClient Api

<PageTitle>Customers</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Customers</h1>
    <button class="btn btn-primary" @onclick="ShowCreateForm">Add Customer</button>
</div>

<input class="form-control mb-3" style="max-width: 320px;" placeholder="Search customers..."
       value="@_search" @oninput="OnSearchInput" />

@if (_showCreate)
{
    <div class="card mb-3">
        <div class="card-body">
            <div class="row g-2">
                <div class="col-md-3">
                    <input class="form-control" placeholder="First name" @bind="_newFirstName" />
                </div>
                <div class="col-md-3">
                    <input class="form-control" placeholder="Last name" @bind="_newLastName" />
                </div>
                <div class="col-md-3">
                    <input class="form-control" placeholder="Contact number" @bind="_newContactNumber" />
                </div>
                <div class="col-md-3">
                    <input class="form-control" placeholder="Email" @bind="_newEmail" />
                </div>
            </div>
            @if (!string.IsNullOrEmpty(_createError))
            {
                <p class="text-danger mt-2 mb-0">@_createError</p>
            }
            <div class="mt-3">
                <button class="btn btn-primary" @onclick="SubmitCreate">Save</button>
                <button class="btn btn-light" @onclick="() => _showCreate = false">Cancel</button>
            </div>
        </div>
    </div>
}

@if (_loading)
{
    <p><em>Loading...</em></p>
}
else if (_result is null || _result.Items.Count == 0)
{
    <p>No customers found.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>First name</th>
                <th>Last name</th>
                <th>Contact number</th>
                <th>Email</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in _result.Items)
            {
                <tr>
                    <td>@c.FirstName</td>
                    <td>@c.LastName</td>
                    <td>@c.ContactNumber</td>
                    <td>@c.EmailAddress</td>
                </tr>
            }
        </tbody>
    </table>
    <p class="text-muted">Showing @_result.Items.Count of @_result.Total</p>
}

@code {
    private CustomerListResultDto? _result;
    private bool _loading = true;
    private string _search = string.Empty;
    private CancellationTokenSource? _debounce;

    private bool _showCreate;
    private string _newFirstName = string.Empty;
    private string _newLastName = string.Empty;
    private string _newContactNumber = string.Empty;
    private string _newEmail = string.Empty;
    private string? _createError;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _result = await Api.GetAsync(_search, page: 1, pageSize: 50);
        _loading = false;
    }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? string.Empty;
        _debounce?.Cancel();
        _debounce = new CancellationTokenSource();
        var token = _debounce.Token;
        try
        {
            await Task.Delay(300, token);
            await LoadAsync();
            StateHasChanged();
        }
        catch (TaskCanceledException) { }
    }

    private void ShowCreateForm()
    {
        _showCreate = true;
        _createError = null;
        _newFirstName = _newLastName = _newContactNumber = _newEmail = string.Empty;
    }

    private async Task SubmitCreate()
    {
        if (string.IsNullOrWhiteSpace(_newFirstName))
        {
            _createError = "First name is required.";
            return;
        }
        var created = await Api.CreateAsync(new CreateCustomerRequest
        {
            FirstName = _newFirstName,
            LastName = _newLastName,
            ContactNumber = _newContactNumber,
            EmailAddress = _newEmail
        });
        if (created == null)
        {
            _createError = "Failed to create customer.";
            return;
        }
        _showCreate = false;
        await LoadAsync();
    }
}
