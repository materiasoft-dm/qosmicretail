@page "/customers"
@attribute [Authorize(Policy = ModuleRegistry.Pages.CUSTOMER_LIST)]
@using Mercurius.Client.Pages.Dialogs
@inject CustomersApiClient Api
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Customers</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <MudText Typo="Typo.h4">Customers</MudText>
    @if (_user.Can(ModuleRegistry.Pages.CUSTOMER_ADD))
    {
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PersonAdd" OnClick="@(() => OpenAsync(null))">
            Add Customer
        </MudButton>
    }
</div>

<MudTextField T="string" Value="_search" ValueChanged="OnSearchChanged" Label="Search by name, phone, email or ID..." Variant="Variant.Outlined"
              Immediate="true" Clearable="true" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Class="mb-4" Style="max-width:360px;" />

<MudPaper Class="pa-2" Elevation="2">
    <MudTable T="CustomerListItemDto" @ref="_table" ServerData="LoadPageAsync" Hover="true" Dense="true" RowsPerPage="25"
              OnRowClick="@((TableRowClickEventArgs<CustomerListItemDto> e) => OpenAsync(e.Item?.Id))" RowStyle="@(_canEdit ? "cursor:pointer;" : null)">
        <HeaderContent>
            <MudTh>Name</MudTh>
            <MudTh>Age / gender</MudTh>
            <MudTh>Contact number</MudTh>
            <MudTh>Email</MudTh>
            <MudTh>Status</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Name">@FullName(context)</MudTd>
            <MudTd DataLabel="Age / gender">@AgeGender(context)</MudTd>
            <MudTd DataLabel="Contact number">@context.ContactNumber</MudTd>
            <MudTd DataLabel="Email">@context.EmailAddress</MudTd>
            <MudTd DataLabel="Status">
                <MudChip T="string" Size="Size.Small" Color="@(context.IsActive ? Color.Success : Color.Default)">@(context.IsActive ? "Active" : "Inactive")</MudChip>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>No customers found.</MudText>
        </NoRecordsContent>
        <PagerContent>
            <MudTablePager PageSizeOptions="@(new[] { 25, 50, 100 })" />
        </PagerContent>
    </MudTable>
</MudPaper>

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    private System.Security.Claims.ClaimsPrincipal _user = new();
    private bool _canEdit;
    private MudTable<CustomerListItemDto>? _table;
    private string _search = string.Empty;
    private CancellationTokenSource? _debounce;

    protected override async Task OnInitializedAsync()
    {
        _user = (await AuthState).User;
        _canEdit = _user.Can(ModuleRegistry.Pages.CUSTOMER_EDIT);
    }

    private async Task<TableData<CustomerListItemDto>> LoadPageAsync(TableState state, CancellationToken token)
    {
        var result = await Api.GetAsync(_search, state.Page + 1, state.PageSize, token);
        return new TableData<CustomerListItemDto> { Items = result.Items, TotalItems = result.Total };
    }

    private static string FullName(CustomerListItemDto c) =>
        string.Join(" ", new[] { c.FirstName, c.MiddleName, c.LastName }.Where(p => !string.IsNullOrWhiteSpace(p)));

    private static string AgeGender(CustomerListItemDto c) =>
        string.Join(" · ", new[] { c.Age?.ToString(), c.Gender }.Where(p => !string.IsNullOrWhiteSpace(p)));

    private async Task OnSearchChanged(string? value)
    {
        _search = value ?? string.Empty;
        _debounce?.Cancel();
        _debounce = new CancellationTokenSource();
        var token = _debounce.Token;
        try
        {
            await Task.Delay(300, token);
            if (_table != null) await _table.ReloadServerData();
        }
        catch (TaskCanceledException)
        {
            // Superseded by a newer keystroke.
        }
    }

    // Null id adds a customer; otherwise edits one (if the role may).
    private async Task OpenAsync(int? id)
    {
        if (id.HasValue && !_canEdit) return;
        var parameters = new DialogParameters<CustomerDialog>
        {
            { d => d.CustomerId, id },
            { d => d.CanDeactivate, _user.Can(ModuleRegistry.Pages.CUSTOMER_DELETE) }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<CustomerDialog>(id.HasValue ? "Edit customer" : "Add customer", parameters, options);
        if (await dialog.Result is { Canceled: false })
        {
            Snackbar.Add(id.HasValue ? "Customer saved." : "Customer added.", Severity.Success);
            if (_table != null) await _table.ReloadServerData();
        }
    }
}
