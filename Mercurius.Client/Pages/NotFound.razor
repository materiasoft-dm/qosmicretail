@page "/not-found"

<PageTitle>Page not found</PageTitle>

<div class="d-flex flex-column align-center justify-center text-center" style="min-height:50vh;">
    <MudIcon Icon="@Icons.Material.Outlined.TravelExplore" Style="font-size:4rem;" Color="Color.Primary" />
    <MudText Typo="Typo.h4" Class="mt-4">Page not found</MudText>
    <MudText Class="mud-text-secondary mt-2">There's nothing at this address. It may have moved, or the link may be mistyped.</MudText>
    <MudButton Class="mt-6" Variant="Variant.Filled" Color="Color.Primary" Href="" StartIcon="@Icons.Material.Filled.Home">Back to the dashboard</MudButton>
</div>
