@page "/products/{Id:int}/edit"
@attribute [Authorize]
@inject ProductsApiClient Api
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>Edit Product</PageTitle>

@if (_product is null)
{
    <MudText><em>Loading...</em></MudText>
}
else
{
    <MudText Typo="Typo.h4" Class="mb-4">Edit Product</MudText>

    @if (_error != null)
    {
        <MudAlert Severity="Severity.Error" Class="mb-3">@_error</MudAlert>
    }

    <MudPaper Class="pa-4" Elevation="2" Style="max-width:900px;">
        <MudGrid>
            <MudItem xs="12" md="6"><MudTextField @bind-Value="_product.ProductCode" Label="SKU" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="6">
                <MudSelect T="int?" @bind-Value="_product.ProductCategoryId" Label="Category" Variant="Variant.Outlined">
                    <MudSelectItem T="int?" Value="@((int?)null)">-- None --</MudSelectItem>
                    @foreach (var c in _categories)
                    {
                        <MudSelectItem T="int?" Value="@((int?)c.Id)">@c.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12"><MudTextField @bind-Value="_product.Name" Label="Name" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12"><MudTextField @bind-Value="_product.Description" Label="Description" Variant="Variant.Outlined" Lines="3" /></MudItem>
            <MudItem xs="12" md="3"><MudNumericField @bind-Value="_product.CurrentCostPrice" Format="N2" Label="Cost price" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="3"><MudNumericField @bind-Value="_product.MarkUpPercentage" Format="N2" Label="Markup %" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="3"><MudNumericField @bind-Value="_product.CurrentSalePrice" Format="N2" Label="Sale price" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="3"><MudNumericField @bind-Value="_product.LeadTimeDays" Label="Lead time (days)" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="3"><MudTextField Value="@CurrentStockDisplay" Label="Current stock (read-only)" Variant="Variant.Outlined" ReadOnly="true" /></MudItem>
            <MudItem xs="12" md="3"><MudNumericField @bind-Value="_product.LowStockCount" Format="N2" Label="Low stock warning" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="3" Class="d-flex align-items-center">
                <MudSwitch @bind-Value="_product.IsActive" Color="Color.Primary" Label="Active" />
            </MudItem>
            <MudItem xs="12"><MudTextField @bind-Value="_product.Note" Label="Note" Variant="Variant.Outlined" Lines="2" /></MudItem>
        </MudGrid>

        <div class="mt-4">
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save">Save</MudButton>
            <MudButton OnClick="Cancel">Cancel</MudButton>
        </div>
    </MudPaper>
}

@code {
    [Parameter] public int Id { get; set; }

    private ProductDetailDto? _product;
    private List<Mercurius.Shared.Configuration.ProductCategoryDto> _categories = new();
    private string? _error;

    private string CurrentStockDisplay => _product?.CurrentStock.ToString("0.##") ?? string.Empty;

    protected override async Task OnInitializedAsync()
    {
        _categories = await Api.GetCategoryOptionsAsync();
        _product = await Api.GetDetailAsync(Id);
    }

    private async Task Save()
    {
        if (_product == null) return;
        var (success, error) = await Api.UpdateAsync(Id, new UpdateProductRequest
        {
            ProductCode = _product.ProductCode,
            Name = _product.Name,
            Description = _product.Description,
            ProductCategoryId = _product.ProductCategoryId,
            CurrentCostPrice = _product.CurrentCostPrice,
            MarkUpPercentage = _product.MarkUpPercentage,
            CurrentSalePrice = _product.CurrentSalePrice,
            LeadTimeDays = _product.LeadTimeDays,
            LowStockCount = _product.LowStockCount,
            Note = _product.Note,
            IsActive = _product.IsActive
        });
        if (!success) { _error = error; return; }
        Snackbar.Add("Product saved.", Severity.Success);
        Nav.NavigateTo("products");
    }

    private void Cancel() => Nav.NavigateTo("products");
}
