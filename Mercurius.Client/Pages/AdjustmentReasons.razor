@page "/adjustment-reasons"
@attribute [Authorize]
@inject AdjustmentReasonsApiClient Api
@inject ISnackbar Snackbar

<PageTitle>Adjustment Reasons</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <MudText Typo="Typo.h4">Adjustment Reasons</MudText>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="ShowCreate">
        Add Reason
    </MudButton>
</div>

@if (_showCreate)
{
    <MudPaper Class="pa-4 mb-4" Elevation="2">
        <MudGrid>
            <MudItem xs="12" md="4"><MudTextField @bind-Value="_name" Label="Name" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="5"><MudTextField @bind-Value="_description" Label="Description" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" md="3" Class="d-flex align-items-center">
                <MudSwitch @bind-Value="_isInbound" Color="Color.Primary" Label="Inbound (adds stock)" />
            </MudItem>
        </MudGrid>
        @if (_error != null)
        {
            <MudAlert Severity="Severity.Error" Class="mt-3">@_error</MudAlert>
        }
        <div class="mt-3">
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit">Save</MudButton>
            <MudButton OnClick="@(() => _showCreate = false)">Cancel</MudButton>
        </div>
    </MudPaper>
}

<MudPaper Class="pa-2" Elevation="2">
    <MudTable Items="@(_result?.Items ?? new())" Loading="@(_result is null)" Hover="true" Dense="true">
        <HeaderContent>
            <MudTh>Name</MudTh>
            <MudTh>Description</MudTh>
            <MudTh>Direction</MudTh>
            <MudTh>Active</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Name">@context.Name</MudTd>
            <MudTd DataLabel="Description">@context.Description</MudTd>
            <MudTd DataLabel="Direction">
                <MudChip T="string" Size="Size.Small" Color="@(context.IsInbound ? Color.Success : Color.Warning)">
                    @(context.IsInbound ? "Inbound (+)" : "Outbound (-)")
                </MudChip>
            </MudTd>
            <MudTd DataLabel="Active">@(context.IsActive ? "Yes" : "No")</MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>No adjustment reasons yet.</MudText>
        </NoRecordsContent>
    </MudTable>
</MudPaper>

@code {
    private ListResultDto<AdjustmentReasonDto>? _result;
    private bool _showCreate;
    private string _name = string.Empty, _description = string.Empty;
    private bool _isInbound;
    private string? _error;

    protected override async Task OnInitializedAsync() => await LoadAsync();
    private async Task LoadAsync() => _result = await Api.GetAsync();

    private void ShowCreate()
    {
        _showCreate = true; _error = null;
        _name = _description = string.Empty; _isInbound = false;
    }

    private async Task Submit()
    {
        if (string.IsNullOrWhiteSpace(_name)) { _error = "Name is required."; return; }
        var created = await Api.CreateAsync(new CreateAdjustmentReasonRequest { Name = _name, Description = _description, IsInbound = _isInbound });
        if (created == null) { _error = "Failed to create."; return; }
        _showCreate = false;
        Snackbar.Add("Adjustment reason created.", Severity.Success);
        await LoadAsync();
    }
}
