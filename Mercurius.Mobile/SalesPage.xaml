<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:data="clr-namespace:Mercurius.Mobile.Data"
             xmlns:models="clr-namespace:Mercurius.Mobile.Models"
             xmlns:controls="clr-namespace:Mercurius.Mobile.Controls"
             x:Class="Mercurius.Mobile.SalesPage"
             Title="Sell">

    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="0">

        <!-- Header — title + sync status only; search/category/view-toggle all live below now. -->
        <Grid Grid.Row="0" BackgroundColor="{StaticResource Secondary}" Padding="24,10" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
            <controls:MenuButton Grid.Column="0" />
            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                <Label Text="Sell" FontSize="17" FontAttributes="Bold" TextColor="{StaticResource White}" />
                <Label x:Name="PendingSyncLabel" AutomationId="PendingSyncLabel" FontSize="11" TextColor="{StaticResource SecondaryDarkText}" />
            </VerticalStackLayout>
            <!-- Shown while a hardware barcode scanner is listening on this screen (see
                 HardwareScannerService) — a scan goes straight onto the ticket, no tapping needed. -->
            <Border Grid.Column="2" x:Name="ScannerReadyChip" AutomationId="ScannerReadyChip"
                    IsVisible="False"
                    StrokeShape="RoundRectangle 12" Stroke="Transparent"
                    BackgroundColor="#1F3D2B" Padding="10,4" VerticalOptions="Center">
                <HorizontalStackLayout Spacing="6">
                    <Ellipse Fill="#4CAF50" WidthRequest="8" HeightRequest="8" VerticalOptions="Center" />
                    <Label Text="Scanner ready" FontSize="11" TextColor="#C8E6C9" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>
        </Grid>

        <!-- Filters: search first, then the category dropdown. -->
        <Grid Grid.Row="1" BackgroundColor="{StaticResource White}" Padding="20,12" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <Border Grid.Column="0"
                    StrokeShape="RoundRectangle 10"
                    Stroke="{StaticResource Gray100}"
                    BackgroundColor="{StaticResource White}"
                    Padding="14,0"
                    HeightRequest="42"
                    VerticalOptions="Center">
                <!-- Also the scan target: a USB/Bluetooth barcode scanner types the code into
                     whichever field has focus and presses Enter, which fires Completed. -->
                <Grid ColumnDefinitions="*,Auto">
                    <Entry x:Name="SearchEntry"
                           AutomationId="ProductSearchEntry"
                           Placeholder="Search or scan a barcode..."
                           VerticalOptions="Center"
                           TextChanged="OnSearchTextChanged"
                           Completed="OnSearchCompleted" />
                    <!-- Phone camera scan (hidden on Windows — see BarcodeScanner.IsCameraScanAvailable). -->
                    <Button Grid.Column="1"
                            x:Name="CameraScanButton"
                            AutomationId="CameraScanButton"
                            Text="📷"
                            FontSize="18"
                            IsVisible="False"
                            BackgroundColor="Transparent"
                            Padding="8,0"
                            MinimumWidthRequest="0"
                            MinimumHeightRequest="0"
                            VerticalOptions="Center"
                            Clicked="OnCameraScanClicked" />
                </Grid>
            </Border>

            <!-- Searchable category "dropdown" — opens CategoryPickerPopup rather than a plain
                 Picker, since MAUI's stock Picker has no built-in filter box. -->
            <Border Grid.Column="1"
                    AutomationId="CategoryDropdownButton"
                    StrokeShape="RoundRectangle 10"
                    Stroke="{StaticResource Gray100}"
                    BackgroundColor="{StaticResource White}"
                    Padding="14,0"
                    HeightRequest="42"
                    MinimumWidthRequest="150"
                    VerticalOptions="Center">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCategoryDropdownTapped" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Label x:Name="CategoryDropdownLabel"
                           Grid.Column="0"
                           AutomationId="CategoryDropdownLabel"
                           Text="All"
                           FontSize="13" FontAttributes="Bold"
                           TextColor="{StaticResource Gray500}"
                           VerticalOptions="Center"
                           LineBreakMode="TailTruncation" />
                    <Label Grid.Column="1" Text="&#9662;" FontSize="12" TextColor="{StaticResource Gray400}" VerticalOptions="Center" />
                </Grid>
            </Border>
        </Grid>

        <!-- Main content: product area + ticket -->
        <Grid Grid.Row="2" ColumnDefinitions="2.3*,1*" ColumnSpacing="0">

            <!-- Products -->
            <Grid Grid.Column="0" BackgroundColor="#F5F6F8" RowDefinitions="*,Auto">

                <Grid Grid.Row="0">
                    <!-- Grid (thumbnail) view -->
                    <CollectionView x:Name="ProductsGridView"
                                     AutomationId="ProductsGridView"
                                     IsVisible="True"
                                     Margin="16"
                                     SelectionMode="None">
                        <CollectionView.ItemsLayout>
                            <GridItemsLayout Orientation="Vertical" Span="{OnIdiom Phone=2, Tablet=4, Desktop=4, Default=3}" HorizontalItemSpacing="12" VerticalItemSpacing="12" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="data:LocalProduct">
                                <Border AutomationId="{Binding ProductCode, StringFormat='ProductTile_{0}'}"
                                        StrokeShape="RoundRectangle 14"
                                        Stroke="Transparent"
                                        BackgroundColor="{StaticResource White}"
                                        Padding="0"
                                        HeightRequest="172">
                                    <Border.Shadow>
                                        <Shadow Brush="Black" Opacity="0.05" Radius="8" Offset="0,2" />
                                    </Border.Shadow>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnProductTileTapped" CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Grid RowDefinitions="*,Auto">
                                        <Border Grid.Row="0"
                                                StrokeShape="RoundRectangle 14,14,0,0"
                                                Stroke="Transparent"
                                                BackgroundColor="{Binding CategoryName, Converter={StaticResource CategoryColorConverter}}"
                                                Padding="0">
                                            <Label Text="{Binding Name, Converter={StaticResource InitialsConverter}}"
                                                   TextColor="{StaticResource White}"
                                                   FontAttributes="Bold"
                                                   FontSize="28"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center"
                                                   Opacity="0.85" />
                                        </Border>
                                        <VerticalStackLayout Grid.Row="1" Padding="10,8" Spacing="2">
                                            <Label Text="{Binding Name}" FontSize="12" FontAttributes="Bold"
                                                   TextColor="{StaticResource MidnightBlue}"
                                                   LineBreakMode="TailTruncation" MaxLines="1" />
                                            <Label Text="{Binding PriceDisplay}" AutomationId="{Binding ProductCode, StringFormat='ProductPrice_{0}'}" FontSize="13" FontAttributes="Bold"
                                                   TextColor="{StaticResource Primary}" />
                                            <Label Text="{Binding StockDisplay}" AutomationId="{Binding ProductCode, StringFormat='ProductStock_{0}'}" FontSize="10" FontAttributes="Bold"
                                                   TextColor="{Binding IsLowStock, Converter={StaticResource LowStockColorConverter}}" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- List view -->
                    <CollectionView x:Name="ProductsListView"
                                     AutomationId="ProductsListView"
                                     IsVisible="False"
                                     Margin="16"
                                     SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="data:LocalProduct">
                                <Border AutomationId="{Binding ProductCode, StringFormat='ProductTile_{0}'}"
                                        StrokeShape="RoundRectangle 10"
                                        Stroke="{StaticResource Gray100}"
                                        BackgroundColor="{StaticResource White}"
                                        Padding="14,10"
                                        Margin="0,0,0,8">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnProductTileTapped" CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                                        <Border Grid.Column="0"
                                                StrokeShape="RoundRectangle 8"
                                                Stroke="Transparent"
                                                BackgroundColor="{Binding CategoryName, Converter={StaticResource CategoryColorConverter}}"
                                                WidthRequest="36" HeightRequest="36"
                                                Padding="0">
                                            <Label Text="{Binding Name, Converter={StaticResource InitialsConverter}}"
                                                   TextColor="{StaticResource White}" FontAttributes="Bold" FontSize="13"
                                                   HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                                            <Label Text="{Binding Name}" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource MidnightBlue}" LineBreakMode="TailTruncation" />
                                            <Label Text="{Binding CategoryName}" FontSize="11" TextColor="{StaticResource Gray400}" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="2" Text="{Binding StockDisplay}" AutomationId="{Binding ProductCode, StringFormat='ProductStock_{0}'}" FontSize="11" FontAttributes="Bold"
                                               TextColor="{Binding IsLowStock, Converter={StaticResource LowStockColorConverter}}" VerticalOptions="Center" />
                                        <Label Grid.Column="3" Text="{Binding PriceDisplay}" AutomationId="{Binding ProductCode, StringFormat='ProductPrice_{0}'}" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <VerticalStackLayout x:Name="EmptyStateLayout" IsVisible="False" VerticalOptions="Center" HorizontalOptions="Center" Spacing="6">
                        <Label Text="No products found" FontAttributes="Bold" FontSize="15" HorizontalOptions="Center" />
                        <Label Text="Try a different search or category" FontSize="12" TextColor="{StaticResource Gray400}" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Grid>

                <!-- Tile/list view switch — moved down here from the header, out of the way of
                     search/category filtering, and left-aligned in its own footer row. Each
                     segment carries its own AutomationId (TileViewButton/ListViewButton); see
                     SalesPageTests.ViewToggle_... for the UI test that exercises both. -->
                <Grid Grid.Row="1" BackgroundColor="{StaticResource White}" Padding="16,10">
                    <!-- A segmented switch (track + a sliding-look active pill) rather than one
                         button whose icon changes — both modes are visible at once, so it reads as
                         "left = tiles, right = list" instead of "tap to toggle to something else". -->
                    <Border StrokeShape="RoundRectangle 16"
                            Stroke="Transparent"
                            BackgroundColor="{StaticResource Gray100}"
                            Padding="3"
                            HorizontalOptions="Start"
                            VerticalOptions="Center">
                        <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="0">
                            <Border x:Name="TileToggleBorder"
                                    Grid.Column="0"
                                    AutomationId="TileViewButton"
                                    StrokeShape="RoundRectangle 13"
                                    Stroke="Transparent"
                                    Padding="16,7">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnTileViewSelected" />
                                </Border.GestureRecognizers>
                                <Label x:Name="TileToggleLabel" Text="&#9638; Tiles" FontSize="12" FontAttributes="Bold" />
                            </Border>
                            <Border x:Name="ListToggleBorder"
                                    Grid.Column="1"
                                    AutomationId="ListViewButton"
                                    StrokeShape="RoundRectangle 13"
                                    Stroke="Transparent"
                                    Padding="16,7">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnListViewSelected" />
                                </Border.GestureRecognizers>
                                <Label x:Name="ListToggleLabel" Text="&#9776; List" FontSize="12" FontAttributes="Bold" />
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- Ticket -->
            <Grid Grid.Column="1" BackgroundColor="{StaticResource White}">
                <!-- A plain BoxView, not a Border — MAUI's Border silently fails to render any
                     content on Android when given a one-sided (non-uniform) StrokeThickness like
                     "1,0,0,0"; swapping to a Grid + this divider sidesteps that platform bug. -->
                <BoxView Color="{StaticResource Gray100}" WidthRequest="1" HorizontalOptions="Start" />
                <Grid RowDefinitions="Auto,*,Auto">

                    <VerticalStackLayout Grid.Row="0" Padding="20,16" Spacing="2">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="Ticket" FontSize="17" FontAttributes="Bold" TextColor="{StaticResource MidnightBlue}" />
                            <Border Grid.Column="1"
                                    StrokeShape="RoundRectangle 8"
                                    Stroke="Transparent"
                                    BackgroundColor="{StaticResource Gray100}"
                                    Padding="10,2"
                                    VerticalOptions="Center">
                                <Label x:Name="CartCountLabel" AutomationId="CartCountLabel" Text="0 items" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource Gray500}" />
                            </Border>
                        </Grid>
                    </VerticalStackLayout>

                    <Grid Grid.Row="1">
                        <CollectionView x:Name="CartCollectionView" AutomationId="CartCollectionView" Margin="16,0" SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:CartLine">
                                    <Grid AutomationId="{Binding Name, StringFormat='CartLine_{0}'}" Padding="0,10" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnCartLineTapped" CommandParameter="{Binding .}" />
                                        </Grid.GestureRecognizers>
                                        <Label Grid.Row="0" Grid.Column="0" Text="{Binding Name}" FontSize="13" FontAttributes="Bold"
                                               TextColor="{StaticResource MidnightBlue}" LineBreakMode="TailTruncation" />
                                        <Label Grid.Row="0" Grid.Column="1" Text="{Binding LineTotalDisplay}" AutomationId="{Binding Name, StringFormat='CartLineTotal_{0}'}" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource MidnightBlue}" />

                                        <Label Grid.Row="1" Grid.Column="0" Text="{Binding QuantityDisplay, StringFormat='Qty: {0}'}" AutomationId="{Binding Name, StringFormat='Quantity_{0}'}" FontSize="12" TextColor="{StaticResource Gray400}" />
                                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding PriceDisplay}" FontSize="11" TextColor="{StaticResource Gray400}" HorizontalOptions="End" />

                                        <BoxView Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" HeightRequest="1" Color="#F0F0F2" VerticalOptions="End" Margin="0,10,0,-10" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <VerticalStackLayout x:Name="EmptyCartLayout" IsVisible="True" VerticalOptions="Center" HorizontalOptions="Center" Spacing="6" Padding="20">
                            <Label Text="Ticket is empty" FontAttributes="Bold" FontSize="14" HorizontalOptions="Center" />
                            <Label Text="Tap a product to add it" FontSize="12" TextColor="{StaticResource Gray400}" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Grid>

                    <VerticalStackLayout Grid.Row="2" Padding="20,14" Spacing="12" BackgroundColor="#FAFAFB">
                        <!-- BIR: one of the tenant's discount types (SC/PWD or a store discount) and/or
                             the buyer's details for the invoice. See InvoiceDetailsPopup. -->
                        <Button x:Name="InvoiceDetailsButton" AutomationId="InvoiceDetailsButton" Text="+ Discount or customer"
                                HeightRequest="38" FontSize="13" Padding="12,0"
                                BackgroundColor="{StaticResource Gray100}" TextColor="{StaticResource MidnightBlue}"
                                Clicked="OnInvoiceDetailsClicked" />
                        <Grid x:Name="LessVatRow" ColumnDefinitions="*,Auto" IsVisible="False">
                            <Label Grid.Column="0" Text="Less: VAT 12%" FontSize="13" TextColor="{StaticResource Gray500}" />
                            <Label Grid.Column="1" x:Name="LessVatAmountLabel" AutomationId="LessVatAmountLabel" FontSize="13" TextColor="{StaticResource Gray500}" />
                        </Grid>
                        <Grid x:Name="DiscountRow" ColumnDefinitions="*,Auto" IsVisible="False">
                            <Label Grid.Column="0" x:Name="DiscountRowLabel" FontSize="13" TextColor="{StaticResource Gray500}" LineBreakMode="TailTruncation" />
                            <Label Grid.Column="1" x:Name="DiscountAmountLabel" AutomationId="DiscountAmountLabel" FontSize="13" TextColor="{StaticResource Gray500}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="Total" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource MidnightBlue}" />
                            <Label Grid.Column="1" x:Name="TotalLabel" AutomationId="TotalLabel" Text="₱0.00" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                        </Grid>
                        <Grid ColumnDefinitions="1*,1.4*" ColumnSpacing="10">
                            <Button Grid.Column="0" x:Name="ClearButton" AutomationId="ClearButton" Text="Clear" HeightRequest="48"
                                    BackgroundColor="{StaticResource Gray100}" TextColor="{StaticResource Gray500}"
                                    Clicked="OnClearClicked" />
                            <Button Grid.Column="1" x:Name="ChargeButton" AutomationId="ChargeButton" Text="Charge" HeightRequest="48" FontAttributes="Bold"
                                    IsEnabled="False" Clicked="OnChargeClicked" />
                        </Grid>
                    </VerticalStackLayout>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
