<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Mercurius.Mobile.Models"
             xmlns:controls="clr-namespace:Mercurius.Mobile.Controls"
             x:Class="Mercurius.Mobile.ReceiptsPage"
             Title="Receipts">

    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="0">

        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" BackgroundColor="{StaticResource Secondary}" Padding="24,20">
            <HorizontalStackLayout Grid.Column="0" Spacing="12">
                <controls:MenuButton />
                <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                    <Label Text="Receipts" FontSize="22" FontAttributes="Bold" TextColor="{StaticResource White}" />
                    <Label x:Name="SummaryLabel" AutomationId="ReceiptsSummaryLabel" FontSize="12" TextColor="{StaticResource SecondaryDarkText}" />
                </VerticalStackLayout>
            </HorizontalStackLayout>
            <Border Grid.Column="1"
                    StrokeShape="RoundRectangle 10"
                    Stroke="Transparent"
                    BackgroundColor="{StaticResource Primary}"
                    Padding="18,0"
                    HeightRequest="42"
                    VerticalOptions="Center">
                <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="8">
                    <ActivityIndicator x:Name="SyncBusyIndicator" Grid.Column="0"
                                       IsVisible="False" IsRunning="False"
                                       Color="{StaticResource White}"
                                       WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                    <Button Grid.Column="1" AutomationId="SyncNowButton" Text="Sync Now"
                            BackgroundColor="Transparent" TextColor="{StaticResource White}" FontAttributes="Bold"
                            Padding="0" MinimumWidthRequest="0" MinimumHeightRequest="0"
                            VerticalOptions="Center" Clicked="OnSyncNowClicked" />
                </Grid>
            </Border>
        </Grid>

        <!-- Filters: whose sales, how far back, search. -->
        <Grid Grid.Row="1" BackgroundColor="{StaticResource White}" Padding="20,12" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="16">
            <!-- Scope: segmented switch (same look as the Sell page's Tiles/List switch). -->
            <Border Grid.Column="0" StrokeShape="RoundRectangle 10" Stroke="Transparent"
                    BackgroundColor="{StaticResource Gray100}" Padding="3" VerticalOptions="Center">
                <HorizontalStackLayout Spacing="2">
                    <Border x:Name="ScopeDeviceSegment" StrokeShape="RoundRectangle 8" Stroke="Transparent" Padding="12,6">
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnScopeTapped" CommandParameter="Device" /></Border.GestureRecognizers>
                        <Label x:Name="ScopeDeviceLabel" Text="This device" FontSize="12" FontAttributes="Bold" />
                    </Border>
                    <Border x:Name="ScopeBranchSegment" StrokeShape="RoundRectangle 8" Stroke="Transparent" Padding="12,6">
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnScopeTapped" CommandParameter="Branch" /></Border.GestureRecognizers>
                        <Label x:Name="ScopeBranchLabel" Text="This branch" FontSize="12" FontAttributes="Bold" />
                    </Border>
                    <Border x:Name="ScopeAllSegment" StrokeShape="RoundRectangle 8" Stroke="Transparent" Padding="12,6">
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnScopeTapped" CommandParameter="All" /></Border.GestureRecognizers>
                        <Label x:Name="ScopeAllLabel" Text="All branches" FontSize="12" FontAttributes="Bold" />
                    </Border>
                </HorizontalStackLayout>
            </Border>

            <!-- Period -->
            <Border Grid.Column="1" StrokeShape="RoundRectangle 10" Stroke="Transparent"
                    BackgroundColor="{StaticResource Gray100}" Padding="3" VerticalOptions="Center">
                <HorizontalStackLayout Spacing="2">
                    <Border x:Name="PeriodTodaySegment" StrokeShape="RoundRectangle 8" Stroke="Transparent" Padding="12,6">
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnPeriodTapped" CommandParameter="1" /></Border.GestureRecognizers>
                        <Label x:Name="PeriodTodayLabel" Text="Today" FontSize="12" FontAttributes="Bold" />
                    </Border>
                    <Border x:Name="PeriodWeekSegment" StrokeShape="RoundRectangle 8" Stroke="Transparent" Padding="12,6">
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnPeriodTapped" CommandParameter="7" /></Border.GestureRecognizers>
                        <Label x:Name="PeriodWeekLabel" Text="7 days" FontSize="12" FontAttributes="Bold" />
                    </Border>
                    <Border x:Name="PeriodMonthSegment" StrokeShape="RoundRectangle 8" Stroke="Transparent" Padding="12,6">
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnPeriodTapped" CommandParameter="30" /></Border.GestureRecognizers>
                        <Label x:Name="PeriodMonthLabel" Text="30 days" FontSize="12" FontAttributes="Bold" />
                    </Border>
                </HorizontalStackLayout>
            </Border>

            <Border Grid.Column="2" StrokeShape="RoundRectangle 10" Stroke="{StaticResource Gray100}"
                    BackgroundColor="{StaticResource White}" Padding="14,0" HeightRequest="40" VerticalOptions="Center">
                <Entry x:Name="ReceiptSearchEntry" AutomationId="ReceiptSearchEntry"
                       Placeholder="Search invoice #, cashier, product..."
                       VerticalOptions="Center" TextChanged="OnSearchTextChanged" />
            </Border>
        </Grid>

        <Grid Grid.Row="2" ColumnDefinitions="1.1*,1.4*" ColumnSpacing="0">

            <!-- Receipt list -->
            <Grid Grid.Column="0" BackgroundColor="{StaticResource White}">
                <!-- A plain BoxView, not a Border — MAUI's Border silently fails to render any
                     content on Android when given a one-sided (non-uniform) StrokeThickness like
                     "0,0,1,0"; swapping to a Grid + this divider sidesteps that platform bug
                     (see SalesPage.xaml's Ticket panel for the same fix). -->
                <BoxView Color="{StaticResource Gray100}" WidthRequest="1" HorizontalOptions="End" />
                <RefreshView x:Name="ReceiptsRefreshView" Refreshing="OnRefreshing">
                    <Grid>
                        <CollectionView x:Name="ReceiptsCollectionView"
                                         SelectionMode="Single"
                                         SelectionChanged="OnReceiptSelected"
                                         Margin="0,8">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:ReceiptRow">
                                    <Grid Padding="20,12" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="2">
                                        <Label Grid.Row="0" Grid.Column="0" Text="{Binding TotalDisplay}" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource MidnightBlue}" />
                                        <Border Grid.Row="0" Grid.Column="1"
                                                StrokeShape="RoundRectangle 6"
                                                Stroke="Transparent"
                                                Padding="8,2"
                                                BackgroundColor="{Binding StatusBackgroundColor}">
                                            <Label Text="{Binding StatusText}" FontSize="10" FontAttributes="Bold"
                                                   TextColor="{Binding StatusTextColor}" />
                                        </Border>
                                        <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" FontSize="12" TextColor="{StaticResource Gray400}">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding DateDisplay}" />
                                                    <Span Text="  ·  " />
                                                    <Span Text="{Binding NumberDisplay}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                        <Label Grid.Row="2" Grid.Column="0" Text="{Binding SourceDisplay}" FontSize="12" TextColor="{StaticResource Gray500}" LineBreakMode="TailTruncation" />
                                        <Label Grid.Row="2" Grid.Column="1" Text="{Binding BranchDisplay}" FontSize="11" TextColor="{StaticResource Gray400}" HorizontalTextAlignment="End" />

                                        <VisualStateManager.VisualStateGroups>
                                            <VisualStateGroupList>
                                                <VisualStateGroup x:Name="CommonStates">
                                                    <VisualState x:Name="Normal" />
                                                    <VisualState x:Name="Selected">
                                                        <VisualState.Setters>
                                                            <Setter Property="BackgroundColor" Value="#FAFAFB" />
                                                        </VisualState.Setters>
                                                    </VisualState>
                                                </VisualStateGroup>
                                            </VisualStateGroupList>
                                        </VisualStateManager.VisualStateGroups>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <VerticalStackLayout x:Name="EmptyListLayout" IsVisible="False" VerticalOptions="Center" HorizontalOptions="Center" Spacing="6" Padding="20">
                            <Label Text="No sales here yet" FontAttributes="Bold" FontSize="14" HorizontalOptions="Center" />
                            <Label x:Name="EmptyListHintLabel" Text="Try a wider date range or scope" FontSize="12" TextColor="{StaticResource Gray400}" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Grid>
                </RefreshView>
            </Grid>

            <!-- Receipt detail -->
            <Grid Grid.Column="1" BackgroundColor="#F5F6F8">
                <ScrollView x:Name="DetailLayout" IsVisible="False">
                    <VerticalStackLayout Padding="32" Spacing="20">
                        <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                            <Label x:Name="DetailTotalLabel" AutomationId="DetailTotalLabel" Text="₱0.00" FontSize="34" FontAttributes="Bold" TextColor="{StaticResource MidnightBlue}" HorizontalOptions="Center" />
                            <Label Text="Total" FontSize="12" TextColor="{StaticResource Gray400}" HorizontalOptions="Center" />
                            <Border StrokeShape="RoundRectangle 6" Stroke="Transparent" Padding="10,3" Margin="0,6,0,0" x:Name="DetailStatusBorder" HorizontalOptions="Center">
                                <Label x:Name="DetailStatusLabel" AutomationId="DetailStatusLabel" FontSize="11" FontAttributes="Bold" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Who / where / when -->
                        <Border StrokeShape="RoundRectangle 14" Stroke="{StaticResource Gray100}" BackgroundColor="{StaticResource White}" Padding="20">
                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="8">
                                <Label Grid.Row="0" Text="Invoice #" FontSize="12" TextColor="{StaticResource Gray400}" />
                                <Label Grid.Row="0" Grid.Column="1" x:Name="DetailNumberLabel" AutomationId="DetailNumberLabel" FontSize="13" TextColor="{StaticResource MidnightBlue}" />
                                <Label Grid.Row="1" Text="Date" FontSize="12" TextColor="{StaticResource Gray400}" />
                                <Label Grid.Row="1" Grid.Column="1" x:Name="DetailDateLabel" FontSize="13" TextColor="{StaticResource MidnightBlue}" />
                                <Label Grid.Row="2" Text="Sold from" FontSize="12" TextColor="{StaticResource Gray400}" />
                                <Label Grid.Row="2" Grid.Column="1" x:Name="DetailSourceLabel" FontSize="13" TextColor="{StaticResource MidnightBlue}" />
                                <Label Grid.Row="3" Text="Branch" FontSize="12" TextColor="{StaticResource Gray400}" />
                                <Label Grid.Row="3" Grid.Column="1" x:Name="DetailBranchLabel" FontSize="13" TextColor="{StaticResource MidnightBlue}" />
                                <Label Grid.Row="4" Text="Payment" FontSize="12" TextColor="{StaticResource Gray400}" />
                                <Label Grid.Row="4" Grid.Column="1" x:Name="DetailPaymentLabel" FontSize="13" TextColor="{StaticResource MidnightBlue}" />
                                <Label Grid.Row="5" Text="Refunded" x:Name="DetailRefundCaption" FontSize="12" TextColor="{StaticResource Gray400}" />
                                <Label Grid.Row="5" Grid.Column="1" x:Name="DetailRefundLabel" FontSize="13" TextColor="#E65100" />
                            </Grid>
                        </Border>

                        <Border StrokeShape="RoundRectangle 14" Stroke="{StaticResource Gray100}" BackgroundColor="{StaticResource White}" Padding="20">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="Items" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Gray400}" />
                                <BoxView HeightRequest="1" Color="{StaticResource Gray100}" />
                                <VerticalStackLayout x:Name="DetailItemsStack" Spacing="0" />
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </ScrollView>

                <VerticalStackLayout x:Name="NoSelectionLayout" IsVisible="True" VerticalOptions="Center" HorizontalOptions="Center" Spacing="6">
                    <Label Text="Select a receipt" FontAttributes="Bold" FontSize="14" HorizontalOptions="Center" />
                    <Label Text="Choose a sale on the left to see its details" FontSize="12" TextColor="{StaticResource Gray400}" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
