<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Mercurius.Mobile.Models"
             x:Class="Mercurius.Mobile.ReceiptsPage"
             Title="Receipts">

    <Grid RowDefinitions="Auto,*" RowSpacing="0">

        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" BackgroundColor="{StaticResource Secondary}" Padding="24,20">
            <VerticalStackLayout Grid.Column="0" Spacing="2">
                <Label Text="Receipts" FontSize="22" FontAttributes="Bold" TextColor="{StaticResource White}" />
                <Label x:Name="SummaryLabel" AutomationId="ReceiptsSummaryLabel" FontSize="12" TextColor="{StaticResource SecondaryDarkText}" />
            </VerticalStackLayout>
            <Border Grid.Column="1"
                    StrokeShape="RoundRectangle 10"
                    Stroke="Transparent"
                    BackgroundColor="{StaticResource Primary}"
                    Padding="18,0"
                    HeightRequest="42"
                    VerticalOptions="Center">
                <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="8">
                    <ActivityIndicator x:Name="SyncBusyIndicator" Grid.Column="0"
                                       IsVisible="False" IsRunning="False"
                                       Color="{StaticResource White}"
                                       WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                    <Button Grid.Column="1" AutomationId="SyncNowButton" Text="Sync Now"
                            BackgroundColor="Transparent" TextColor="{StaticResource White}" FontAttributes="Bold"
                            Padding="0" MinimumWidthRequest="0" MinimumHeightRequest="0"
                            VerticalOptions="Center" Clicked="OnSyncNowClicked" />
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="1.1*,1.4*" ColumnSpacing="0">

            <!-- Receipt list -->
            <Grid Grid.Column="0" BackgroundColor="{StaticResource White}">
                <!-- A plain BoxView, not a Border — MAUI's Border silently fails to render any
                     content on Android when given a one-sided (non-uniform) StrokeThickness like
                     "0,0,1,0"; swapping to a Grid + this divider sidesteps that platform bug
                     (see SalesPage.xaml's Ticket panel for the same fix). -->
                <BoxView Color="{StaticResource Gray100}" WidthRequest="1" HorizontalOptions="End" />
                <Grid>
                    <CollectionView x:Name="ReceiptsCollectionView"
                                     SelectionMode="Single"
                                     SelectionChanged="OnReceiptSelected"
                                     Margin="0,8">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:ReceiptRow">
                                <Grid Padding="20,12" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                    <Label Grid.Row="0" Grid.Column="0" Text="{Binding TotalDisplay}" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource MidnightBlue}" />
                                    <Border Grid.Row="0" Grid.Column="1"
                                            StrokeShape="RoundRectangle 6"
                                            Stroke="Transparent"
                                            Padding="8,2"
                                            BackgroundColor="{Binding NeedsSyncWarning, Converter={StaticResource LowStockColorConverter}, ConverterParameter=Background}">
                                        <Label Text="{Binding StatusText}" FontSize="10" FontAttributes="Bold"
                                               TextColor="{Binding NeedsSyncWarning, Converter={StaticResource LowStockColorConverter}}" />
                                    </Border>
                                    <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding DateDisplay}" FontSize="12" TextColor="{StaticResource Gray400}" Margin="0,2,0,0" />

                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroupList>
                                            <VisualStateGroup x:Name="CommonStates">
                                                <VisualState x:Name="Normal" />
                                                <VisualState x:Name="Selected">
                                                    <VisualState.Setters>
                                                        <Setter Property="BackgroundColor" Value="#FAFAFB" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                            </VisualStateGroup>
                                        </VisualStateGroupList>
                                    </VisualStateManager.VisualStateGroups>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <VerticalStackLayout x:Name="EmptyListLayout" IsVisible="False" VerticalOptions="Center" HorizontalOptions="Center" Spacing="6" Padding="20">
                        <Label Text="No sales yet" FontAttributes="Bold" FontSize="14" HorizontalOptions="Center" />
                        <Label Text="Completed sales will show up here" FontSize="12" TextColor="{StaticResource Gray400}" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Grid>
            </Grid>

            <!-- Receipt detail -->
            <Grid Grid.Column="1" BackgroundColor="#F5F6F8">
                <VerticalStackLayout x:Name="DetailLayout" IsVisible="False" Padding="32" Spacing="20">
                    <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                        <Label x:Name="DetailTotalLabel" AutomationId="DetailTotalLabel" Text="₱0.00" FontSize="34" FontAttributes="Bold" TextColor="{StaticResource MidnightBlue}" HorizontalOptions="Center" />
                        <Label Text="Total" FontSize="12" TextColor="{StaticResource Gray400}" HorizontalOptions="Center" />
                        <Border StrokeShape="RoundRectangle 6" Stroke="Transparent" Padding="10,3" Margin="0,6,0,0" x:Name="DetailStatusBorder">
                            <Label x:Name="DetailStatusLabel" AutomationId="DetailStatusLabel" FontSize="11" FontAttributes="Bold" />
                        </Border>
                    </VerticalStackLayout>

                    <Border StrokeShape="RoundRectangle 14" Stroke="{StaticResource Gray100}" BackgroundColor="{StaticResource White}" Padding="20">
                        <VerticalStackLayout Spacing="10">
                            <Label x:Name="DetailDateLabel" FontSize="12" TextColor="{StaticResource Gray400}" />
                            <BoxView HeightRequest="1" Color="{StaticResource Gray100}" />
                            <CollectionView x:Name="DetailItemsCollectionView" SelectionMode="None">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="models:ReceiptItemRow">
                                        <Grid ColumnDefinitions="*,Auto" Padding="0,6">
                                            <VerticalStackLayout Grid.Column="0">
                                                <Label Text="{Binding ProductName}" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource MidnightBlue}" />
                                                <Label Text="{Binding QuantityDisplay}" FontSize="11" TextColor="{StaticResource Gray400}" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="1" Text="{Binding LineTotalDisplay}" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource MidnightBlue}" VerticalOptions="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout x:Name="NoSelectionLayout" IsVisible="True" VerticalOptions="Center" HorizontalOptions="Center" Spacing="6">
                    <Label Text="Select a receipt" FontAttributes="Bold" FontSize="14" HorizontalOptions="Center" />
                    <Label Text="Choose a sale on the left to see its details" FontSize="12" TextColor="{StaticResource Gray400}" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
