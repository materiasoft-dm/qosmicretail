<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Mercurius.Mobile.MainPage"
             Title="Dashboard">

    <Grid RowDefinitions="Auto,*">

        <VerticalStackLayout Grid.Row="0" BackgroundColor="{StaticResource Secondary}" Padding="20,18">
            <Label x:Name="GreetingLabel" FontSize="22" FontAttributes="Bold" TextColor="{StaticResource White}" />
            <Label Text="Here's what's happening on this device" FontSize="12" TextColor="{StaticResource SecondaryDarkText}" Margin="0,2,0,0" />
        </VerticalStackLayout>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16" Spacing="12">

                <Border StrokeShape="RoundRectangle 14"
                        Stroke="{StaticResource Gray100}"
                        BackgroundColor="{StaticResource White}"
                        Padding="18">
                    <Border.Shadow>
                        <Shadow Brush="Black" Opacity="0.06" Radius="10" Offset="0,3" />
                    </Border.Shadow>
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            <Label Text="PRODUCTS SYNCED" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource Gray400}" />
                            <Label x:Name="ProductCountLabel" Text="0" FontSize="30" FontAttributes="Bold" TextColor="{StaticResource MidnightBlue}" />
                        </VerticalStackLayout>
                        <Border Grid.Column="1"
                                StrokeShape="RoundRectangle 12"
                                Stroke="Transparent"
                                BackgroundColor="{StaticResource Secondary}"
                                WidthRequest="48" HeightRequest="48"
                                Padding="0"
                                VerticalOptions="Center">
                            <Label Text="&#9636;" TextColor="{StaticResource Primary}" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                    </Grid>
                </Border>

                <Border StrokeShape="RoundRectangle 14"
                        Stroke="{StaticResource Gray100}"
                        BackgroundColor="{StaticResource White}"
                        Padding="18">
                    <Border.Shadow>
                        <Shadow Brush="Black" Opacity="0.06" Radius="10" Offset="0,3" />
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="LAST SYNCED" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource Gray400}" />
                        <Label x:Name="LastSyncedLabel" Text="Never" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource MidnightBlue}" />
                    </VerticalStackLayout>
                </Border>

                <Button Text="Go to Products"
                        Margin="0,8,0,0"
                        HeightRequest="48"
                        Clicked="OnGoToProductsClicked" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
