<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Mercurius.Mobile.PaymentPage"
             Title="Payment">

    <Grid RowDefinitions="Auto,*">

        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" BackgroundColor="{StaticResource Secondary}" Padding="20,18">
            <Label AutomationId="PaymentBackButton" Text="&#8592;" FontSize="20" TextColor="{StaticResource White}" VerticalOptions="Center" Margin="0,0,16,0">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCancelTapped" />
                </Label.GestureRecognizers>
            </Label>
            <Label Grid.Column="1" Text="Payment" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource White}" VerticalOptions="Center" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="32" Spacing="24" MaximumWidthRequest="480" HorizontalOptions="Center">

                <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                    <Label x:Name="TotalDueLabel" AutomationId="TotalDueLabel" Text="₱0.00" FontSize="40" FontAttributes="Bold" TextColor="{StaticResource MidnightBlue}" HorizontalOptions="Center" />
                    <Label Text="Total amount due" FontSize="13" TextColor="{StaticResource Gray400}" HorizontalOptions="Center" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="8">
                    <Label Text="Cash received" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Gray500}" />
                    <Border StrokeShape="RoundRectangle 10" Stroke="{StaticResource Gray100}" Padding="14,0" HeightRequest="50">
                        <Entry x:Name="CashReceivedEntry" AutomationId="CashReceivedEntry" Keyboard="Numeric" TextColor="{StaticResource MidnightBlue}"
                               VerticalOptions="Center" TextChanged="OnCashReceivedChanged" />
                    </Border>
                    <Label x:Name="ChangeLabel" AutomationId="ChangeLabel" Text="" FontSize="13" FontAttributes="Bold" TextColor="#2E7D32" />
                </VerticalStackLayout>

                <Grid x:Name="QuickAmountsGrid" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10" />

                <Button x:Name="ChargeCashButton" AutomationId="ChargeCashButton" Text="Charge Cash" HeightRequest="52" FontAttributes="Bold"
                        IsEnabled="False" Clicked="OnChargeCashClicked" />

                <BoxView HeightRequest="1" Color="{StaticResource Gray100}" />

                <Button x:Name="ChargeCardButton" AutomationId="ChargeCardButton" Text="Charge Card" HeightRequest="52" FontAttributes="Bold"
                        BackgroundColor="{StaticResource Secondary}" TextColor="{StaticResource White}"
                        Clicked="OnChargeCardClicked" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
