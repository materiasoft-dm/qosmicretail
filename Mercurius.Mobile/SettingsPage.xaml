<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Mercurius.Mobile.Models"
             xmlns:controls="clr-namespace:Mercurius.Mobile.Controls"
             x:Class="Mercurius.Mobile.SettingsPage"
             Title="Settings">

    <Grid RowDefinitions="Auto,*" RowSpacing="0">

        <!-- Header — matches ProductsPage/ReceiptsPage's header style. -->
        <Grid Grid.Row="0" BackgroundColor="{StaticResource Secondary}" Padding="32,26">
            <HorizontalStackLayout Spacing="12">
                <controls:MenuButton />
                <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                    <Label Text="Settings" FontSize="24" FontAttributes="Bold" TextColor="{StaticResource White}" />
                    <Label Text="Device configuration" FontSize="13" TextColor="{StaticResource SecondaryDarkText}" />
                </VerticalStackLayout>
            </HorizontalStackLayout>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="32,24" Spacing="20" MaximumWidthRequest="600" HorizontalOptions="Center">

                <!-- What staff call this terminal — shown next to its sales on every terminal's
                     Receipts list, and recorded in the server's audit trail. -->
                <Border StrokeShape="RoundRectangle 14"
                        Stroke="{StaticResource Gray100}"
                        BackgroundColor="{StaticResource White}"
                        Padding="20">
                    <Border.Shadow>
                        <Shadow Brush="Black" Opacity="0.05" Radius="12" Offset="0,3" />
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="12">
                        <Label Text="TERMINAL NAME" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Gray400}" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <Border StrokeShape="RoundRectangle 10" Stroke="{StaticResource Gray100}"
                                    BackgroundColor="#F5F6F8" Padding="12,0" HeightRequest="42">
                                <Entry x:Name="TerminalNameEntry" AutomationId="TerminalNameEntry"
                                       Placeholder="e.g. Front Counter" MaxLength="60" VerticalOptions="Center" />
                            </Border>
                            <Button Grid.Column="1" AutomationId="SaveTerminalNameButton" Text="Save"
                                    HeightRequest="42" Padding="18,0" Clicked="OnSaveTerminalNameClicked" />
                        </Grid>
                        <Label Text="Shown next to this terminal's sales on every device's Receipts list, so staff can tell terminals apart." FontSize="12" TextColor="{StaticResource Gray400}" />
                    </VerticalStackLayout>
                </Border>

                <Border StrokeShape="RoundRectangle 14"
                        Stroke="{StaticResource Gray100}"
                        BackgroundColor="{StaticResource White}"
                        Padding="20">
                    <Border.Shadow>
                        <Shadow Brush="Black" Opacity="0.05" Radius="12" Offset="0,3" />
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="16">
                        <Label Text="THIS DEVICE'S CLINIC" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Gray400}" />

                        <VerticalStackLayout Spacing="2">
                            <Label x:Name="CurrentClinicLabel" AutomationId="CurrentClinicLabel" Text="Not assigned" FontSize="19" FontAttributes="Bold" TextColor="{StaticResource MidnightBlue}" />
                            <Label Text="Every sale recorded on this device is credited to this clinic, regardless of who's signed in." FontSize="12" TextColor="{StaticResource Gray400}" />
                        </VerticalStackLayout>

                        <BoxView HeightRequest="1" Color="{StaticResource Gray100}" />

                        <Label Text="Choose a clinic" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource Gray500}" />

                        <ActivityIndicator x:Name="ClinicListBusyIndicator" AutomationId="ClinicListBusyIndicator"
                                            IsVisible="False" IsRunning="False"
                                            Color="{StaticResource Primary}" HeightRequest="34" />

                        <VerticalStackLayout x:Name="ClinicListErrorLayout" AutomationId="ClinicListErrorLayout" IsVisible="False" Spacing="10">
                            <Label Text="Couldn't load the clinic list. Check your connection and try again." FontSize="13" TextColor="{StaticResource Gray400}" />
                            <Button AutomationId="RetryLoadClinicsButton" Text="Retry" HeightRequest="40" HorizontalOptions="Start"
                                    BackgroundColor="{StaticResource Gray100}" TextColor="{StaticResource Gray500}"
                                    Clicked="OnRetryLoadClinicsClicked" />
                        </VerticalStackLayout>

                        <VerticalStackLayout x:Name="EmptyClinicListLayout" AutomationId="EmptyClinicListLayout" IsVisible="False">
                            <Label Text="No clinics have been set up yet — add one from the admin web app first." FontSize="13" TextColor="{StaticResource Gray400}" />
                        </VerticalStackLayout>

                        <CollectionView x:Name="ClinicsCollectionView" AutomationId="ClinicsCollectionView" SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:LocationDto">
                                    <Border AutomationId="{Binding Name, StringFormat='ClinicOption_{0}'}"
                                            StrokeShape="RoundRectangle 10"
                                            Stroke="{StaticResource Gray100}"
                                            BackgroundColor="{StaticResource White}"
                                            Padding="14,12"
                                            Margin="0,0,0,8">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnClinicRowTapped" CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Label Text="{Binding Name}" FontSize="15" TextColor="{StaticResource MidnightBlue}" />
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
