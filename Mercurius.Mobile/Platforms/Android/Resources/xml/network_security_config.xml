<?xml version="1.0" encoding="utf-8"?>
<!-- Android blocks plain HTTP by default (API 28+), and the app talks to the live Mercurius API over
     HTTPS, so no exception is needed for it. The only cleartext exception left is 10.0.2.2, the
     Android emulator's fixed alias for the host machine's localhost — needed so the emulator can
     reach a locally-running dev server for E2E testing (see Mercurius.Mobile.UITests) without
     touching the live site. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
