<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:data="clr-namespace:Mercurius.Mobile.Data"
             x:Class="Mercurius.Mobile.ProductsPage"
             Title="Products">

    <Grid RowDefinitions="Auto,*" RowSpacing="0">

        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" BackgroundColor="{StaticResource Secondary}" Padding="32,26">
            <VerticalStackLayout Grid.Column="0" Spacing="2">
                <Label Text="Products" FontSize="24" FontAttributes="Bold" TextColor="{StaticResource White}" />
                <Label x:Name="SyncStatusLabel" FontSize="13" TextColor="{StaticResource SecondaryDarkText}" />
            </VerticalStackLayout>
            <Border Grid.Column="1"
                    StrokeShape="RoundRectangle 10"
                    Stroke="Transparent"
                    BackgroundColor="{StaticResource Primary}"
                    Padding="18,0"
                    HeightRequest="44"
                    VerticalOptions="Center">
                <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="8">
                    <ActivityIndicator x:Name="SyncBusyIndicator" Grid.Column="0"
                                       IsVisible="False" IsRunning="False"
                                       Color="{StaticResource White}"
                                       WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                    <Button x:Name="SyncButton" Grid.Column="1"
                            Text="Sync Now"
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource White}"
                            FontAttributes="Bold"
                            Padding="0"
                            MinimumWidthRequest="0"
                            MinimumHeightRequest="0"
                            VerticalOptions="Center"
                            Clicked="OnSyncButtonClicked" />
                </Grid>
            </Border>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="32,24" Spacing="0" MaximumWidthRequest="1200" HorizontalOptions="Center">

                <!-- Toolbar -->
                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,16">
                    <Border Grid.Column="0"
                            StrokeShape="RoundRectangle 10"
                            Stroke="{StaticResource Gray100}"
                            BackgroundColor="{StaticResource White}"
                            Padding="16,0"
                            HeightRequest="46"
                            MaximumWidthRequest="420"
                            HorizontalOptions="Start">
                        <Grid ColumnDefinitions="*,Auto">
                            <Entry x:Name="SearchEntry"
                                   Grid.Column="0"
                                   Placeholder="Search by name, SKU, or category"
                                   TextColor="{StaticResource MidnightBlue}"
                                   VerticalOptions="Center"
                                   TextChanged="OnSearchTextChanged" />
                            <ActivityIndicator x:Name="SearchBusyIndicator"
                                               Grid.Column="1"
                                               IsVisible="False"
                                               IsRunning="False"
                                               Color="{StaticResource Primary}"
                                               WidthRequest="20" HeightRequest="20"
                                               VerticalOptions="Center" />
                        </Grid>
                    </Border>
                    <Border Grid.Column="1"
                            StrokeShape="RoundRectangle 8"
                            Stroke="Transparent"
                            BackgroundColor="{StaticResource Gray100}"
                            Padding="14,0"
                            HeightRequest="30"
                            VerticalOptions="Center">
                        <Label x:Name="ProductCountBadge" Text="0 items" FontSize="12" FontAttributes="Bold"
                               TextColor="{StaticResource Gray500}" VerticalOptions="Center" />
                    </Border>
                </Grid>

                <!-- Table container -->
                <Border StrokeShape="RoundRectangle 14"
                        Stroke="{StaticResource Gray100}"
                        BackgroundColor="{StaticResource White}"
                        Padding="0">
                    <Border.Shadow>
                        <Shadow Brush="Black" Opacity="0.05" Radius="12" Offset="0,3" />
                    </Border.Shadow>

                    <Grid RowDefinitions="Auto,*">

                        <!-- Column headers — desktop/tablet table look; a phone screen still reads
                             fine since the row template itself carries labels beside each value. -->
                        <Grid Grid.Row="0"
                              ColumnDefinitions="52,2.4*,1.1*,1.2*,1*,0.9*"
                              ColumnSpacing="12"
                              Padding="16,14"
                              IsVisible="{OnIdiom Phone=False, Default=True}"
                              BackgroundColor="#FAFAFB">
                            <Label Grid.Column="1" Text="PRODUCT" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource Gray400}" />
                            <Label Grid.Column="2" Text="SKU" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource Gray400}" />
                            <Label Grid.Column="3" Text="CATEGORY" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource Gray400}" />
                            <Label Grid.Column="4" Text="STOCK" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource Gray400}" />
                            <Label Grid.Column="5" Text="PRICE" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource Gray400}" HorizontalTextAlignment="End" />
                        </Grid>

                        <RefreshView Grid.Row="1" x:Name="ProductsRefreshView" Refreshing="OnRefreshing">
                            <Grid>
                                <CollectionView x:Name="ProductsCollectionView" SelectionMode="None">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate x:DataType="data:LocalProduct">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <!-- Desktop/tablet: single table row -->
                                                <Grid Grid.Row="0" ColumnDefinitions="52,2.4*,1.1*,1.2*,1*,0.9*" ColumnSpacing="12"
                                                      Padding="16,12"
                                                      IsVisible="{OnIdiom Phone=False, Default=True}">
                                                    <Border Grid.Column="0"
                                                            StrokeShape="RoundRectangle 9"
                                                            Stroke="Transparent"
                                                            BackgroundColor="{StaticResource Secondary}"
                                                            WidthRequest="36" HeightRequest="36"
                                                            Padding="0">
                                                        <Label Text="{Binding Name, Converter={StaticResource InitialsConverter}}"
                                                               TextColor="{StaticResource Primary}"
                                                               FontAttributes="Bold"
                                                               FontSize="13"
                                                               HorizontalOptions="Center"
                                                               VerticalOptions="Center" />
                                                    </Border>
                                                    <Label Grid.Column="1" Text="{Binding Name}" FontAttributes="Bold" FontSize="14"
                                                           TextColor="{StaticResource MidnightBlue}"
                                                           VerticalOptions="Center" LineBreakMode="TailTruncation" />
                                                    <Label Grid.Column="2" Text="{Binding ProductCode}" FontSize="13"
                                                           TextColor="{StaticResource Gray400}" VerticalOptions="Center" LineBreakMode="TailTruncation" />
                                                    <Label Grid.Column="3" Text="{Binding CategoryName}" FontSize="13"
                                                           TextColor="{StaticResource Gray400}" VerticalOptions="Center" LineBreakMode="TailTruncation" />
                                                    <Border Grid.Column="4"
                                                            StrokeShape="RoundRectangle 6"
                                                            Stroke="Transparent"
                                                            BackgroundColor="{Binding IsLowStock, Converter={StaticResource LowStockColorConverter}, ConverterParameter=Background}"
                                                            Padding="8,3"
                                                            HorizontalOptions="Start"
                                                            VerticalOptions="Center">
                                                        <Label Text="{Binding CurrentStock, StringFormat='{0:N0}'}" FontSize="12" FontAttributes="Bold"
                                                               TextColor="{Binding IsLowStock, Converter={StaticResource LowStockColorConverter}}" />
                                                    </Border>
                                                    <Label Grid.Column="5" Text="{Binding PriceDisplay}" FontAttributes="Bold" FontSize="14"
                                                           TextColor="{StaticResource Primary}" VerticalOptions="Center" HorizontalTextAlignment="End" />
                                                </Grid>

                                                <!-- Phone: compact card, unchanged from the original layout -->
                                                <Border Grid.Row="1"
                                                        StrokeShape="RoundRectangle 14"
                                                        Stroke="{StaticResource Gray100}"
                                                        BackgroundColor="{StaticResource White}"
                                                        Padding="16,14"
                                                        IsVisible="{OnIdiom Phone=True, Default=False}">
                                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                                        <Border Grid.Column="0"
                                                                StrokeShape="RoundRectangle 10"
                                                                Stroke="Transparent"
                                                                BackgroundColor="{StaticResource Secondary}"
                                                                WidthRequest="44" HeightRequest="44"
                                                                Padding="0"
                                                                VerticalOptions="Center">
                                                            <Label Text="{Binding Name, Converter={StaticResource InitialsConverter}}"
                                                                   TextColor="{StaticResource Primary}"
                                                                   FontAttributes="Bold"
                                                                   FontSize="16"
                                                                   HorizontalOptions="Center"
                                                                   VerticalOptions="Center" />
                                                        </Border>
                                                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                                            <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="15"
                                                                   TextColor="{StaticResource MidnightBlue}" LineBreakMode="TailTruncation" />
                                                            <Label FontSize="12" TextColor="{StaticResource Gray400}">
                                                                <Label.FormattedText>
                                                                    <FormattedString>
                                                                        <Span Text="{Binding ProductCode}" />
                                                                        <Span Text="  •  " />
                                                                        <Span Text="{Binding CategoryName}" />
                                                                    </FormattedString>
                                                                </Label.FormattedText>
                                                            </Label>
                                                            <Label Text="{Binding StockDisplay}"
                                                                   FontSize="11"
                                                                   FontAttributes="Bold"
                                                                   TextColor="{Binding IsLowStock, Converter={StaticResource LowStockColorConverter}}"
                                                                   Margin="0,2,0,0" />
                                                        </VerticalStackLayout>
                                                        <Label Grid.Column="2"
                                                               Text="{Binding PriceDisplay}"
                                                               FontAttributes="Bold"
                                                               FontSize="16"
                                                               TextColor="{StaticResource Primary}"
                                                               VerticalOptions="Center" />
                                                    </Grid>
                                                </Border>

                                                <BoxView Grid.Row="2" HeightRequest="1" Color="#F0F0F2"
                                                         IsVisible="{OnIdiom Phone=False, Default=True}" />
                                            </Grid>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>

                                <VerticalStackLayout x:Name="EmptyStateLayout"
                                                     IsVisible="False"
                                                     VerticalOptions="Center"
                                                     HorizontalOptions="Center"
                                                     Padding="0,40"
                                                     Spacing="8">
                                    <Label Text="No products yet" FontAttributes="Bold" FontSize="16" HorizontalOptions="Center" />
                                    <Label Text="Pull down or press Sync Now to fetch from the server" FontSize="13" TextColor="{StaticResource Gray400}" HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </Grid>
                        </RefreshView>
                    </Grid>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
