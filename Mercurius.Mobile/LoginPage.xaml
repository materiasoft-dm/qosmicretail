<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Mercurius.Mobile.LoginPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Secondary}">

    <Grid>
        <ScrollView VerticalOptions="Center">
            <VerticalStackLayout Padding="32,48" Spacing="0" MaximumWidthRequest="420" HorizontalOptions="Center">

                <Border StrokeShape="RoundRectangle 20"
                        Stroke="Transparent"
                        BackgroundColor="{StaticResource White}"
                        Padding="32,36">
                    <Border.Shadow>
                        <Shadow Brush="Black" Opacity="0.25" Radius="24" Offset="0,10" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="6">

                        <Border StrokeShape="RoundRectangle 16"
                                Stroke="Transparent"
                                BackgroundColor="{StaticResource Primary}"
                                WidthRequest="64" HeightRequest="64"
                                HorizontalOptions="Center"
                                Padding="0">
                            <Label Text="M"
                                   TextColor="{StaticResource White}"
                                   FontSize="30"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>

                        <Label Text="Mercurius"
                               FontSize="26"
                               FontAttributes="Bold"
                               TextColor="{StaticResource MidnightBlue}"
                               HorizontalOptions="Center"
                               Margin="0,16,0,0" />
                        <Label Text="Sign in to sync your device"
                               FontSize="13"
                               TextColor="{StaticResource Gray400}"
                               HorizontalOptions="Center"
                               Margin="0,0,0,24" />

                        <Label Text="Email" FontSize="12" TextColor="{StaticResource Gray400}" />
                        <Border StrokeShape="RoundRectangle 10"
                                Stroke="{StaticResource Gray100}"
                                BackgroundColor="Transparent"
                                Padding="12,0"
                                HeightRequest="48">
                            <Entry x:Name="EmailEntry"
                                   Placeholder="you@mercurius.com"
                                   Keyboard="Email"
                                   VerticalOptions="Center" />
                        </Border>

                        <Label Text="Password" FontSize="12" TextColor="{StaticResource Gray400}" Margin="0,14,0,0" />
                        <Border StrokeShape="RoundRectangle 10"
                                Stroke="{StaticResource Gray100}"
                                BackgroundColor="Transparent"
                                Padding="12,0"
                                HeightRequest="48">
                            <Entry x:Name="PasswordEntry"
                                   Placeholder="••••••••"
                                   IsPassword="True"
                                   VerticalOptions="Center" />
                        </Border>

                        <Label x:Name="ErrorLabel"
                               TextColor="#D32F2F"
                               FontSize="13"
                               Margin="0,14,0,0"
                               IsVisible="False" />

                        <Button x:Name="LoginButton"
                                Text="Sign In"
                                Margin="0,22,0,0"
                                HeightRequest="48"
                                FontAttributes="Bold"
                                Clicked="OnLoginClicked" />

                        <ActivityIndicator x:Name="LoadingIndicator"
                                           IsVisible="False"
                                           IsRunning="False"
                                           Margin="0,16,0,0"
                                           Color="{StaticResource Primary}" />

                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
