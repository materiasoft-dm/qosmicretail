<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pinned below the v5+ line deliberately: Appium.WebDriver 5+ is strict-W3C and vendor-
         prefixes every non-standard capability (App -> "appium:app"). WinAppDriver 1.2.2009.02003
         (the current Microsoft release) only recognizes the unprefixed "app"/"appTopLevelWindow"
         keys and rejects "appium:app" with "Bad capabilities. Specify either app or
         appTopLevelWindow to create a session" — confirmed against a real WinAppDriver instance.
         4.4.5 is the last version whose AddAdditionalCapability sends capabilities unprefixed. -->
    <PackageReference Include="Appium.WebDriver" Version="4.4.5" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <None Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
